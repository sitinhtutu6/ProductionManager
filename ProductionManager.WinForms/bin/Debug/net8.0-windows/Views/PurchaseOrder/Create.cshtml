@{
    ViewData["Title"] = "Tạo Đơn Đặt Hàng";
    ViewData["Breadcrumbs"] = new List<(string Title, string Url)>
    {
        ("Đặt Hàng", Url.Action("Index", "PurchaseOrder")),
        ("Thêm Mới", "")
    };
    var itemsJson = ViewBag.ItemsJson;
    var suppJson = ViewBag.SuppliersJson;
    var ordersJson = ViewBag.OrdersJson ?? "[]"; // Nhận danh sách đơn hàng
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body {
        background-color: #f4f6f8;
        font-family: 'Inter', sans-serif;
    }

    .erp-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        margin-bottom: 16px;
        overflow: hidden;
    }

    .erp-header {
        padding: 12px 16px;
        border-bottom: 1px solid #f1f5f9;
        background: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .erp-header h6 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

    .erp-body {
        padding: 16px;
    }

    .form-label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 4px;
    }

    .form-control, .form-select {
        border-radius: 6px;
        border-color: #cbd5e1;
        font-size: 13px;
        padding: 6px 10px;
        box-shadow: none;
        transition: all 0.2s ease;
        height: 34px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0ea5e9;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
        }

    .select2-container--bootstrap-5 .select2-selection {
        border-radius: 6px;
        padding: 4px 10px;
        min-height: 34px;
        border-color: #cbd5e1;
        font-weight: 600;
        font-size: 13px;
    }

    .select2-container--bootstrap-5.select2-container--focus .select2-selection {
        border-color: #0ea5e9;
        box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
    }

    .erp-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
    }

        .erp-table th {
            background: #f8fafc;
            color: #64748b;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            padding: 10px 12px;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .erp-table td {
            padding: 6px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            font-size: 13px;
        }

    .inp-transparent {
        border: 1px solid transparent;
        background: transparent;
        width: 100%;
        transition: 0.2s;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 13px;
        height: 30px;
    }

        .inp-transparent:focus, .inp-transparent:hover {
            border: 1px solid #cbd5e1;
            background: #fff;
            outline: none;
        }

    .input-locked {
        background-color: #f8fafc !important;
        color: #94a3b8 !important;
        pointer-events: none;
        border-color: transparent !important;
        font-weight: 500;
    }

    .summary-box {
        background: #f8fafc;
        border-radius: 10px;
        padding: 16px;
        border: 1px solid #e2e8f0;
        width: 100%;
        max-width: 380px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 13px;
        align-items: center;
        color: #475569;
        font-weight: 600;
    }

        .summary-row:last-child {
            margin-bottom: 0;
        }

    .summary-total {
        border-top: 2px dashed #cbd5e1;
        padding-top: 12px;
        margin-top: 12px;
        font-size: 16px;
        font-weight: 800;
        color: #0ea5e9;
    }
</style>

<div class="container-fluid py-3 px-2 px-lg-4">
    <form id="poForm" onsubmit="submitPO(event)">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h5 class="fw-800 mb-0 text-dark">Lập Đơn Đặt Hàng Mua</h5>
            <div class="d-flex gap-2">
                <a href="/PurchaseOrder" class="btn btn-sm btn-light rounded-pill px-3 fw-bold border shadow-sm text-secondary">Hủy bỏ</a>
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm"><i class="fa-solid fa-floppy-disk me-1"></i> Lưu Chứng Từ</button>
            </div>
        </div>

        <!-- Master Data -->
        <div class="erp-card">
            <div class="erp-header">
                <h6><i class="fa-solid fa-circle-info text-primary me-2"></i>Thông tin chung</h6>
            </div>
            <div class="erp-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label text-danger">Nhà Cung Cấp *</label>
                        <select id="supplierId" class="form-control" required><option value="">-- Chọn NCC --</option></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-primary">Lọc theo Nhóm Vật Tư</label>
                        <select id="categoryFilter" class="form-select fw-bold text-primary" onchange="filterByCategory()">
                            <option value="">-- Tất cả nhóm --</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in ViewBag.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Loại Đơn</label>
                        <select id="poType" class="form-select fw-bold">
                            <option value="1">Mua thương mại</option>
                            <option value="2">Gia công ngoài</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Ngày Đặt</label>
                        <input type="text" id="orderDate" class="form-control datepicker text-center fw-bold text-primary bg-white" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Số Chứng Từ</label>
                        <input id="poCode" class="form-control fw-bold text-center border-0" value="@ViewBag.AutoCode" readonly style="background:#f1f5f9; color: #64748b;" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ghi chú nội bộ</label>
                        <input id="note" class="form-control" placeholder="Nhập diễn giải cho đơn hàng..." />
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Data -->
        <div class="erp-card">
            <div class="erp-header">
                <h6><i class="fa-solid fa-boxes-stacked text-success me-2"></i>Chi tiết hàng hóa</h6>
                <button type="button" class="btn btn-sm btn-light border fw-bold text-primary rounded-pill px-3 py-1 shadow-sm" onclick="addRow()">
                    <i class="fa-solid fa-plus me-1"></i> Thêm dòng
                </button>
            </div>

            <div class="table-responsive" style="min-height: 200px;">
                <table class="erp-table" id="tblDetails">
                    <thead>
                        <tr>
                            <th width="40" class="text-center">#</th>
                            <th style="min-width: 200px;">Mã / Tên Hàng Hóa</th>
                            <!-- 🔥 CỘT MỚI: ĐƠN HÀNG SẢN XUẤT -->
                            <th style="min-width: 150px;">Đơn Hàng SX</th>
                            <th width="80" class="text-center">ĐVT</th>
                            <th width="10%" class="text-end">Số Lượng</th>
                            <th width="15%" class="text-end">Đơn Giá</th>
                            <th width="15%" class="text-end">Thành Tiền</th>
                            <th width="50" class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Footer Summary -->
            <div class="erp-body bg-white border-top">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
                    <div class="p-3 bg-light rounded-3 text-muted small w-100" style="max-width: 500px; border: 1px dashed #cbd5e1;">
                        <i class="fa-solid fa-lightbulb text-warning me-1"></i> <strong>Lưu ý:</strong> Đơn giá nhập kho có thể để trống (bằng 0). Có thể gán đích danh Vật tư cho 1 Đơn hàng đang sản xuất.
                    </div>

                    <div class="summary-box shadow-sm ms-lg-auto">
                        <div class="summary-row">
                            <span>Cộng tiền hàng:</span>
                            <span id="lblTotalAmount" class="fw-bold text-dark fs-6">0</span>
                        </div>
                        <div class="summary-row">
                            <span class="d-flex align-items-center">Thuế GTGT <input type="number" id="vatPercent" class="form-control text-center mx-2 p-1 fw-bold text-primary" style="width: 55px; height: 28px;" value="0" min="0" oninput="calcTotalFinancial()"> %:</span>
                            <span id="lblVatAmount" class="fw-bold text-dark fs-6">0</span>
                        </div>
                        <div class="summary-row summary-total">
                            <span>Tổng Thanh Toán:</span>
                            <span id="lblFinalTotal">0</span>
                        </div>
                        <div class="summary-row mt-3">
                            <span class="text-danger">Tiền đặt cọc (Trả trước):</span>
                            <input type="number" id="depositAmount" class="form-control text-end text-danger fw-bold shadow-sm p-1" style="width: 120px; height: 30px; border-color: #fca5a5;" value="0" min="0" oninput="calcTotalFinancial()" />
                        </div>
                        <div class="summary-row mt-2 text-success fs-5 fw-800">
                            <span>Số tiền còn nợ:</span>
                            <span id="lblRemainingAmount">0</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const allMaterialsData = @Html.Raw(itemsJson);
        let materialsData = [...allMaterialsData];
        const suppList = @Html.Raw(suppJson);

        // 🔥 Lấy list đơn hàng đang SX
        const orderList = @Html.Raw(ordersJson);
        let rowIndex = 0;

        $(document).ready(function () {
        flatpickr(".datepicker", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn" });

        let suppSelect = $('#supplierId');
        suppList.forEach(s => { suppSelect.append(new Option(s.Text, s.Id)); });
        suppSelect.select2({ theme: 'bootstrap-5', width: '100%', placeholder: "🔍 Chọn Nhà Cung Cấp..." });

        addRow();
        });

        function filterByCategory() {
        let catId = document.getElementById('categoryFilter').value;
        if (catId === "") materialsData = [...allMaterialsData];
        else materialsData = allMaterialsData.filter(m => m.CategoryId == catId);

        document.querySelectorAll("#tblDetails tbody tr").forEach(row => {
        let select = $(row).find('.row-item');
        if (!select.val()) {
        select.select2('destroy');
        select.empty();
        select.append('<option value="">-- Tìm mã/tên hàng hóa --</option>');
        materialsData.forEach(item => {
        select.append(`<option value="${item.Id}" data-unit="${item.Unit}" data-price="${item.Price || 0}">${item.Code} - ${item.Name}</option>`);
        });
        select.select2({ theme: 'bootstrap-5', width: '100%' });
        }
        });
        }

        function addRow() {
        const tbody = document.querySelector("#tblDetails tbody");
        const row = tbody.insertRow();
        row.id = `row-${rowIndex}`;

        let itemOptions = '<option value="">-- Tìm mã/tên hàng hóa --</option>';
        materialsData.forEach(item => { itemOptions += `<option value="${item.Id}" data-unit="${item.Unit}" data-price="${item.Price || 0}">${item.Code} - ${item.Name}</option>`; });

        // 🔥 TẠO DROPDOWN ĐƠN HÀNG
        let orderOptions = '<option value="">-- Dùng chung --</option>';
        orderList.forEach(o => { orderOptions += `<option value="${o.Id}" data-code="${o.Code}">${o.Code}</option>`; });

        row.innerHTML = `
        <td class="text-center text-muted fw-bold align-middle row-idx">${tbody.children.length}</td>
        <td class="py-2"><select class="form-control row-item" required>${itemOptions}</select></td>
        <td class="py-2"><select class="form-control row-order">${orderOptions}</select></td>
        <td class="text-center text-secondary row-unit align-middle fw-600"></td>
        <td class="py-2"><input type="number" class="inp-transparent text-end fw-bold text-primary row-qty input-locked" value="1" min="0.01" step="0.01" required readonly></td>
        <td class="py-2"><input type="number" class="inp-transparent text-end fw-bold text-dark row-price input-locked" value="0" min="0" readonly></td>
        <td class="text-end fw-bold text-dark row-total align-middle fs-6">0</td>
        <td class="text-center align-middle"><button type="button" class="btn btn-sm text-danger p-0 border-0 bg-transparent shadow-none" onclick="removeRow(this)" title="Xóa dòng"><i class="fa-solid fa-trash-can fs-6"></i></button></td>
        `;

        let newSelectItem = $(row).find('.row-item');
        newSelectItem.select2({ theme: 'bootstrap-5', width: '100%' });
        newSelectItem.on('select2:select', function (e) { onItemChange(this); });
        newSelectItem.on('select2:unselect', function (e) { lockRow(this.closest('tr')); });

        // 🔥 Kích hoạt SmartSearch cho Đơn hàng
        $(row).find('.row-order').select2({ theme: 'bootstrap-5', width: '100%', placeholder: "Dùng chung" });

        rowIndex++;
        updateRowIndices();
        }

        function removeRow(btn) { btn.closest('tr').remove(); updateRowIndices(); calcTotalFinancial(); }
        function updateRowIndices() { document.querySelectorAll("#tblDetails tbody tr").forEach((row, idx) => { row.querySelector('.row-idx').innerText = idx + 1; }); }

        function lockRow(tr) {
        tr.querySelector('.row-unit').innerText = '';
        let qtyInp = tr.querySelector('.row-qty');
        let priceInp = tr.querySelector('.row-price');
        qtyInp.readOnly = true; qtyInp.classList.add('input-locked'); qtyInp.value = 1;
        priceInp.readOnly = true; priceInp.classList.add('input-locked'); priceInp.value = 0;
        calcTotalFinancial();
        }

        function onItemChange(select) {
        const opt = select.selectedOptions[0];
        let tr = select.closest('tr');
        if (opt && opt.value) {
        tr.querySelector('.row-unit').innerText = opt.getAttribute('data-unit') || '';
        let qtyInp = tr.querySelector('.row-qty'); let priceInp = tr.querySelector('.row-price');
        qtyInp.readOnly = false; qtyInp.classList.remove('input-locked');
        priceInp.readOnly = false; priceInp.classList.remove('input-locked');
        let defaultPrice = opt.getAttribute('data-price');
        if (defaultPrice && !isNaN(defaultPrice)) priceInp.value = defaultPrice;
        } else { lockRow(tr); }
        calcTotalFinancial();
        }

        function calcTotalFinancial() {
        let total = 0;
        document.querySelectorAll("#tblDetails tbody tr").forEach(row => {
        let qty = parseFloat(row.querySelector(".row-qty").value) || 0;
        let price = parseFloat(row.querySelector(".row-price").value) || 0;
        let lineTotal = qty * price;
        row.querySelector(".row-total").innerText = lineTotal.toLocaleString('vi-VN');
        total += lineTotal;
        });

        let vatPercent = parseFloat(document.getElementById("vatPercent").value) || 0;
        let vatAmt = total * (vatPercent / 100);
        let finalT = total + vatAmt;
        let deposit = parseFloat(document.getElementById("depositAmount").value) || 0;
        let remain = finalT - deposit;

        document.getElementById("lblTotalAmount").innerText = total.toLocaleString('vi-VN');
        document.getElementById("lblVatAmount").innerText = vatAmt.toLocaleString('vi-VN');
        document.getElementById("lblFinalTotal").innerText = finalT.toLocaleString('vi-VN');
        document.getElementById("lblRemainingAmount").innerText = remain.toLocaleString('vi-VN');
        }

        $(document).on('input', '.row-qty, .row-price', function () { calcTotalFinancial(); });

        function submitPO(e) {
        e.preventDefault();
        const suppSelect = document.getElementById("supplierId");
        if (!suppSelect.value) { Swal.fire("Lỗi", "Vui lòng chọn Nhà Cung Cấp!", "warning"); return; }

        let rawSuppName = suppSelect.options[suppSelect.selectedIndex].text;
        let cleanSuppName = rawSuppName.substring(rawSuppName.indexOf("]") + 1).trim();

        const poData = {
        POCode: document.getElementById("poCode").value,
        OrderDate: document.getElementById("orderDate").value,
        SupplierId: parseInt(suppSelect.value),
        SupplierName: cleanSuppName,
        Type: parseInt(document.getElementById("poType").value),
        Note: document.getElementById("note").value,
        VATPercent: parseFloat(document.getElementById("vatPercent").value) || 0,
        DepositAmount: parseFloat(document.getElementById("depositAmount").value) || 0,
        Details: []
        };

        const rows = document.querySelectorAll("#tblDetails tbody tr");
        if (rows.length === 0) { Swal.fire("Lỗi", "Vui lòng nhập ít nhất 1 vật tư", "warning"); return; }

        let isValid = true;
        rows.forEach(row => {
        const itemId = row.querySelector(".row-item").value;
        const qty = parseFloat(row.querySelector(".row-qty").value);
        const price = parseFloat(row.querySelector(".row-price").value) || 0;

        // 🔥 LẤY GIÁ TRỊ ĐƠN HÀNG ĐỂ LƯU
        const orderSelect = row.querySelector(".row-order");
        const orderId = orderSelect.value;
        const orderCode = orderId ? orderSelect.options[orderSelect.selectedIndex].getAttribute("data-code") : null;

        if (!itemId) isValid = false;
        if (qty <= 0) isValid = false;
        if (itemId) {
        poData.Details.push({
        WarehouseItemId: parseInt(itemId),
        QuantityOrdered: qty,
        UnitPrice: price,
        LinkedOrderId: orderId ? parseInt(orderId) : null,
        LinkedOrderCode: orderCode
        });
        }
        });

        if (!isValid) { Swal.fire("Lỗi", "Kiểm tra lại dữ liệu vật tư (Chưa chọn hoặc SL <= 0)", "error"); return; }

        Swal.fire({ title: 'Đang lưu chứng từ...', didOpen: () => Swal.showLoading() });
        fetch('/PurchaseOrder/Create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(poData)
        }).then(res => res.json()).then(res => {
        if (res.success) { Swal.fire("Thành công", "Đã lưu chứng từ!", "success").then(() => window.location.href = "/PurchaseOrder/Index"); }
        else { Swal.fire("Lỗi", res.message, "error"); }
        });
        }
    </script>
}