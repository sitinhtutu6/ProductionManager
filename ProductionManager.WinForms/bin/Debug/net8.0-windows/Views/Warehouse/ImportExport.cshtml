@using System.Text.Json
@{
    bool isImport = ViewBag.Type == "Import";
    bool isFromPO = ViewBag.PoId != null;
    ViewData["Title"] = ViewBag.Title ?? (isImport ? "Tạo Phiếu Nhập Kho" : "Tạo Phiếu Xuất Kho");
    var today = DateTime.Now.ToString("dd/MM/yyyy HH:mm");

    ViewData["Breadcrumbs"] = new List<(string Title, string Url)>
    {
        ("Quản lý Kho", Url.Action("Index", "Warehouse")),
        (ViewData["Title"].ToString(), "")
    };
}

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<style>
    body {
    background-color: #f8fafc;
    font-family: 'Inter', sans-serif;
    }

    .transaction-header {
    background: @(isImport ? "linear-gradient(135deg, #10b981 0%, #059669 100%)" : "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)");
    color: #fff;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    }

    .cart-card {
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    background: #fff;
    }

    .qty-input, .price-input {
    font-weight: bold;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    padding: 6px 10px;
    transition: all 0.2s;
    }

    .qty-input {
    width: 90px;
    text-align: center;
    }

    .price-input {
    text-align: right;
    width: 100%;
    }

    .qty-input:focus, .price-input:focus {
    border-color: #3b82f6;
    outline: none;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    background: #fff !important;
    }

    .input-locked {
    background-color: #f1f5f9 !important;
    color: #64748b !important;
    cursor: not-allowed;
    border-color: #e2e8f0;
    }

    .select2-container--bootstrap-5 .select2-selection {
    height: 50px !important;
    padding: 10px 15px;
    font-size: 1.05rem;
    border-radius: 10px;
    border: 2px solid #e2e8f0;
    font-weight: 600;
    }

    .select2-container--bootstrap-5 .select2-selection:focus {
    border-color: #0ea5e9;
    box-shadow: 0 0 0 0.2rem rgba(14, 165, 233, 0.25);
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
    line-height: 26px;
    }

    .barcode-input {
    height: 50px;
    font-size: 1.1rem;
    border-radius: 10px 0 0 10px;
    border: 2px solid #e2e8f0;
    border-right: none;
    }

    .barcode-input:focus {
    border-color: #0ea5e9;
    box-shadow: none;
    }

    .btn-barcode {
    border-radius: 0 10px 10px 0;
    padding: 0 20px;
    background: #0f172a;
    color: white;
    border: 2px solid #0f172a;
    transition: 0.2s;
    }

    .btn-barcode:hover {
    background: #1e293b;
    color: white;
    }
</style>

<div class="container-fluid py-4" style="max-width: 1500px;">
    <!-- HEADER -->
    <div class="transaction-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1">
                @if (isImport)
                {
                    <i class="fa-solid fa-boxes-packing me-2"></i>
                }
                else
                {

                    <i class="fa-solid fa-truck-fast me-2"></i>
                }
                @ViewBag.Title
            </h3>
            <p class="mb-0 opacity-75 fs-6"><i class="fa-solid fa-user-pen me-1"></i> Người lập: <strong>@ViewBag.CurrentUser</strong> &nbsp;|&nbsp; <i class="fa-regular fa-clock me-1"></i> @today</p>
        </div>
        <a href="/Warehouse/Index" class="btn btn-light fw-bold rounded-pill shadow-sm px-4 text-dark"><i class="fa-solid fa-arrow-left me-1"></i> Về danh sách</a>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN PHIẾU -->
        <div class="col-lg-4">
            <div class="card cart-card h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="fa-solid fa-file-invoice fs-5"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-0">Thông tin chứng từ</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="small fw-bold text-muted text-uppercase mb-1">Mã chứng từ</label>
                        <input type="text" id="txtDocumentCode" class="form-control fw-bold bg-light" value="@ViewBag.AutoCode" readonly>
                    </div>

                    @if (isImport && !isFromPO)
                    {
                        <div class="mb-4 bg-primary bg-opacity-10 p-3 rounded-3 border border-primary border-opacity-25">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkCustomerSupplied" onchange="toggleCustomerSupplied()">
                                <label class="form-check-label fw-bold text-primary" for="chkCustomerSupplied">Hàng Khách Hàng cung cấp (Giá = 0)</label>
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="small fw-bold text-muted text-uppercase mb-1">Tham chiếu Đơn hàng</label>
                        @if (isFromPO)
                        {
                            <input type="text" class="form-control fw-bold text-primary bg-primary bg-opacity-10" value="Nhập từ Đơn Đặt Hàng" readonly />
                            <input type="hidden" id="ddlOrder" value="" />
                        }
                        else
                        {
                            <select id="ddlOrder" class="form-select fw-bold shadow-sm"></select>
                            <div class="small text-muted mt-1 fst-italic"><i class="fa-solid fa-info-circle"></i> Chỉ hiển thị đơn Đã duyệt / Đang SX.</div>
                        }
                    </div>

                    @if (!isImport)
                    {
                        <div class="mb-4">
                            <label class="small fw-bold text-muted text-uppercase mb-1">Lý do xuất kho</label>
                            <select id="ddlExportReason" class="form-select fw-bold text-dark shadow-sm">
                                <option value="0">Sản xuất Đơn hàng</option>
                                <option value="1">Hao hụt / Hư hỏng</option>
                                <option value="2">Bảo hành / Khách trả</option>
                                <option value="3">Xuất bán thương mại</option>
                            </select>
                        </div>
                    }

                    <!-- 🔴 ĐÃ CẢI TIẾN: SỬ DỤNG SELECT2 KÈM TAGS THAY VÌ DATALIST -->
                    <div class="mb-4">
                        <label class="small fw-bold text-muted text-uppercase mb-1">@(isImport ? "Người giao / Nhà cung cấp" : "Người nhận hàng")</label>
                        @if (isFromPO)
                        {
                            <input type="text" id="txtReceiver" class="form-control fw-bold text-primary bg-light" readonly>
                        }
                        else
                        {
                            <select id="txtReceiver" class="form-select fw-bold text-primary shadow-sm">
                                <option value="">-- Chọn hoặc gõ tên đối tác mới --</option>
                                @if (ViewBag.Partners != null)
                                {
                                    foreach (var partner in ViewBag.Partners)
                                    {
                                        <option value="@partner">@partner</option>
                                    }
                                }
                            </select>
                            <div class="small text-muted mt-1 fst-italic">
                                <i class="fa-solid fa-lightbulb text-warning"></i> Có thể chọn từ danh sách hoặc gõ trực tiếp tên khách lẻ.
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="small fw-bold text-muted text-uppercase mb-1">Ghi chú</label>
                        <textarea id="txtNote" class="form-control shadow-sm" rows="2" placeholder="Ghi chú nội bộ..."></textarea>
                    </div>

                    @if (isImport && !isFromPO)
                    {
                        <div class="mb-3 bg-success bg-opacity-10 p-3 border border-success border-opacity-50 rounded-3">
                            <label class="small fw-bold text-success mb-2 text-uppercase"><i class="fa-solid fa-money-bill-wave me-2"></i>Thanh toán / Công nợ</label>
                            <select id="ddlPaymentMethod" class="form-select border-success fw-bold text-dark shadow-sm mb-3" onchange="togglePayment()">
                                <option value="0">👉 Ghi vào Công Nợ Phải Trả</option>
                                <option value="1">👉 Trả Tiền Mặt (Trả đủ)</option>
                                <option value="2">👉 Chuyển Khoản (Trả đủ)</option>
                            </select>
                            <div id="boxPaidAmount">
                                <label class="small fw-bold text-danger mb-1">Đã cọc / Trả trước (VNĐ)</label>
                                <input type="number" id="txtPaidAmount" class="form-control fw-bold text-end text-danger fs-5 shadow-sm" value="0" min="0" placeholder="0">
                            </div>
                        </div>
                    }
                    else if (isImport && isFromPO)
                    {
                        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center">
                            <i class="fa-solid fa-shield-check fa-2x me-3 text-info"></i>
                            <div class="small text-dark"><strong>Công Nợ An Toàn</strong><br />Đơn giá đã được khóa = 0. Công nợ được Kế toán quản lý tại Đơn Đặt Hàng.</div>
                        </div>
                        <input type="hidden" id="ddlPaymentMethod" value="0" /><input type="hidden" id="txtPaidAmount" value="0" />
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: CHỌN VẬT TƯ & GIỎ HÀNG -->
        <div class="col-lg-8">
            <div class="card cart-card h-100 d-flex flex-column">
                <div class="card-body p-4 flex-grow-1">

                    <div class="bg-light p-3 rounded-4 border mb-4 d-flex flex-column flex-md-row gap-3 align-items-center shadow-sm">
                        <!-- Dropdown Select2 Thông minh -->
                        <div class="flex-grow-1 w-100">
                            <label class="small fw-bold text-muted mb-2 text-uppercase"><i class="fa-solid fa-magnifying-glass me-1 text-primary"></i> Tra cứu thủ công</label>
                            <select id="itemSearchSelect" class="form-control w-100" style="width: 100%;">
                                <option value="">-- Click để tra cứu vật tư --</option>
                            </select>
                        </div>

                        <div class="d-none d-md-block border-end border-secondary border-opacity-25" style="height: 50px; margin: 0 10px;"></div>

                        <!-- Súng bắn mã vạch -->
                        <div class="w-100" style="max-width: 320px;">
                            <label class="small fw-bold text-muted mb-2 text-uppercase"><i class="fa-solid fa-barcode me-1 text-dark"></i> Quét mã vạch</label>
                            <div class="input-group shadow-sm">
                                <input type="text" id="barcodeInput" class="form-control fw-bold text-primary barcode-input" placeholder="Bấm vào đây để quét..." autocomplete="off">
                                <button type="button" class="btn btn-barcode" onclick="startScanner()" title="Dùng Camera điện thoại"><i class="fa-solid fa-camera"></i></button>
                            </div>
                        </div>
                    </div>

                    <!-- LƯỚI CHI TIẾT ĐA ĐVT -->
                    <div class="table-responsive border rounded-3 overflow-hidden shadow-sm" style="max-height: 500px;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-dark text-white small text-uppercase sticky-top">
                                <tr>
                                    <th class="ps-4">Mã VT</th>
                                    <th>Tên vật tư</th>
                                    <th class="text-center" width="160">Số lượng (Chọn ĐVT)</th>
                                    <th class="text-end" width="160">Đơn giá / 1 Base</th>
                                    <th class="text-end pe-4" width="140">Thành tiền</th>
                                    <th width="40" class="bg-dark"></th>
                                </tr>
                            </thead>
                            <tbody id="cartBody">
                                <tr><td colspan="6" class="text-center py-5 text-muted fst-italic"><i class="fa-solid fa-box-open fa-3x mb-3 text-light"></i><br>Bảng vật tư đang trống.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-white p-4 border-top d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div>
                        <span class="text-muted fw-bold text-uppercase small">Tổng mục:</span>
                        <span class="badge bg-dark fs-6 ms-2 px-3 py-2 rounded-pill" id="itemCountBadge">0</span>
                    </div>
                    <div class="text-end d-flex align-items-center flex-wrap gap-3 justify-content-end">
                        <div class="text-end">
                            <span class="text-muted fw-bold text-uppercase small d-block mb-1">TỔNG TIỀN @(isFromPO ? "(KHÔNG TÍNH)" : "")</span>
                            <span class="fs-3 fw-800 text-danger lh-1" id="lblTotalAmount">0</span> <span class="text-muted fw-bold">₫</span>
                        </div>
                        <button type="button" class="btn btn-primary btn-lg fw-bold rounded-pill px-5 py-3 shadow ms-md-3" onclick="saveTransaction()">
                            <i class="fa-solid fa-floppy-disk me-2"></i> LƯU PHIẾU KHO
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="scannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3"><h5 class="modal-title fw-bold"><i class="fa-solid fa-qrcode me-2"></i> Máy quét mã vạch</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="stopScanner()"></button></div>
            <div class="modal-body p-0 bg-black"><div id="reader" width="100%"></div></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // 1. ÁNH XẠ DỮ LIỆU ĐA ĐVT
        const rawItems = @Html.Raw(ViewBag.ItemsJson ?? "[]");
        const allItems = rawItems.map(x => ({
        Id: x.Id !== undefined ? x.Id : x.id,
        Code: x.Code !== undefined ? x.Code : x.code,
        Name: x.Name !== undefined ? x.Name : x.name,
        Unit: x.Unit !== undefined ? x.Unit : x.unit,
        ImportUnit: x.ImportUnit !== undefined ? x.ImportUnit : (x.importUnit || null),
        ConversionRate: x.ConversionRate !== undefined ? x.ConversionRate : (x.conversionRate || 1),
        StockQuantity: x.StockQuantity !== undefined ? x.StockQuantity : (x.stockQuantity || 0),
        CostPrice: x.CostPrice !== undefined ? x.CostPrice : (x.costPrice || 0)
        }));

        const rawOrders = @Html.Raw(ViewBag.OrdersJson ?? "[]");
        const allOrders = rawOrders.map(o => ({
        Id: o.Id !== undefined ? o.Id : o.id,
        OrderCode: o.OrderCode !== undefined ? o.OrderCode : o.orderCode,
        CustomerName: o.CustomerName !== undefined ? o.CustomerName : o.customerName
        }));

        const rawPoItems = @Html.Raw(ViewBag.PoItemsJson ?? "null");
        const poItemsData = rawPoItems ? rawPoItems.map(x => ({
        WarehouseItemId: x.WarehouseItemId !== undefined ? x.WarehouseItemId : x.warehouseItemId,
        Code: x.Code !== undefined ? x.Code : x.code,
        Name: x.Name !== undefined ? x.Name : x.name,
        Unit: x.Unit !== undefined ? x.Unit : x.unit,
        Quantity: x.Quantity !== undefined ? x.Quantity : x.quantity
        })) : null;

        const isImport = @(isImport.ToString().ToLower());
        const isFromPO = @(isFromPO.ToString().ToLower());
        let cartItems = [];
        let isCustomerSupplied = false;

        $(document).ready(function () {
            
            // 🔴 KHỞI TẠO SELECT2 CHO ĐỐI TÁC (Gợi ý + Cho phép nhập tay)
            if (!isFromPO) {
                $('#txtReceiver').select2({
                    theme: 'bootstrap-5',
                    tags: true, // Cho phép gõ text tự do không có trong list
                    placeholder: 'Gõ tên đối tác hoặc chọn...',
                    allowClear: true,
                    width: '100%'
                });
            }
            
            // Nạp Dropdown Tham Chiếu Đơn Hàng
            if (!isFromPO) {
                let orderHtml = '<option value="">-- Không tham chiếu / Xuất chung --</option>';
                allOrders.forEach(o => { orderHtml += `<option value="${o.Id}">[${o.OrderCode}] - ${o.CustomerName}</option>`; });
                $('#ddlOrder').html(orderHtml).select2({ theme: 'bootstrap-5', placeholder: "Gõ tìm mã đơn..." });
                $('#ddlOrder').on('change', function () {
                    const selectedText = $("#ddlOrder option:selected").text();
                    if (this.value && !document.getElementById("txtNote").value.includes(selectedText)) {
                        document.getElementById("txtNote").value += (document.getElementById("txtNote").value ? ", " : "") + selectedText;
                    }
                });
            }

            // AUTO-FILL TỪ PO
            if (isImport && isFromPO && poItemsData && poItemsData.length > 0) {
                document.getElementById("txtReceiver").value = '@Html.Raw(ViewBag.Receiver)';
                poItemsData.forEach(item => {
                    cartItems.push({
                    WarehouseItemId: item.WarehouseItemId, Code: item.Code, Name: item.Name,
                    Unit: item.Unit, ImportUnit: null, ConversionRate: 1,
                    InputQty: item.Quantity, InputUOM: 'Base',
                    Quantity: item.Quantity, Price: 0, OriginalQty: 0
                    });
                });
                renderCart();
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Nạp từ PO thành công!', timer: 3000, showConfirmButton: false });
            }

            // KÍCH HOẠT SELECT2 CHO VẬT TƯ
            $('#itemSearchSelect').empty();
            const selectData = [{ id: '', text: '' }];
            allItems.forEach(x => { selectData.push({ id: x.Id, text: x.Code + ' - ' + x.Name, itemObj: x }); });

            $('#itemSearchSelect').select2({
                theme: 'bootstrap-5',
                placeholder: '🔎 Click vào đây để gõ Tên hoặc Mã vật tư...',
                allowClear: true,
                width: '100%',
                data: selectData,
                templateResult: function (data) {
                    if (!data.id) return data.text;
                    let item = data.itemObj;
                    let stockClass = item.StockQuantity > 0 ? "text-success bg-success" : "text-danger bg-danger";
                    let uomHtml = item.Unit;

                    if (item.ConversionRate > 1 && item.ImportUnit) {
                        let stockImp = (item.StockQuantity / item.ConversionRate).toFixed(2);
                        uomHtml = `${item.StockQuantity} ${item.Unit} (~ ${stockImp} ${item.ImportUnit})`;
                    } else {
                        uomHtml = `${item.StockQuantity} ${item.Unit}`;
                    }

                    return $(`
                    <div class="d-flex justify-content-between align-items-center py-1">
                    <div>
                    <strong class="text-dark fs-6">${item.Name}</strong>
                    <div class="text-muted small font-monospace"><i class="fa-solid fa-barcode me-1 text-secondary"></i>${item.Code}</div>
                    </div>
                    <span class="badge ${stockClass} bg-opacity-10 border border-opacity-25 px-2 py-1 fs-6">Tồn: ${uomHtml}</span>
                    </div>
                    `);
                },
                templateSelection: function (data) { return data.text; }
            })
            .on('select2:open', function () { setTimeout(function () { document.querySelector('.select2-search__field').focus(); }, 50); })
            .on('select2:select', function (e) {
                if (e.params.data && e.params.data.id) {
                    let selectedItem = allItems.find(x => x.Id == e.params.data.id);
                    if (selectedItem) addToCart(selectedItem);
                    $(this).val(null).trigger('change');
                }
            });

            $('#barcodeInput').on('keyup', function (e) {
                if (e.key === 'Enter') {
                    let val = $(this).val().trim().toLowerCase();
                    if (val) {
                        const exactItem = allItems.find(x => x.Code.toLowerCase() === val);
                        if (exactItem) { addToCart(exactItem); $(this).val(''); }
                        else { Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: 'Mã không hợp lệ!', timer: 2000, showConfirmButton: false }); }
                    }
                }
            });
        });

        function togglePayment() {
            var method = document.getElementById("ddlPaymentMethod");
            if (method && method.value === "0") document.getElementById("boxPaidAmount").style.display = "block";
            else if (method) document.getElementById("boxPaidAmount").style.display = "none";
        }

        // 🔴 ĐÃ CẢI TIẾN LẠI LOGIC XỬ LÝ SỰ KIỆN CHO SELECT2
        function toggleCustomerSupplied() {
            let chk = document.getElementById("chkCustomerSupplied");
            isCustomerSupplied = chk ? chk.checked : false;
            
            let $receiver = $('#txtReceiver');

            if (isCustomerSupplied) { 
                if ($receiver.is("select")) {
                    if (!$receiver.find("option[value='Vật tư khách cung cấp']").length) {
                        $receiver.append(new Option('Vật tư khách cung cấp', 'Vật tư khách cung cấp', true, true));
                    }
                    $receiver.val('Vật tư khách cung cấp').trigger('change');
                    $receiver.prop('disabled', true);
                } else {
                    $receiver.val("Vật tư khách cung cấp");
                }
                cartItems.forEach(item => item.Price = 0); 
            } 
            else { 
                if ($receiver.is("select")) {
                    $receiver.val(null).trigger('change');
                    $receiver.prop('disabled', false);
                } else {
                    $receiver.val("");
                }
                cartItems.forEach(item => { 
                    const exactItem = allItems.find(x => x.Id === item.WarehouseItemId); 
                    if (exactItem) item.Price = isImport ? 0 : exactItem.CostPrice; 
                }); 
            }
            renderCart();
        }

        // ==========================================================
        // MULTI-UOM CALCULATOR LOGIC
        // ==========================================================
        function addToCart(item) {
            const existing = cartItems.find(x => x.WarehouseItemId === item.Id);
            if (existing) {
                existing.InputQty++; playBeep();
            } else {
                let price = (isCustomerSupplied || isFromPO) ? 0 : (isImport ? 0 : item.CostPrice);
                let convRate = item.ConversionRate && item.ConversionRate > 0 ? item.ConversionRate : 1;
                let defaultUom = (isImport && item.ImportUnit) ? 'Import' : 'Base';
                let calculatedBaseQty = 1 * (defaultUom === 'Import' ? convRate : 1);

                cartItems.unshift({
                WarehouseItemId: item.Id, Code: item.Code, Name: item.Name,
                Unit: item.Unit, ImportUnit: item.ImportUnit, ConversionRate: convRate,
                InputQty: 1, InputUOM: defaultUom,
                Quantity: calculatedBaseQty,
                Price: price || 0, OriginalQty: 0
                });
                playBeep();
            }
            updateComplexQty(0, cartItems[0].InputQty, cartItems[0].InputUOM); // Cập nhật đồng bộ
        }

        function updateComplexQty(index, newQty, uomType) {
            let item = cartItems[index];
            if (newQty < 0) newQty = 0;
            item.InputQty = parseFloat(newQty);
            item.InputUOM = uomType;

            // Xoay chiều về Đơn vị cơ bản (BaseUnit) để lưu Database và tính Giá vốn
            if (item.InputUOM === 'Import') {
                item.Quantity = item.InputQty * item.ConversionRate;
            } else {
                item.Quantity = item.InputQty;
            }
            renderCart();
        }

        function removeFromCart(index) { cartItems.splice(index, 1); renderCart(); }
        function updatePrice(index, newPrice) { cartItems[index].Price = parseFloat(newPrice); renderCart(); }

        function renderCart() {
            const tbody = document.getElementById("cartBody");
            const lblTotal = document.getElementById("lblTotalAmount");
            const badge = document.getElementById("itemCountBadge");

            if (cartItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-5 text-muted fst-italic"><i class="fa-solid fa-box-open fa-3x mb-3 text-light"></i><br>Bảng vật tư đang trống.</td></tr>`;
                lblTotal.innerText = "0"; badge.innerText = "0"; return;
            }

            let html = ""; let grandTotal = 0;
            cartItems.forEach((item, index) => {
                // Tiền = Số lượng Tồn thực (Base) x Đơn giá 1 Base
                const total = item.Quantity * item.Price;
                grandTotal += total;

                const isPriceLocked = isFromPO || isCustomerSupplied;
                const priceClass = isPriceLocked ? "price-input input-locked" : "price-input";
                const readonlyAttr = isPriceLocked ? "readonly" : "";

                let stockInfoHtml = "";
                let qtyHtml = "";

                // HIỂN THỊ Ô SỐ LƯỢNG THÔNG MINH CHO CÁC MÃ CÓ QUY ĐỔI
                if (item.ConversionRate > 1 && item.ImportUnit) {
                    qtyHtml = `
                    <div class="input-group input-group-sm mb-1 shadow-sm">
                    <input type="number" class="form-control text-center fw-bold" value="${item.InputQty}" onchange="updateComplexQty(${index}, this.value, '${item.InputUOM}')" min="0" step="any">
                    <select class="form-select text-primary fw-bold" style="max-width: 80px;" onchange="updateComplexQty(${index}, ${item.InputQty}, this.value)">
                    <option value="Base" ${item.InputUOM === 'Base' ? 'selected' : ''}>${item.Unit}</option>
                    <option value="Import" ${item.InputUOM === 'Import' ? 'selected' : ''}>${item.ImportUnit}</option>
                    </select>
                    </div>
                    <div class="small text-muted fw-bold">Tổng quy đổi: <span class="text-primary">${item.Quantity} ${item.Unit}</span></div>
                    `;
                } else {
                    qtyHtml = `<input type="number" class="qty-input w-100" value="${item.Quantity}" onchange="updateComplexQty(${index}, this.value, 'Base')" min="0.1" step="any">
                    <div class="small text-muted fw-bold mt-1 text-center">ĐVT: ${item.Unit}</div>`;
                }

                // CHECK ÂM KHO (CHỈ KHI XUẤT)
                if (!isImport) {
                    const exactItem = allItems.find(x => x.Id === item.WarehouseItemId);
                    if (exactItem) {
                        const realAvailableStock = exactItem.StockQuantity + (item.OriginalQty || 0);
                        const remaining = realAvailableStock - item.Quantity; // So sánh theo Base
                        if (remaining < 0) {
                            stockInfoHtml = `<div class="text-danger fw-bold mt-1" style="font-size: 0.75rem;"><i class="fa-solid fa-triangle-exclamation"></i> Kho âm: ${remaining} ${item.Unit}</div>`;
                        } else {
                            stockInfoHtml = `<div class="text-success mt-1" style="font-size: 0.75rem;">Sau xuất: ${remaining} ${item.Unit}</div>`;
                        }
                    }
                }

                html += `<tr class="border-bottom border-light bg-white">
                <td class="ps-4 fw-bold text-primary font-monospace">${item.Code}</td>
                <td class="fw-bold text-dark">
                ${item.Name}
                ${item.ConversionRate > 1 && item.ImportUnit ? `<div class="small text-info mt-1"><i class="fa-solid fa-right-left"></i> 1 ${item.ImportUnit} = ${item.ConversionRate} ${item.Unit}</div>` : ''}
                </td>
                <td class="text-center" style="min-width: 160px;">
                ${qtyHtml}
                ${stockInfoHtml}
                </td>
                <td class="text-end">
                <div class="input-group input-group-sm shadow-sm">
                <input type="number" class="${priceClass} border-end-0" ${readonlyAttr} value="${item.Price}" onchange="updatePrice(${index}, this.value)">
                <span class="input-group-text bg-light text-muted border-start-0" style="font-size: 0.75rem;">/${item.Unit}</span>
                </div>
                </td>
                <td class="text-end pe-4 fw-bold text-dark fs-6">${total.toLocaleString()}</td>
                <td class="text-center bg-white">
                <button class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" onclick="removeFromCart(${index})" title="Xóa dòng này"><i class="fa-solid fa-times"></i></button>
                </td>
                </tr>`;
            });
            tbody.innerHTML = html; lblTotal.innerText = grandTotal.toLocaleString(); badge.innerText = cartItems.length;
        }

        // ==========================================================
        // LƯU DATA VỀ BACKEND
        // ==========================================================
        function saveTransaction() {
            if (cartItems.length === 0) { Swal.fire("Lỗi", "Chưa có hàng hóa nào trong phiếu!", "warning"); return; }

            if (!isImport) {
                let willBeNegative = false; let negativeItemsList = "";
                cartItems.forEach(item => {
                    const exactItem = allItems.find(x => x.Id === item.WarehouseItemId);
                    if (exactItem) {
                        const realAvailableStock = exactItem.StockQuantity + (item.OriginalQty || 0);
                        if (item.Quantity > realAvailableStock) {
                            willBeNegative = true;
                            let negativeAmt = realAvailableStock - item.Quantity;
                            negativeItemsList += `<li><strong>${item.Name}</strong> (Tồn kho: ${realAvailableStock} -> <span class="text-danger">Thiếu: ${Math.abs(negativeAmt)} ${item.Unit}</span>)</li>`;
                        }
                    }
                });
                if (willBeNegative) {
                    Swal.fire({
                    title: '⚠️ CẢNH BÁO KHO ÂM',
                    html: `<div class="text-start">Hệ thống phát hiện kho không đủ số lượng để xuất:<ul class="mt-2 mb-3 text-danger">${negativeItemsList}</ul>Sếp có chắc chắn muốn bỏ qua cảnh báo và ép xuất không?</div>`,
                    icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc3545', cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa-solid fa-check"></i> Vẫn Ép Xuất', cancelButtonText: 'Hủy'
                    }).then((result) => { if (result.isConfirmed) executeAjaxSave(); });
                    return;
                }
            }
            executeAjaxSave();
        }

        function executeAjaxSave() {
            let reasonVal = null;
            if (!isImport) {
                const selectEl = document.getElementById("ddlExportReason");
                if (selectEl) reasonVal = parseInt(selectEl.value);
            }

            let orderIdVal = isFromPO ? null : document.getElementById("ddlOrder").value;
            let paymentMethod = 0; let paidAmount = 0;

            if (isImport) {
                let pMethodEl = document.getElementById("ddlPaymentMethod");
                if (pMethodEl) {
                    paymentMethod = parseInt(pMethodEl.value);
                    if (paymentMethod === 0) paidAmount = parseFloat(document.getElementById("txtPaidAmount").value) || 0;
                }
            }

            const data = {
                Type: '@ViewBag.Type', DocumentCode: document.getElementById("txtDocumentCode").value,
                Receiver: document.getElementById("txtReceiver").value, Note: document.getElementById("txtNote").value,
                Date: new Date().toISOString(), Items: cartItems, Reason: reasonVal,
                OrderId: orderIdVal ? parseInt(orderIdVal) : null,
                PurchaseOrderId: @(ViewBag.PoId != null ? ViewBag.PoId : "null"),
                PaymentMethod: paymentMethod, PaidAmount: paidAmount
            };

            Swal.fire({ title: 'Đang lưu chứng từ...', didOpen: () => Swal.showLoading() });

            let actionUrl = '@(ViewBag.IsEditMode == true ? "/Warehouse/UpdateTransaction" : "/Warehouse/SaveBulk")';
            $.ajax({
                url: actionUrl, type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
                success: function (res) {
                    if (res.success) {
                        Swal.fire("Thành công", "Đã lưu phiếu kho an toàn!", "success").then(() => {
                            if (@(ViewBag.PoId != null ? "true" : "false")) window.location.href = '/PurchaseOrder/Details/@ViewBag.PoId';
                            else window.location.href = '/Warehouse/Index';
                        });
                    } else Swal.fire("Lỗi Database", res.message, "error");
                },
                error: function () { Swal.fire("Lỗi mạng", "Không thể kết nối máy chủ", "error"); }
            });
        }

        function startScanner() {
            if (typeof Html5QrcodeScanner === 'undefined') { Swal.fire("Lỗi", "Module Camera chưa tải xong", "error"); return; }
            const modal = new bootstrap.Modal(document.getElementById('scannerModal')); modal.show();
            html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: { width: 250, height: 250 } }, false);
            html5QrcodeScanner.render(onScanSuccess, (err) => { });
        }

        function onScanSuccess(decodedText) {
            if (html5QrcodeScanner) html5QrcodeScanner.clear();
            bootstrap.Modal.getInstance(document.getElementById('scannerModal')).hide();
            const exactItem = allItems.find(x => x.Code.toLowerCase() === decodedText.toLowerCase());
            if (exactItem) { addToCart(exactItem); Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Đã quét: ' + exactItem.Name, timer: 1500, showConfirmButton: false }); }
            else { Swal.fire("Lỗi quét", "Mã không có trong hệ thống: " + decodedText, "warning"); }
        }

        function stopScanner() { if (html5QrcodeScanner) html5QrcodeScanner.clear(); }
        function playBeep() { /* Tắt âm thanh */ }
    </script>
}