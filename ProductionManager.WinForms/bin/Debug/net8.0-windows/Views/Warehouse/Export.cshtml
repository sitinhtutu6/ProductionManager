@model ProductionManager.Data.WarehouseTicket
@{
    ViewData["Title"] = "Lập Phiếu Xuất Kho";
    var productList = ViewBag.ProductList as IEnumerable<dynamic>;
}

<div class="container mt-4" style="max-width: 900px;">
    <form asp-action="Import" method="post" id="ticketForm">
        
        <div class="card shadow mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa-solid fa-download"></i> PHIẾU NHẬP KHO</h5>
                <a href="/Warehouse" class="btn btn-sm btn-light text-success fw-bold">Quay lại</a>
            </div>
            <div class="card-body bg-light">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Người giao hàng / Nhà cung cấp</label>
                        <input asp-for="Subject" class="form-control" required placeholder="Nhập tên người giao..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Mã phiếu (Để trống tự sinh)</label>
                        <input asp-for="TicketCode" class="form-control" placeholder="NK-..." />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-secondary mb-0">DANH SÁCH HÀNG HÓA</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()">
                    <i class="fa-solid fa-plus"></i> Thêm dòng
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered mb-0" id="detailsTable">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 50%">Sản phẩm</th>
                            <th style="width: 20%">Số lượng nhập</th>
                            <th style="width: 10%">Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                        </tbody>
                </table>
            </div>
            <div class="card-footer bg-white text-end">
                <button type="submit" class="btn btn-success fw-bold px-4 py-2">
                    <i class="fa-solid fa-floppy-disk"></i> LƯU PHIẾU NHẬP
                </button>
            </div>
        </div>

    </form>
</div>

<script>
    let rowIndex = 0;
    // Dữ liệu sản phẩm để render vào Select
    const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productList));

    function addRow() {
        const table = document.getElementById("detailsTable").getElementsByTagName('tbody')[0];
        const row = table.insertRow();
        
        // Tạo Select Option sản phẩm
        let options = '<option value="">-- Chọn hàng --</option>';
        products.forEach(p => {
            options += `<option value="${p.Id}">${p.Name}</option>`;
        });

        row.innerHTML = `
            <td>
                <select name="TicketDetails[${rowIndex}].ProductDetailId" class="form-select" required>
                    ${options}
                </select>
            </td>
            <td>
                <input type="number" name="TicketDetails[${rowIndex}].Quantity" class="form-control text-center fw-bold" min="1" value="1" required />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()"><i class="fa-solid fa-trash"></i></button>
            </td>
        `;
        rowIndex++;
    }

    // Thêm sẵn 1 dòng khi vào trang
    document.addEventListener("DOMContentLoaded", () => addRow());
</script>