@using ProductionManager.Data
@model IEnumerable<CostCategory>
@{
    ViewData["Title"] = "Cấu hình Danh mục Báo cáo P&L";
}

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-layer-group text-danger me-2"></i>Cấu hình Danh mục Chi phí (P&L)</h3>
            <p class="text-muted small mb-0">Thiết lập các loại chi phí để kế toán chọn khi lập phiếu chi</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> Thêm Loại Chi Phí Mới
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Tên loại chi phí (Hiển thị ở Sổ quỹ)</th>
                        <th>Thuộc nhóm P&L (Mỏ neo báo cáo)</th>
                        <th>Trạng thái</th>
                        <th>Mô tả</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // 🔥 HIGHLIGHT DÀNH RIÊNG CHO VẬT TƯ PHỤ
                        bool isConsumable = item.Name.ToLower().Contains("vật tư phụ") || item.Name.ToLower().Contains("tiêu hao");
                        
                        <tr class="@(isConsumable ? "bg-primary bg-opacity-10" : "")">
                            <td class="ps-4 fw-bold @(isConsumable ? "text-primary fs-5" : "text-dark")">
                                @if(isConsumable) { <i class="fa-solid fa-boxes-stacked me-2"></i> }
                                @item.Name
                            </td>
                            <td>
                                @if (item.Section == PnlSection.Exclude) { <span class="badge bg-secondary">Không hạch toán OPEX</span> }
                                else if (item.Section == PnlSection.Salary) { <span class="badge bg-primary">Nhóm Lương & BHXH</span> }
                                else if (item.Section == PnlSection.Utilities) { <span class="badge bg-warning text-dark">Nhóm Điện/Nước/Cố định</span> }
                                else if (item.Section == PnlSection.Logistics) { <span class="badge bg-info text-dark">Nhóm Vận chuyển/Logistics</span> }
                                else if (item.Section == PnlSection.Office) { <span class="badge bg-success">Nhóm Hành chính/VP</span> }
                                else if (item.Section == PnlSection.Marketing) { <span class="badge bg-danger">Nhóm Marketing/Ads</span> }
                                else if (item.Section == PnlSection.Material) { <span class="badge" style="background-color:#6366f1;">Nhóm Chi phí Sản xuất</span> }
                                else { <span class="badge bg-dark">Chi phí Khác</span> }
                            </td>
                            <td>
                                @if (item.IsActive) { <span class="badge bg-success bg-opacity-10 text-success border border-success px-2">Đang dùng</span> }
                                else { <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2">Đã ẩn</span> }
                            </td>
                            <td class="text-muted small">@item.Description</td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>