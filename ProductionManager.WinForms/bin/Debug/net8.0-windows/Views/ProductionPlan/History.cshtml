@model List<ProductionManager.Data.Order>
@using ProductionManager.Data
@{
    ViewData["Title"] = "Lịch Sử Hoàn Thành";
}

<div class="container pt-4" style="max-width: 1200px;">
    
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="fw-bold text-secondary"><i class="fa-solid fa-clock-rotate-left"></i> Lịch Sử Sản Xuất</h3>
            <ul class="nav nav-pills mt-3">
                <li class="nav-item">
                    <a class="nav-link rounded-pill px-4 text-secondary fw-bold" asp-action="Index"><i class="fa-solid fa-list-ol me-2"></i> Kế hoạch chạy</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active bg-secondary rounded-pill px-4" href="#"><i class="fa-solid fa-check-double me-2"></i> Đã hoàn thành</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã Đơn</th>
                            <th>Khách hàng</th>
                            <th>Tổng SP</th>
                            <th>Ngày Giao</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                string statusBadge = item.Status switch {
                                    OrderStatus.Delivered => "<span class='badge bg-primary'>Đang giao</span>",
                                    OrderStatus.Completed => "<span class='badge bg-success'>Hoàn thành</span>",
                                    OrderStatus.Canceled => "<span class='badge bg-secondary'>Đã hủy</span>",
                                    _ => "<span class='badge bg-light text-dark'>Khác</span>"
                                };

                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">@item.OrderCode</td>
                                    <td>@item.Customer?.CompanyName</td>
                                    <td class="fw-bold">@(item.OrderDetails?.Sum(x=>x.Quantity).ToString("N0") ?? "0")</td>
                                    <td>@item.DeliveryDeadline?.ToString("dd/MM/yyyy")</td>
                                    <td>@Html.Raw(statusBadge)</td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="fa-solid fa-eye"></i> Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có đơn hàng nào hoàn thành.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>