@model ProductionManager.Data.Customer
@using ProductionManager.Data
@{
    ViewData["Title"] = "Khách Hàng Và Nhà Cung Cấp";
    ViewData["Breadcrumbs"] = new List<(string Title, string Url)>
    {
        ("Đối Tác", Url.Action("Index", "Customer")), 
        ("Thêm Mới", "") 
    };
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i> THÔNG TIN ĐỐI TÁC</h5>
        </div>
        <div class="card-body">
            <form asp-action="@ViewContext.RouteData.Values["action"]">
                @if (ViewContext.RouteData.Values["action"].ToString() == "Edit")
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="card bg-light border-0 mb-3">
                    <div class="card-body p-3">
                        <label class="fw-bold mb-2">Loại Đối tác (*)</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Type" value="1" id="type1">
                                <label class="form-check-label fw-bold text-success" for="type1"><i class="fa-solid fa-user-tie"></i> Khách hàng</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Type" value="2" id="type2">
                                <label class="form-check-label fw-bold text-warning" for="type2"><i class="fa-solid fa-truck-field"></i> Nhà cung cấp</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Type" value="3" id="type3">
                                <label class="form-check-label fw-bold text-info" for="type3">Cả hai</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="text-primary fw-bold border-bottom pb-2">Thông tin chung</h6>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Mã Đối tác (*)</label>
                            <input asp-for="CustomerCode" class="form-control fw-bold" required />
                            <span asp-validation-for="CustomerCode" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Tên Công ty / Đơn vị (*)</label>
                            <input asp-for="CompanyName" class="form-control" required />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label small">Người liên hệ</label>
                                <input asp-for="ContactPerson" class="form-control" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label small">Điện thoại</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-primary fw-bold border-bottom pb-2">Tài chính & Liên lạc</h6>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Mã số thuế</label>
                            <input asp-for="TaxCode" class="form-control font-monospace" placeholder="VD: 031xxxxxx" />
                        </div>
                        <div class="row">
                            <div class="col-7 mb-3">
                                <label class="form-label small">Số tài khoản</label>
                                <input asp-for="BankAccount" class="form-control font-monospace" />
                            </div>
                            <div class="col-5 mb-3">
                                <label class="form-label small">Ngân hàng</label>
                                <input asp-for="BankName" class="form-control" placeholder="VD: VCB" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small">Ghi chú</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <a asp-action="Index" class="btn btn-light border fw-bold me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Lưu dữ liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>