@model ProductionApp.Web.Models.ViewModels.BomExportVM
@{
    ViewData["Title"] = "Cấu hình in ấn / Xuất Excel";
    bool hasLogo = ViewBag.HasLogo ?? false;
    string logoUrl = ViewBag.LogoUrl;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold text-uppercase mb-1 text-secondary">
                <i class="fa-solid fa-file-export me-2"></i>Thiết lập xuất bản
            </h5>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Danh sách</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ProductId" class="text-decoration-none">@Model.ProductCode</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Xuất Excel</li>
                </ol>
            </nav>
        </div>

        <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary btn-sm fw-bold shadow-sm px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại Chi tiết
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-success text-white fw-bold py-3">
                    <i class="fa-solid fa-print me-2"></i> CẤU HÌNH IN ẤN & XUẤT EXCEL
                </div>
                <div class="card-body p-4">
                    <form asp-action="ExportExcel" method="post" enctype="multipart/form-data">

                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="ProductCode" />
                        <input type="hidden" asp-for="ProductName" />

                        <div class="alert alert-light border mb-4 border-start border-5 border-success shadow-sm">
                            <strong>Đang thao tác với:</strong> <span class="text-primary fw-bold">@Model.ProductName</span> <span class="badge bg-light text-dark border">@Model.ProductCode</span>
                        </div>

                        <div class="row mb-4 pb-4 border-bottom">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-muted small text-uppercase">1. Logo công ty</label>
                                <div class="d-flex align-items-center gap-4">
                                    <div class="border rounded p-2 bg-light text-center shadow-sm" style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center;">
                                        @if (hasLogo)
                                        {
                                            <img id="logoPreview" src="@logoUrl" class="img-fluid" style="max-height: 100px;" />
                                        }
                                        else
                                        {
                                            <img id="logoPreview" src="" class="img-fluid" style="max-height: 100px; display: none;" />
                                            <span id="noLogoText" class="text-muted small"><i class="fa-regular fa-image fa-2x"></i><br>Trống</span>
                                        }
                                    </div>

                                    <div class="flex-grow-1">
                                        <input type="file" asp-for="LogoFile" class="form-control mb-2" accept=".png,.jpg,.jpeg" onchange="previewImage(this)" />
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="ShowLogo">
                                            <label class="form-check-label fw-bold small" asp-for="ShowLogo">Hiển thị Logo trong file Excel</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-muted small text-uppercase">2. Thông tin tiêu đề</label>
                                <input asp-for="CompanyName" class="form-control mb-2 fw-bold" placeholder="Tên công ty (hiển thị góc phải)..." />
                                <input asp-for="CompanyAddress" class="form-control" placeholder="Địa chỉ / Slogan..." />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">3. Chữ ký</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fa-solid fa-pen-nib"></i></span>
                                    <input asp-for="CreatorName" class="form-control" placeholder="Người lập phiếu" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">&nbsp;</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fa-solid fa-stamp"></i></span>
                                    <input asp-for="ApproverName" class="form-control" placeholder="Người duyệt" />
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-muted small text-uppercase">4. Watermark (Chữ chìm)</label>
                                <input asp-for="WatermarkText" class="form-control" placeholder="VD: LƯU HÀNH NỘI BỘ" />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" asp-action="Print" formtarget="_blank" class="btn btn-outline-primary fw-bold py-2 shadow-sm border-2 border-primary border-opacity-50">
                                <i class="fa-solid fa-print me-2"></i> XEM TRƯỚC BẢN IN (PDF)
                            </button>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-light border fw-bold px-4">Hủy bỏ</a>

                            <button type="submit" class="btn btn-success fw-bold px-5 shadow">
                                <i class="fa-solid fa-file-excel me-2"></i> LƯU & XUẤT EXCEL
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        var preview = document.getElementById('logoPreview');
        var noLogoText = document.getElementById('noLogoText');

        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                if (noLogoText) noLogoText.style.display = 'none';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>