@model ProductionManager.Data.Shipment
@{
    ViewData["Title"] = "Nhận Hàng Lỗi Từ Khách";
    ViewData["Breadcrumbs"] = new List<(string Title, string Url)>
    {
        ("Xuất Hàng Hoá", Url.Action("Index", "Shipment")), 
        ("Nhận Hàng Lỗi", "") 
    };
    var customersJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.CustomerId);
}

<style>
    /* Đổi màu nền sang tone cảnh báo nhẹ */
    .return-bg {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        min-height: 100vh;
        padding-bottom: 50px;
        font-family: 'Segoe UI', system-ui;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(251, 191, 36, 0.5);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .card-header-warning {
        background: linear-gradient(to right, #fffbeb, #fef3c7);
        border-bottom: 2px solid #fde68a;
        padding: 15px 20px;
        border-radius: 16px 16px 0 0;
    }

    .order-item {
        border-radius: 10px;
        border: 1px solid transparent;
        transition: all 0.2s;
        background: #fff;
        margin-bottom: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }

        .order-item:hover {
            border-color: #f59e0b;
            background: #fffbeb;
            cursor: pointer;
        }

    .order-checkbox:checked + .order-content {
        background: #fef3c7;
        border-radius: 8px;
    }

    .qty-input {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-weight: 700;
        color: #dc2626;
        text-align: center;
    }

        .qty-input:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
            outline: none;
        }

    .suggestion-box {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        max-height: 250px;
        overflow-y: auto;
        background: white;
        border: 1px solid #cbd5e1;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        z-index: 1050;
        display: none;
    }

    .suggestion-item {
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.95rem;
    }

        .suggestion-item:hover {
            background-color: #fffbeb;
            color: #d97706;
            font-weight: 600;
        }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<div class="return-bg">
    <div class="container-fluid pt-4 px-4">
        <form asp-action="Create" method="post" id="formCreateShipment">
            <input type="hidden" asp-for="Type" value="Return" id="shipType" />

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center">
                    <div class="bg-white p-3 rounded-circle shadow-sm me-3 text-warning">
                        <i class="fa-solid fa-rotate-left fa-2x"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Nhận Hàng Lỗi Từ Khách</h4>
                        <span class="text-danger small fw-bold">⚠️ Thu hồi hàng hỏng về kho để sửa chữa (Không trừ tiến độ đơn)</span>
                    </div>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-light bg-white border fw-bold me-2 shadow-sm rounded-pill px-4">
                        <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
                    </a>
                    <button type="button" onclick="submitShipment()" class="btn btn-warning text-dark fw-bold shadow-lg rounded-pill px-5 btn-lg">
                        <i class="fa-solid fa-download me-2"></i> HOÀN TẤT NHẬN
                    </button>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-3">
                    <div class="glass-card h-100">
                        <div class="card-header-warning">
                            <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-circle-info me-2 text-warning"></i>THÔNG TIN PHIẾU</h6>
                        </div>
                        <div class="p-4">
                            <div class="mb-3">
                                <label class="fw-bold small text-secondary mb-1">Mã Phiếu (Auto)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-barcode text-muted"></i></span>
                                    <input asp-for="ShipmentCode" class="form-control bg-light border-0 fw-bold text-danger" placeholder="PNT-..." readonly />
                                </div>
                            </div>

                            <div class="mb-4 position-relative">
                                <label class="fw-bold small text-dark mb-1">Khách Hàng (*)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-warning"></i></span>
                                    <input type="text" id="txtCustomerSearch" class="form-control border-start-0 fw-bold shadow-sm" placeholder="Gõ tên khách trả hàng..." autocomplete="off">
                                    <input type="hidden" asp-for="CustomerId" id="hdnCustomerId" />
                                </div>
                                <div id="customerSuggestions" class="suggestion-box"></div>
                            </div>

                            <div class="mb-3">
                                <label class="fw-bold small text-secondary mb-1">Ngày nhận về</label>
                                <input asp-for="ShipmentDate" type="text" class="form-control fw-bold datepicker shadow-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="mb-3">
                                <label class="fw-bold small text-secondary mb-1">Người giao / Xe tải</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fa-solid fa-user-injured text-warning"></i></span>
                                    <input asp-for="VehicleNumber" class="form-control" placeholder="Tên người mang hàng đến..." />
                                </div>
                            </div>

                            <div class="mb-0">
                                <label class="fw-bold small text-danger mb-1">Tình trạng lỗi (*)</label>
                                <textarea asp-for="Notes" class="form-control bg-light border-warning" rows="4" placeholder="Ghi rõ lý do trả: Xước sơn, gãy chân, sai màu..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="glass-card h-100 d-flex flex-column">
                        <div class="card-header-warning d-flex justify-content-between align-items-center">
                            <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-clipboard-list me-2 text-warning"></i>CHỌN ĐƠN GỐC</h6>
                            <div class="form-check form-switch m-0" title="Chọn tất cả">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="chkAllOrders">
                            </div>
                        </div>
                        <div class="p-2 flex-grow-1 position-relative bg-light bg-opacity-50 rounded-bottom" id="orderListContainer" style="overflow-y: auto; max-height: 550px;">
                            <div class="text-center py-5 mt-4 opacity-50">
                                <i class="fa-solid fa-users-viewfinder fa-3x mb-3 text-secondary"></i>
                                <p class="small fw-bold">Vui lòng chọn khách hàng<br>để tìm đơn hàng gốc</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="glass-card h-100 d-flex flex-column">
                        <div class="card-header-warning d-flex justify-content-between align-items-center">
                            <h6 class="m-0 fw-bold text-danger"><i class="fa-solid fa-boxes-packing me-2"></i>HÀNG LỖI NHẬN VỀ</h6>
                            <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm" id="itemCountBadge">0 mục</span>
                        </div>
                        <div class="table-responsive flex-grow-1 rounded-bottom bg-white" style="max-height: 600px;">
                            <table class="table table-hover align-middle mb-0" id="tblItems">
                                <thead class="bg-light small text-uppercase sticky-top" style="z-index: 10;">
                                    <tr>
                                        <th class="ps-4 py-3">Sản phẩm lỗi</th>
                                        <th class="text-center" width="90">Đã giao</th>
                                        <th class="text-center" width="90">Đã thu hồi</th>
                                        <th class="text-center bg-danger bg-opacity-10 text-danger" width="140">Nhận lần này</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <div class="opacity-50">
                                                <i class="fa-solid fa-box-open fa-3x mb-3 text-secondary"></i>
                                                <p class="small">Chưa có dữ liệu.<br>Vui lòng chọn đơn hàng bên trái.</p>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var customerList = @Html.Raw(customersJson);

        $(document).ready(function () {
            flatpickr(".datepicker", { altInput: true, altFormat: "d/m/Y", dateFormat: "Y-m-d", locale: "vn" });
        });

        // 1. TÌM KIẾM KHÁCH HÀNG
        $('#txtCustomerSearch').on('input', function () {
            let keyword = $(this).val().toLowerCase();
            let box = $('#customerSuggestions');
            box.html('');
            if (keyword.length < 1) { box.hide(); return; }

            let matches = customerList.filter(c => (c.DisplayText || c.Text).toLowerCase().includes(keyword));
            if (matches.length > 0) {
                matches.forEach(c => {
                    let text = (c.DisplayText || c.Text).replace(new RegExp(keyword, "gi"), (match) => `<strong>${match}</strong>`);
                    box.append(`<div class="suggestion-item" onclick="selectCustomer('${c.Value || c.Id}', '${c.DisplayText || c.Text}')">${text}</div>`);
                });
                box.show();
            } else { box.hide(); }
        });

        $(document).on('click', function (e) { if (!$(e.target).closest('.position-relative').length) $('#customerSuggestions').hide(); });

        function selectCustomer(id, name) {
            $('#hdnCustomerId').val(id);
            $('#txtCustomerSearch').val(name);
            $('#customerSuggestions').hide();
            loadOrders(id);
        }

        // 2. TẢI ĐƠN HÀNG
        function loadOrders(custId) {
            var container = $('#orderListContainer');
            container.html('<div class="text-center py-5"><div class="spinner-border text-warning" role="status"></div></div>');
            $('#tblItems tbody').empty();
            $('#itemCountBadge').text('0 mục');

            $.get('/Shipment/GetOrdersByCustomer?customerId=' + custId, function (orders) {
                if (orders.length === 0) {
                    container.html(`<div class="text-center py-5 mt-3"><div class="text-success"><i class="fa-solid fa-check-double fa-2x"></i></div><p class="small text-muted mt-2">Khách này không có đơn hàng nào.</p></div>`);
                    return;
                }

                var html = '';
                orders.forEach(o => {
                    html += `
                                <div class="order-item p-2">
                                    <div class="form-check m-0 d-flex align-items-center w-100">
                                        <input class="form-check-input order-checkbox me-3 shadow-none" type="checkbox" value="${o.id}" id="ord_${o.id}" style="width: 20px; height: 20px; cursor: pointer;">
                                        <label class="form-check-label w-100 cursor-pointer order-content p-2" for="ord_${o.id}">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-dark"><i class="fa-solid fa-file-invoice me-1 text-warning"></i> ${o.orderCode}</span>
                                                <span class="badge bg-light text-muted border">${o.orderDate}</span>
                                            </div>
                                        </label>
                                    </div>
                                </div>`;
                });
                container.html(html);
            });
        }

        $('#chkAllOrders').change(function () { $('.order-checkbox').prop('checked', $(this).is(':checked')); loadSelectedOrderItems(); });
        $(document).on('change', '.order-checkbox', function () { loadSelectedOrderItems(); });

        // 3. TẢI CHI TIẾT VẬT TƯ (CHỈ GỌI API RETURN)
        function loadSelectedOrderItems() {
            var selectedOrderIds = [];
            $('.order-checkbox:checked').each(function () { selectedOrderIds.push($(this).val()); });

            if (selectedOrderIds.length === 0) {
                $('#tblItems tbody').html('<tr><td colspan="4" class="text-center py-5 text-muted"><i class="fa-solid fa-hand-pointer fa-2x mb-3"></i><br>Chọn đơn hàng bên trái</td></tr>');
                $('#itemCountBadge').text('0 mục');
                return;
            }

            $('#tblItems tbody').html('<tr><td colspan="4" class="text-center py-5"><div class="spinner-border spinner-border-sm text-warning"></div> Đang kiểm tra...</td></tr>');

            // GỌI API VỚI TYPE = Return
            $.ajax({
                url: '/Shipment/GetPendingItemsByOrderIds',
                type: 'POST',
                data: { orderIds: selectedOrderIds, type: 'Return' },
                success: function (data) { renderItemsTable(data); },
                error: function () { Swal.fire('Lỗi', 'Không thể tải dữ liệu.', 'error'); }
            });
        }

        function renderItemsTable(data) {
            if (data.length === 0) {
                $('#tblItems tbody').html(`<tr><td colspan="4" class="text-center py-5 text-danger"><i class="fa-solid fa-shield-check fa-3x mb-3"></i><br>Đơn hàng này chưa giao cái nào,<br>hoặc đã thu hồi hết lỗi!</td></tr>`);
                $('#itemCountBadge').text('0 mục');
                return;
            }

            var html = '';
            var currentOrder = '';
            data.forEach((item, index) => {
                if (item.orderCode !== currentOrder) {
                    currentOrder = item.orderCode;
                    html += `<tr class="bg-light border-bottom border-top"><td colspan="4" class="fw-bold text-dark ps-4 py-2 small"><i class="fa-solid fa-caret-down me-1"></i> ${currentOrder}</td></tr>`;
                }

                html += `
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark mb-1">${item.productName}</div>
                                    <div class="small text-muted"><i class="fa-solid fa-ruler-combined me-1"></i> ${item.specifications || 'Tiêu chuẩn'}</div>
                                    <input type="hidden" name="ShipmentDetails[${index}].OrderDetailId" value="${item.id}" />
                                </td>
                                <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success fs-6">${item.shippedTotal}</span></td>
                                <td class="text-center"><span class="badge bg-warning bg-opacity-10 text-dark fs-6">${item.returnedTotal}</span></td>
                                <td class="bg-danger bg-opacity-10">
                                    <div class="d-flex align-items-center justify-content-center flex-column">
                                        <input type="number" name="ShipmentDetails[${index}].QuantityShipped"
                                               class="form-control form-control-sm qty-input text-danger shadow-sm item-qty"
                                               min="0" max="${item.pending}" value="0" onfocus="this.select()" style="width: 80px;" />
                                        <small class="text-danger mt-1 fw-bold" style="font-size: 10px;">Được thu hồi: ${item.pending}</small>
                                    </div>
                                </td>
                            </tr>`;
            });

            $('#tblItems tbody').html(html);
            $('#itemCountBadge').text(data.length + ' mục');
        }

        // 4. SUBMIT FORM
        function submitShipment() {
            if (!$('#hdnCustomerId').val()) { Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng chọn Khách hàng!' }); return; }
            if (!$('#Notes').val().trim()) { Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Bắt buộc phải nhập Tình trạng lỗi (Ghi chú)!' }); return; }

            var hasData = false;
            $('.item-qty').each(function () { if ($(this).val() > 0) hasData = true; });

            if (!hasData) {
                Swal.fire("Chưa nhập số lượng!", "Vui lòng nhập số lượng hàng lỗi cần thu hồi > 0", "warning");
                return;
            }

            Swal.fire({ title: 'Đang lưu phiếu...', didOpen: () => Swal.showLoading() });
            $('#formCreateShipment').submit();
        }
    </script>
}