@model ProductionManager.Data.Order
@{
    Layout = null; // Bỏ Layout gốc của web để có tờ A4 trắng tinh
    var payments = ViewBag.Payments as List<ProductionManager.Data.CashEntry> ?? new List<ProductionManager.Data.CashEntry>();

    decimal totalPaid = payments.Sum(p => p.Amount);
    decimal remain = Model.TotalAmount - totalPaid;

    decimal totalBilled = Model.InvoiceDetails?.Sum(i => i.BilledAmount) ?? 0;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Hồ sơ Đơn hàng - @Model.OrderCode</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
            body {
                background: #e2e8f0;
                font-family: 'Times New Roman', Times, serif;
                color: #000;
                font-size: 14px;
            }

            /* Mô phỏng tờ giấy A4 trên màn hình máy tính */
            .a4-page {
                background: white;
                width: 210mm;
                min-height: 297mm;
                margin: 20px auto;
                padding: 15mm 20mm;
                box-shadow: 0 5px 15px rgba(0,0,0,0.15);
            }

            .title-doc {
                font-size: 22px;
                font-weight: bold;
                text-align: center;
                margin-bottom: 5px;
                text-transform: uppercase;
            }

            .sub-title {
                font-size: 14px;
                text-align: center;
                font-style: italic;
                margin-bottom: 20px;
            }

            .table-print {
                width: 100%;
                margin-bottom: 15px;
                border-collapse: collapse;
            }

                .table-print th, .table-print td {
                    border: 1px solid #000;
                    padding: 6px 8px;
                    vertical-align: middle;
                }

                .table-print th {
                    background-color: #f2f2f2;
                    font-weight: bold;
                    text-align: center;
                    -webkit-print-color-adjust: exact;
                }

            .section-title {
                font-weight: bold;
                font-size: 15px;
                text-transform: uppercase;
                margin-top: 20px;
                margin-bottom: 10px;
                border-bottom: 2px solid #000;
                display: inline-block;
                padding-bottom: 3px;
            }

            .fw-bold {
                font-weight: bold !important;
            }

            /* Cấu hình khi in ra máy in thật */
            @@media print {
                body {
                    background: white;
                    margin: 0;
                    padding: 0;
                }

                .a4-page {
                    width: 100%;
                    min-height: auto;
                    margin: 0;
                    padding: 0;
                    box-shadow: none;
                }

                .no-print {
                    display: none !important;
                }

                @@page {
                    size: A4 portrait;
                    margin: 15mm 15mm;
                }
            }
    </style>
</head>
<body>

    <div class="text-center mt-3 no-print">
        <button onclick="window.print()" class="btn btn-primary fw-bold px-4 rounded-pill shadow"><i class="fa-solid fa-print me-2"></i> In Hồ Sơ</button>
        <button onclick="window.close()" class="btn btn-secondary fw-bold px-4 rounded-pill shadow ms-2"><i class="fa-solid fa-xmark me-2"></i> Đóng</button>
    </div>

    <div class="a4-page">

        <div class="row border-bottom border-dark pb-2 mb-3">
            <div class="col-7">
                <div class="fw-bold fs-5 text-uppercase">CÔNG TY SẢN XUẤT NỘI THẤT</div>
                <div>Địa chỉ: Khu Công Nghiệp ABC, TP.HCM</div>
                <div>Hotline: 0909.xxx.xxx - MST: 031xxxxxxx</div>
            </div>
            <div class="col-5 text-end">
                <div class="fst-italic">Mẫu số: 01-HD/ERP</div>
                <div>Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="title-doc">HỒ SƠ CHI TIẾT ĐƠN HÀNG</div>
        <div class="sub-title">Mã số: <strong>@Model.OrderCode</strong> | Ngày nhận: @Model.OrderDate.ToString("dd/MM/yyyy") | Hạn giao: @(Model.DeliveryDeadline?.ToString("dd/MM/yyyy") ?? "___")</div>

        <div class="mb-3">
            <table style="width:100%; line-height: 1.5;">
                <tr>
                    <td width="20%"><strong>Khách hàng:</strong></td>
                    <td width="40%">@Model.Customer?.CompanyName</td>
                    <td width="15%"><strong>Điện thoại:</strong></td>
                    <td width="25%">@Model.Customer?.PhoneNumber</td>
                </tr>
                <tr>
                    <td><strong>Địa chỉ:</strong></td>
                    <td colspan="3">@Model.Customer?.Address</td>
                </tr>
                <tr>
                    <td><strong>PO khách (Mã giấy):</strong></td>
                    <td>@Model.PaperOrderCode</td>
                    <td><strong>Trạng thái:</strong></td>
                    <td class="fw-bold">@Model.Status.ToString()</td>
                </tr>
                <tr>
                    <td><strong>Ghi chú đơn:</strong></td>
                    <td colspan="3">@Model.Notes</td>
                </tr>
            </table>
        </div>

        <div class="section-title">I. Danh sách Sản phẩm đặt hàng</div>
        <table class="table-print">
            <thead>
                <tr>
                    <th width="5%">STT</th>
                    <th width="40%">Tên sản phẩm</th>
                    <th width="10%">ĐVT</th>
                    <th width="15%">Số lượng</th>
                    <th width="15%">Đơn giá</th>
                    <th width="15%">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int sttSp = 1;
                }
                @if (Model.OrderDetails != null)
                {
                    foreach (var sp in Model.OrderDetails)
                    {
                        <tr>
                            <td class="text-center">@(sttSp++)</td>
                            <td>
                                <strong>@sp.ProductName</strong>
                                @if (!string.IsNullOrEmpty(sp.Notes))
                                {
                                    <br /><small class="fst-italic">@sp.Notes</small>
                                }
                            </td>
                            <td class="text-center">Cái</td>
                            <td class="text-center fw-bold">@sp.Quantity.ToString("N0")</td>
                            <td class="text-end">@sp.UnitPrice.ToString("N0")</td>
                            <td class="text-end fw-bold">@((sp.Quantity * sp.UnitPrice).ToString("N0"))</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-end fw-bold">TỔNG CỘNG TRỊ GIÁ ĐƠN HÀNG:</td>
                    <td class="text-end fw-bold" style="font-size: 16px;">@Model.TotalAmount.ToString("N0")</td>
                </tr>
            </tfoot>
        </table>

        <div class="section-title">II. Tiến độ Xuất kho / Giao hàng</div>
        <table class="table-print">
            <thead>
                <tr>
                    <th width="12%">Ngày xuất</th>
                    <th width="16%">Số phiếu XK</th>
                    <th width="14%">Biển số xe</th>
                    <th width="28%">Sản phẩm</th>
                    <th width="15%">Phân loại</th>
                    <th width="15%">SL Giao</th>
                </tr>
            </thead>
            <tbody>
                @{
                    bool hasShipment = false;
                }
                @if (Model.OrderDetails != null)
                {
                    foreach (var sp in Model.OrderDetails)
                    {
                        if (sp.ShipmentDetails != null && sp.ShipmentDetails.Any())
                        {
                            hasShipment = true;
                            foreach (var ship in sp.ShipmentDetails)
                            {
                                <tr>
                                    <td class="text-center">@(ship.Shipment?.ShipmentDate.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="text-center fw-bold font-monospace text-uppercase">@(ship.Shipment?.ShipmentCode ?? "N/A")</td>
                                    <td class="text-center font-monospace text-uppercase">@(string.IsNullOrEmpty(ship.Shipment?.VehicleNumber) ? "-" : ship.Shipment.VehicleNumber)</td>
                                    <td>@sp.ProductName</td>
                                    <td class="text-center">
                                        @if (ship.Shipment?.Type == ProductionManager.Data.ShipmentType.Standard)
                                        {
                                            <span>Xuất hàng</span>
                                        }
                                        else if (ship.Shipment?.Type == ProductionManager.Data.ShipmentType.Warranty)
                                        {
                                            <span>Bảo hành</span>
                                        }
                                        else if (ship.Shipment?.Type == ProductionManager.Data.ShipmentType.Return)
                                        {
                                            <span class="text-danger">Nhập trả</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@ship.QuantityShipped.ToString("N0")</td>
                                </tr>
                            }
                        }
                    }
                }
                @if (!hasShipment)
                {
                    <tr><td colspan="6" class="text-center fst-italic py-3">Chưa có dữ liệu xuất kho / giao hàng.</td></tr>
                }
            </tbody>
        </table>

        <div class="row mt-2">
            <div class="col-6">
                <div class="section-title">III. Chứng từ Hóa đơn (VAT)</div>
                <table class="table-print">
                    <thead>
                        <tr>
                            <th>Ngày HĐ</th>
                            <th>Số HĐ</th>
                            <th>Trị giá HĐ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.InvoiceDetails != null && Model.InvoiceDetails.Any())
                        {
                            foreach (var inv in Model.InvoiceDetails)
                            {
                                <tr>
                                    <td class="text-center">@inv.Invoice?.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center fw-bold">@inv.Invoice?.InvoiceNumber</td>
                                    <td class="text-end">@inv.BilledAmount.ToString("N0")</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="2" class="text-end fw-bold">TỔNG XUẤT HĐ:</td>
                                <td class="text-end fw-bold">@totalBilled.ToString("N0")</td>
                            </tr>
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center fst-italic">Chưa xuất hóa đơn</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-6">
                <div class="section-title">IV. Lịch sử Thu tiền</div>
                <table class="table-print">
                    <thead>
                        <tr>
                            <th>Ngày thu</th>
                            <th>Số phiếu</th>
                            <th>Số tiền thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (payments.Any())
                        {
                            foreach (var pay in payments)
                            {
                                <tr>
                                    <td class="text-center">@pay.TransactionDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">@pay.VoucherCode</td>
                                    <td class="text-end">@pay.Amount.ToString("N0")</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="2" class="text-end fw-bold">TỔNG ĐÃ THU:</td>
                                <td class="text-end fw-bold">@totalPaid.ToString("N0")</td>
                            </tr>
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center fst-italic">Chưa có dữ liệu thu tiền</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3 p-2" style="border: 2px solid #000;">
            <div class="row text-center fw-bold" style="font-size: 16px;">
                <div class="col-4">TỔNG TRỊ GIÁ ĐƠN:<br /> <span class="text-dark">@Model.TotalAmount.ToString("N0") đ</span></div>
                <div class="col-4">ĐÃ THANH TOÁN:<br /> <span class="text-dark">@totalPaid.ToString("N0") đ</span></div>
                <div class="col-4">CÒN PHẢI THU (NỢ):<br /> <span style="color: red;">@remain.ToString("N0") đ</span></div>
            </div>
        </div>

        <div class="row text-center mt-5">
            <div class="col-3">
                <div class="fw-bold">NGƯỜI LẬP BIỂU</div>
                <div class="fst-italic small">(Ký, ghi rõ họ tên)</div>
            </div>
            <div class="col-3">
                <div class="fw-bold">KẾ TOÁN</div>
                <div class="fst-italic small">(Ký, ghi rõ họ tên)</div>
            </div>
            <div class="col-3">
                <div class="fw-bold">KHO / VẬN CHUYỂN</div>
                <div class="fst-italic small">(Ký, ghi rõ họ tên)</div>
            </div>
            <div class="col-3">
                <div class="fw-bold">GIÁM ĐỐC</div>
                <div class="fst-italic small">(Ký, đóng dấu)</div>
            </div>
        </div>

    </div>
</body>
</html>