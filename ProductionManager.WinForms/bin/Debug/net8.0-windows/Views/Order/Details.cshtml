@model ProductionManager.Data.Order
@using ProductionManager.Data

@{
    ViewData["Title"] = "Chi tiết đơn hàng: " + Model.OrderCode;

    var allItems = Model.OrderDetails != null ? Model.OrderDetails.ToList() : new List<OrderDetail>();

    decimal totalSubtotal = allItems.Where(x => !x.IsComponent).Sum(x => x.Quantity * x.UnitPrice);
    decimal totalVatAmount = allItems.Where(x => !x.IsComponent).Sum(x => (x.Quantity * x.UnitPrice) * (decimal)(x.VatPercent / 100.0));
    decimal finalTotalAmount = totalSubtotal + totalVatAmount;

    decimal paidAmount = ViewBag.PaidAmount != null ? (decimal)ViewBag.PaidAmount : 0;
    decimal billedAmount = Model.InvoiceDetails?.Sum(x => x.BilledAmount) ?? 0;
    double paymentPercent = finalTotalAmount > 0 ? (double)(paidAmount / finalTotalAmount) * 100 : 0;
    double billedPercent = finalTotalAmount > 0 ? (double)(billedAmount / finalTotalAmount) * 100 : 0;

    int salesOrdered = allItems.Where(x => !x.IsComponent).Sum(x => (int)x.Quantity);

    var validToShipIds = new List<int>();
    var displayGroups = allItems.GroupBy(x => string.IsNullOrEmpty(x.BundleCode) ? x.Id.ToString() : x.BundleCode).ToList();

    foreach (var g in displayGroups)
    {
        var comps = g.Where(x => x.IsComponent).ToList();
        if (comps.Any()) validToShipIds.AddRange(comps.Select(x => x.Id));
        else validToShipIds.AddRange(g.Select(x => x.Id));
    }

    int totalShippable = allItems.Where(x => validToShipIds.Contains(x.Id)).Sum(x => (int)x.Quantity);
    int totalShipped = allItems.Where(x => validToShipIds.Contains(x.Id)).Sum(x => x.ShipmentDetails?.Sum(s => (int)s.QuantityShipped) ?? 0);
    double shipPercent = totalShippable > 0 ? ((double)totalShipped / totalShippable) * 100 : 0;

    var relatedShipments = new List<ProductionManager.Data.Shipment>();
    foreach (var od in allItems)
    {
        if (od.ShipmentDetails != null)
        {
            foreach (var sd in od.ShipmentDetails)
            {
                if (sd.Shipment != null && !relatedShipments.Any(s => s.Id == sd.Shipment.Id)) relatedShipments.Add(sd.Shipment);
            }
        }
    }
    relatedShipments = relatedShipments.OrderByDescending(s => s.ShipmentDate).ToList();

    var statusTranslations = new Dictionary<OrderStatus, string> {
        { OrderStatus.PendingApproval, "Chờ duyệt" }, { OrderStatus.Approved, "Đã duyệt" },
        { OrderStatus.InProduction, "Đang sản xuất" }, { OrderStatus.Completed, "Hoàn thành" },
        { OrderStatus.Delivered, "Đã giao hàng" }, { OrderStatus.Invoiced, "Đã xuất hóa đơn" },
        { OrderStatus.Canceled, "Đã hủy" }
    };
    string currentStatusVN = statusTranslations.ContainsKey(Model.Status) ? statusTranslations[Model.Status] : Model.Status.ToString();

    var attachments = new List<Dictionary<string, string>>();
    if (!string.IsNullOrEmpty(Model.DesignFile))
    {
        try
        {
            if (Model.DesignFile.Trim().StartsWith("[")) attachments = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string, string>>>(Model.DesignFile);
            else attachments.Add(new Dictionary<string, string> { { "Id", Guid.NewGuid().ToString() }, { "FileName", Model.DesignFile }, { "FilePath", Model.DesignFile } });
        }
        catch { }
    }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
    :root {
        --primary: #0284c7;
        --success: #16a34a;
        --warning: #d97706;
        --danger: #dc2626;
        --border: #e2e8f0;
        --bg-light: #f8fafc;
    }

    body {
        background-color: #f1f5f9;
        font-family: 'Inter', sans-serif;
        color: #1e293b;
    }

    .erp-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #f8fafc;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 800;
        font-size: 13px;
        text-transform: uppercase;
        color: #334155;
    }

    .hero-header {
        background: #fff;
        padding: 20px 24px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        margin-bottom: 24px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        border-left: 5px solid #0284c7;
    }

    @@media (min-width: 768px) {
        .hero-header {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }

    .kpi-box {
        padding: 20px;
        border-bottom: 1px solid #e2e8f0;
    }

    @@media (min-width: 992px) {
        .kpi-box {
            border-bottom: none;
            border-right: 1px solid #e2e8f0;
        }

            .kpi-box:last-child {
                border-right: none;
            }
    }

    .kpi-title {
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .kpi-value {
        font-size: 1.4rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
        line-height: 1;
    }

    .progress-thin {
        height: 6px;
        border-radius: 10px;
        background-color: #e2e8f0;
    }

    .table-modern {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
        min-width: 700px;
    }

        .table-modern th {
            background: #f8fafc;
            padding: 14px 16px;
            font-size: 12px;
            text-transform: uppercase;
            color: #64748b;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .table-modern td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
            font-size: 13.5px;
        }

    .summary-label {
        font-weight: 700;
        text-align: right;
        color: #64748b;
        text-transform: uppercase;
        font-size: 12px;
    }

    .summary-value {
        font-weight: 800;
        text-align: right;
        font-size: 15px;
        color: #0f172a;
        padding-right: 24px !important;
    }
</style>

<div class="container-fluid py-4">
    <div class="hero-header">
        <div>
            <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
                <h1 class="m-0 fw-bold fs-4 text-dark">ĐƠN HÀNG: @Model.OrderCode</h1>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 fs-6">@currentStatusVN</span>
                @if (Model.IsLocked)
                {
                    <span class="badge bg-dark text-white px-3 py-2"><i class="fa-solid fa-lock me-1"></i> Đã Khóa</span>
                }
            </div>
            <div class="text-muted fw-600 fs-6 d-flex flex-wrap gap-3 mt-2">
                <span><i class="fa-solid fa-building me-1 text-secondary"></i> Khách: <span class="text-dark">@Model.Customer?.CompanyName</span></span>
                <span><i class="fa-solid fa-calendar-day me-1 text-secondary"></i> Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy")</span>
                <span><i class="fa-solid fa-clock me-1 text-danger"></i> Hạn giao: <span class="text-danger">@(Model.DeliveryDeadline?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</span></span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-start justify-content-md-end w-100 w-md-auto mt-3 mt-md-0">
            <div class="input-group shadow-sm w-100" style="max-width: 250px;">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" class="form-control border-start-0 fw-bold" placeholder="Nhập mã đơn..." onkeypress="jumpToOrder(event, this.value)">
            </div>
            <div class="d-flex gap-2 w-100 mt-2 mt-sm-0 flex-wrap justify-content-start justify-content-md-end">
                <div class="btn-group shadow-sm flex-shrink-0">
                    <a href="/Order/Details/@(Model.Id - 1)" class="btn btn-light border" title="Xem đơn trước"><i class="fa-solid fa-chevron-left"></i></a>
                    <a href="/Order/Details/@(Model.Id + 1)" class="btn btn-light border" title="Xem đơn sau"><i class="fa-solid fa-chevron-right"></i></a>
                </div>
                <a asp-action="PrintOrder" asp-route-id="@Model.Id" target="_blank" class="btn btn-danger fw-bold shadow-sm"><i class="fa-solid fa-file-pdf me-1"></i> In PDF</a>
                <button onclick="exportExcelDetail()" class="btn btn-success fw-bold shadow-sm"><i class="fa-solid fa-file-excel me-1"></i> Excel</button>
                <a asp-action="Index" class="btn btn-light border fw-bold shadow-sm"><i class="fa-solid fa-arrow-left me-1"></i> Trở về</a>
            </div>
        </div>
    </div>

    <div class="erp-card">
        <div class="row g-0">
            <div class="col-lg-4 kpi-box">
                <div class="kpi-title"><i class="fa-solid fa-money-bill-wave text-success me-1"></i> THU TIỀN / DOANH THU</div>
                <div class="kpi-value text-success">@paidAmount.ToString("N0") <small class="text-muted fs-6 fw-500">/ @finalTotalAmount.ToString("N0") ₫</small></div>
                <div class="d-flex justify-content-between small fw-bold mb-1"><span>Tiến độ thu</span><span>@paymentPercent.ToString("0")%</span></div>
                <div class="progress progress-thin"><div class="progress-bar bg-success" style="width: @paymentPercent%"></div></div>
            </div>
            <div class="col-lg-4 kpi-box">
                <div class="kpi-title"><i class="fa-solid fa-file-invoice text-warning me-1"></i> HÓA ĐƠN VAT (ĐÃ XUẤT)</div>
                <div class="kpi-value text-warning">@billedAmount.ToString("N0") <small class="text-muted fs-6 fw-500">/ @finalTotalAmount.ToString("N0") ₫</small></div>
                <div class="d-flex justify-content-between small fw-bold mb-1"><span>Tiến độ HĐ</span><span>@billedPercent.ToString("0")%</span></div>
                <div class="progress progress-thin"><div class="progress-bar bg-warning" style="width: @billedPercent%"></div></div>
            </div>
            <div class="col-lg-4 kpi-box">
                <div class="kpi-title"><i class="fa-solid fa-box-open text-primary me-1"></i> GIAO HÀNG THỰC TẾ</div>
                <div class="kpi-value text-primary">@totalShipped <small class="text-muted fs-6 fw-500">/ @totalShippable Chi tiết</small></div>
                <div class="d-flex justify-content-between small fw-bold mb-1"><span>Tiến độ xuất kho</span><span>@shipPercent.ToString("0")%</span></div>
                <div class="progress progress-thin"><div class="progress-bar bg-primary" style="width: @shipPercent%"></div></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="erp-card mb-4">
                <div class="card-header-custom d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-list-check me-2 text-primary"></i> 1. SẢN PHẨM & BÁO GIÁ</span>
                    @if (!Model.IsLocked)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning text-dark fw-bold shadow-sm"><i class="fa-solid fa-pen-to-square me-1"></i> Sửa SP</a>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table-modern">
                        <thead>
                            <tr>
                                <th class="ps-4">Tên Sản Phẩm & Quy Cách</th>
                                <th class="text-center">Đơn Giá</th>
                                <th class="text-center">SL Đặt</th>
                                <th class="text-center text-success">Đã Giao</th>
                                <th class="text-end pe-4">Tổng Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in displayGroups)
                            {
                                var parent = group.FirstOrDefault(x => !x.IsComponent);
                                var children = group.Where(x => x.IsComponent).ToList();

                                if (parent != null)
                                {
                                    decimal subtotal = parent.Quantity * parent.UnitPrice;
                                    decimal totalWithVat = subtotal * (1 + (decimal)(parent.VatPercent / 100.0));
                                    int pShipped = parent.ShipmentDetails?.Sum(s => (int)s.QuantityShipped) ?? 0;

                                    <tr class="bg-light border-top">
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark fs-6">@parent.ProductName</div>
                                            <div class="small text-muted">@parent.Specifications</div>
                                        </td>
                                        <td class="text-center text-muted fw-500">@(parent.UnitPrice > 0 ? parent.UnitPrice.ToString("N0") : "-")</td>
                                        <td class="text-center fw-bold text-primary fs-6">@parent.Quantity</td>
                                        <td class="text-center fw-bold text-success fs-6">@(children.Any() ? "-" : pShipped.ToString())</td>
                                        <td class="text-end pe-4 fw-bold text-dark">@(totalWithVat > 0 ? totalWithVat.ToString("N0") : "-")</td>
                                    </tr>
                                }
                                foreach (var child in children)
                                {
                                    int cShipped = child.ShipmentDetails?.Sum(s => (int)s.QuantityShipped) ?? 0;
                                    <tr>
                                        <td class="ps-5">
                                            <div class="fw-600 text-muted"><i class="fa-solid fa-arrow-turn-up fa-rotate-90 me-2 text-warning"></i> @child.ProductName</div>
                                            <div class="small text-muted ms-4">@child.Specifications</div>
                                        </td>
                                        <td class="text-center text-muted">-</td>
                                        <td class="text-center fw-bold text-muted">@child.Quantity</td>
                                        <td class="text-center fw-bold text-success">@cShipped</td>
                                        <td class="text-end pe-4">-</td>
                                    </tr>
                                }
                            }
                            <tr class="bg-light border-top-2 mt-3">
                                <td colspan="4" class="summary-label py-3">Cộng tiền hàng (Chưa thuế):</td>
                                <td class="summary-value py-3 text-end">@totalSubtotal.ToString("N0") ₫</td>
                            </tr>
                            <tr class="bg-light">
                                <td colspan="4" class="summary-label py-2">Tiền thuế VAT:</td>
                                <td class="summary-value py-2 text-warning text-end">@totalVatAmount.ToString("N0") ₫</td>
                            </tr>
                            <tr style="background-color: #f0f9ff;">
                                <td colspan="4" class="summary-label py-3 fs-6 text-primary">TỔNG CỘNG THANH TOÁN:</td>
                                <td class="summary-value py-3 fs-5 text-primary text-end">@finalTotalAmount.ToString("N0") ₫</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="erp-card mb-4">
                <div class="card-header-custom d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-truck-ramp-box me-2 text-primary"></i> 2. LỊCH SỬ GIAO HÀNG</span>
                    @if (totalShipped < totalShippable && !Model.IsLocked)
                    {
                        <a asp-controller="Shipment" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-sm btn-primary fw-bold shadow-sm"><i class="fa-solid fa-plus me-1"></i> Tạo Phiếu Xuất</a>
                    }
                </div>
                @if (!relatedShipments.Any())
                {
                    <div class="text-center py-5"><i class="fa-solid fa-truck-ramp-box fa-3x text-muted opacity-25 mb-3"></i><div class="text-muted fw-bold">Chưa có dữ liệu xuất kho/giao hàng.</div></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-modern">
                            <thead><tr><th class="ps-4">Mã Phiếu Xuất</th><th>Ngày Giao</th><th>Biển Số Xe</th><th>Chi Tiết Hàng Giao</th><th class="text-center">Bản in</th></tr></thead>
                            <tbody>
                                @foreach (var ship in relatedShipments)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold align-top pt-3"><a asp-controller="Shipment" asp-action="Details" asp-route-id="@ship.Id" class="text-primary text-decoration-none">@ship.ShipmentCode</a></td>
                                        <td class="fw-500 align-top pt-3">@ship.ShipmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="align-top pt-3"><span class="badge bg-light text-dark border font-monospace">@ship.VehicleNumber</span></td>
                                        <td class="pt-3 pb-3">
                                            <ul class="mb-0 ps-3 small text-muted">
                                                @if (ship.ShipmentDetails != null)
                                                {
                                                    @foreach (var detail in ship.ShipmentDetails.Where(sd => sd.OrderDetail != null && sd.OrderDetail.OrderId == Model.Id))
                                                    {
                                                        <li class="mb-1"><span class="fw-bold text-dark">@detail.OrderDetail.ProductName</span>: <b class="text-success">@detail.QuantityShipped</b> cái</li>
                                                    }
                                                }
                                            </ul>
                                        </td>
                                        <td class="text-center align-top pt-3"><a asp-controller="Shipment" asp-action="Details" asp-route-id="@ship.Id" class="btn btn-sm btn-outline-secondary fw-bold">Xem phiếu</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="erp-card mb-4">
                <div class="card-header-custom d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i> 3. HÓA ĐƠN & THU TIỀN</span>
                    @if (billedAmount < finalTotalAmount && !Model.IsLocked)
                    {
                        <button class="btn btn-sm btn-warning text-dark fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#invoiceModal"><i class="fa-solid fa-plus me-1"></i> Xuất Hóa Đơn</button>
                    }
                </div>
                <div class="p-3 bg-white">
                    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-receipt text-warning me-2"></i>DANH SÁCH HÓA ĐƠN ĐÃ XUẤT</h6>
                    <div class="table-responsive border rounded-3 mb-4">
                        <table class="table-modern mb-0 text-center w-100">
                            <thead><tr><th class="text-start ps-4">Số Hóa Đơn</th><th>Ngày Xuất</th><th class="text-end">Số Tiền (VNĐ)</th><th>Chứng Từ</th><th>Xóa</th></tr></thead>
                            <tbody>
                                @if (Model.InvoiceDetails == null || !Model.InvoiceDetails.Any())
                                {
                                    <tr><td colspan="5" class="py-4 text-muted">Chưa có hóa đơn nào được ghi nhận.</td></tr>
                                }
                                else
                                {
                                    foreach (var inv in Model.InvoiceDetails)
                                    {
                                        <tr>
                                            <td class="text-start ps-4 fw-bold text-dark">@inv.Invoice?.InvoiceNumber</td>
                                            <td>@(inv.Invoice?.InvoiceDate.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td class="text-end fw-bold text-primary">@inv.BilledAmount.ToString("N0")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(inv.Invoice?.InvoiceFile))
                                                {
                                                    <a href="/invoices/@inv.Invoice.InvoiceFile" target="_blank" class="text-success fw-bold text-decoration-none"><i class="fa-solid fa-download me-1"></i> Tải</a>
                                                }
                                                else
                                                {

                                                    <span class="text-muted small">-</span>
                                                }
                                            </td>
                                            <td><button class="btn btn-sm btn-outline-danger border-0" onclick="deleteInvoice(@inv.Id)"><i class="fa-solid fa-trash"></i></button></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3 mt-4 flex-wrap gap-2">
                        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-hand-holding-dollar text-success me-2"></i>LỊCH SỬ THU TIỀN</h6>
                    </div>
                    <div class="alert alert-success bg-opacity-10 border-success d-flex justify-content-between align-items-center mb-0 flex-wrap gap-3">
                        <div><h5 class="text-success fw-bold mb-1">Tổng đã thu: @paidAmount.ToString("N0") ₫</h5><small class="text-muted fw-600">Vào module Sổ Quỹ để xem phiếu thu chi tiết.</small></div>
                        <a asp-controller="CashBook" asp-action="Create" asp-route-type="Receipt" asp-route-orderId="@Model.Id" class="btn btn-success fw-bold shadow-sm"><i class="fa-solid fa-plus me-1"></i> Lập Phiếu Thu</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="erp-card mb-4">
                <div class="card-header-custom"><i class="fa-solid fa-arrows-spin me-2 text-primary"></i> ĐIỀU CHỈNH TRẠNG THÁI</div>
                <div class="p-3">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="small fw-bold text-muted mb-2">Trạng thái hệ thống:</label>
                        <select name="newStatus" class="form-select mb-3 fw-bold bg-light" @(Model.IsLocked ? "disabled" : "")>
                            @foreach (var status in Enum.GetValues(typeof(OrderStatus)))
                            {
                                var sttEnum = (OrderStatus)status;
                                string vnName = statusTranslations.ContainsKey(sttEnum) ? statusTranslations[sttEnum] : sttEnum.ToString();
                                <option value="@sttEnum" selected="@(Model.Status == sttEnum)">@vnName</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm" @(Model.IsLocked ? "disabled" : "")><i class="fa-solid fa-floppy-disk me-1"></i> Lưu trạng thái</button>
                    </form>
                </div>
            </div>

            <div class="erp-card mb-4">
                <div class="card-header-custom d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-paperclip me-2 text-primary"></i> FILE ĐÍNH KÈM (@attachments.Count)</span>
                    @if (!Model.IsLocked)
                    {
                        <button class="btn btn-sm btn-primary fw-bold shadow-sm" onclick="document.getElementById('designFileInput').click()"><i class="fa-solid fa-upload me-1"></i> Upload</button>
                        <input type="file" id="designFileInput" class="d-none" multiple onchange="uploadMultipleFiles(@Model.Id, this)">
                    }
                </div>
                <div class="p-2">
                    @if (attachments.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var file in attachments)
                            {
                                var fid = file["Id"]; var fname = file["FileName"]; var fpath = file["FilePath"]; var ext = System.IO.Path.GetExtension(fpath).ToLower();
                                <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-3 border-bottom flex-wrap gap-2">
                                    <div class="d-flex align-items-center overflow-hidden flex-grow-1">
                                        @if (ext == ".pdf")
                                        {
                                            <i class="fa-solid fa-file-pdf fa-2x text-danger me-3"></i>
                                        }
                                        else if (new[] { ".jpg", ".png", ".jpeg" }.Contains(ext))
                                        {

                                            <img src="/uploads/@fpath" class="rounded me-3 border shadow-sm" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {

                                            <i class="fa-solid fa-file-lines fa-2x text-secondary me-3"></i>
                                        }
                                        <div class="text-truncate" style="max-width: 150px;" title="@fname"><span class="fw-bold text-dark fs-6">@fname</span></div>
                                    </div>
                                    <div class="btn-group shadow-sm flex-shrink-0">
                                        <a href="/uploads/@fpath" target="_blank" class="btn btn-sm btn-light border text-primary" title="Tải xuống"><i class="fa-solid fa-download"></i></a>
                                        @if (!Model.IsLocked)
                                        {
                                            <button type="button" class="btn btn-sm btn-light border text-warning" data-name="@fname" onclick="renameFile('@fid', this.getAttribute('data-name'))" title="Đổi tên"><i class="fa-solid fa-pen"></i></button>
                                            <button class="btn btn-sm btn-light border text-danger" onclick="deleteFileItem('@fid')" title="Xóa file"><i class="fa-solid fa-trash"></i></button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {

                        <div class="text-center py-4"><i class="fa-regular fa-folder-open fa-3x text-muted opacity-25 mb-3"></i><div class="text-muted small fw-600">Chưa có tài liệu đính kèm.</div></div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="erp-card p-4 bg-warning bg-opacity-10 border-warning border-opacity-25">
                    <h6 class="fw-bold text-warning mb-2"><i class="fa-solid fa-comment-dots me-2"></i>Ghi chú nội bộ:</h6><div class="text-dark fw-500">@Model.Notes</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="invoiceModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow-lg rounded-4"><div class="modal-header bg-dark text-white border-0"><h6 class="modal-title fw-bold"><i class="fa-solid fa-file-invoice me-2"></i> Khai Báo Xuất Hóa Đơn Mới</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><form id="invoiceForm"><div class="modal-body bg-light"><input type="hidden" name="id" value="@Model.Id" /><div class="card border-0 shadow-sm mb-3"><div class="card-body p-3"><div class="mb-3"><label class="form-label fw-bold small text-muted">Số Hóa Đơn *</label><input type="text" name="invoiceNumber" class="form-control fw-bold" required></div><div class="mb-3"><label class="form-label fw-bold small text-muted">Ngày Xuất HĐ *</label><input type="date" name="invoiceDate" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")"></div><div class="mb-3"><label class="form-label fw-bold small text-muted">Số Tiền (Có VAT) *</label><div class="input-group"><input type="number" name="billedAmount" class="form-control fw-bold text-primary" required max="@(finalTotalAmount - billedAmount)" value="@(finalTotalAmount - billedAmount)"><span class="input-group-text bg-white fw-bold text-muted">VNĐ</span></div></div></div></div><div class="mb-1 ps-1"><label class="form-label fw-bold small text-muted">File Chứng Từ</label><input type="file" name="invoiceFile" class="form-control bg-white shadow-sm"></div></div><div class="modal-footer border-0"><button type="button" class="btn btn-light fw-bold border" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-warning text-dark fw-bold px-4">Lưu Hóa Đơn</button></div></form></div></div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('invoiceForm').addEventListener('submit', function (e) {
        e.preventDefault();
        fetch('/Order/UploadInvoice', { method: 'POST', body: new FormData(this) })
        .then(res => res.json()).then(data => { if (data.success) { Swal.fire({ icon: 'success', title: 'Hoàn tất', timer: 1500, showConfirmButton: false }).then(() => location.reload()); } else { Swal.fire('Lỗi', data.message, 'error'); } });
        });

        function deleteInvoice(id) {
        Swal.fire({ title: 'Xác nhận xóa?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Đồng ý', confirmButtonColor: '#dc2626' })
        .then((result) => { if (result.isConfirmed) { fetch(`/Order/DeleteInvoice?detailId=${id}`, { method: 'POST' }).then(res => res.json()).then(data => { if (data.success) location.reload(); }); } });
        }

        function jumpToOrder(e, orderCode) {
        if (e.key === 'Enter') {
        e.preventDefault(); if (!orderCode.trim()) return;
        fetch(`/Order/GetOrderIdByCode?code=${encodeURIComponent(orderCode.trim())}`).then(res => res.json()).then(data => { if (data.success) window.location.href = `/Order/Details/${data.id}`; else Swal.fire('Lỗi', data.message, 'warning'); });
        }
        }

        function exportExcelDetail() { window.location.href = '/Order/ExportExcelDetail?id=@Model.Id'; }

        function uploadMultipleFiles(id, input) {
        if (!input.files || input.files.length === 0) return;
        let formData = new FormData(); formData.append('id', id); for (let i = 0; i < input.files.length; i++) { formData.append('designFiles', input.files[i]); }
        Swal.fire({ title: 'Đang tải lên...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        fetch('/Order/UploadMultipleDesignFiles', { method: 'POST', body: formData }).then(res => res.json()).then(data => { if (data.success) location.reload(); });
        }

        function renameFile(fileId, currentName) {
        Swal.fire({ title: 'Đổi tên file', input: 'text', inputValue: currentName, showCancelButton: true, confirmButtonText: 'Lưu' })
        .then((result) => {
        if (result.isConfirmed) {
        let formData = new FormData(); formData.append('id', @Model.Id); formData.append('fileId', fileId); formData.append('newName', result.value.trim());
        fetch('/Order/RenameDesignFile', { method: 'POST', body: formData }).then(res => res.json()).then(data => { if (data.success) location.reload(); });
        }
        });
        }

        function deleteFileItem(fileId) {
        Swal.fire({ title: 'Xóa tài liệu này?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Xóa', confirmButtonColor: '#dc2626' })
        .then((result) => {
        if (result.isConfirmed) {
        let formData = new FormData(); formData.append('id', @Model.Id); formData.append('fileId', fileId);
        fetch(`/Order/DeleteDesignFileItem`, { method: 'POST', body: formData }).then(res => res.json()).then(data => { if (data.success) location.reload(); });
        }
        });
        }
    </script>
}