@using X.PagedList.Mvc.Core;
@using X.PagedList;
@model IPagedList<ProductionManager.Data.Order>
@using Microsoft.AspNetCore.Authorization
@using ProductionManager.Data
@using ProductionApp.Web.Constants

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    var customerList = ViewBag.CustomerList as IEnumerable<SelectListItem>;
    var paymentMap = ViewBag.PaymentMap as Dictionary<int, decimal>;
    var totalOrders = Model != null ? Model.TotalItemCount : 0;
    var pendingCount = Model != null ? Model.Count(x => x.Status == OrderStatus.PendingApproval) : 0;
    var productionCount = Model != null ? Model.Count(x => x.Status == OrderStatus.InProduction) : 0;

    decimal totalRevenue = 0;
    if (ViewBag.TotalRevenue != null) { decimal.TryParse(ViewBag.TotalRevenue.ToString(), out totalRevenue); }

    bool canCreate = User.IsInRole("Admin") || User.HasClaim(c => c.Type == AppPermissions.ClaimType && c.Value == AppPermissions.Orders.Create);
    bool canEdit = User.IsInRole("Admin") || User.HasClaim(c => c.Type == AppPermissions.ClaimType && c.Value == AppPermissions.Orders.Edit);
    bool canDelete = User.IsInRole("Admin") || User.HasClaim(c => c.Type == AppPermissions.ClaimType && c.Value == AppPermissions.Orders.Delete);
    bool canApprove = User.IsInRole("Admin") || User.IsInRole("Manager");
    bool canViewFinance = User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Accountant") || User.HasClaim(c => c.Type == AppPermissions.ClaimType && c.Value == AppPermissions.Orders.Approve);

    bool isShowingInvoiced = ViewBag.Status?.ToString() == ((int)OrderStatus.Invoiced).ToString();
    string currentStatusStr = ViewBag.Status?.ToString() ?? "";
    string viewMode = ViewBag.ViewMode?.ToString() ?? "list";

    int totalColumnsList = 8 + (canDelete ? 1 : 0) + (canViewFinance ? 1 : 0) + (isShowingInvoiced ? 1 : 0);

    var statusTranslations = new Dictionary<OrderStatus, string> {
        { OrderStatus.PendingApproval, "Chờ duyệt" }, { OrderStatus.Approved, "Đã duyệt" },
        { OrderStatus.InProduction, "Đang SX" }, { OrderStatus.Packing, "Đóng gói" },
        { OrderStatus.Delivered, "Đã giao" }, { OrderStatus.Invoiced, "Đã xuất HĐ" },
        { OrderStatus.Completed, "Hoàn thành" }, { OrderStatus.Canceled, "Bị hủy" }
    };
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<style>
    :root {
        --primary: #0ea5e9;
        --border: #e2e8f0;
        --bg-body: #f8fafc;
        --text-main: #1e293b;
        --color-pending: #f59e0b;
        --color-delivered: #0ea5e9;
        --color-completed: #10b981;
        --color-canceled: #ef4444;
    }

    body {
        background-color: var(--bg-body);
        font-family: 'Inter', sans-serif;
        color: var(--text-main);
        overflow-y: hidden;
        margin: 0;
        padding: 0;
    }

    #topProgressBar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background-color: #f59e0b;
        z-index: 99999;
        display: none;
        transition: width 0.2s ease;
        box-shadow: 0 0 10px #f59e0b;
    }

    .erp-layout-wrapper {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 65px);
        padding: 15px;
    }

    .erp-header-section {
        flex-shrink: 0;
    }

    .erp-body-section {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #fff;
        border-radius: 12px;
        border: 1px solid var(--border);
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
    }

    .table-scroll-container {
        flex-grow: 1;
        overflow-y: auto;
        background: #fff;
    }

        .table-scroll-container::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .table-scroll-container::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .table-scroll-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

    .table-erp, .table-excel {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
    }

    .table-excel {
        border-collapse: collapse;
    }

        .table-erp thead, .table-excel thead {
            position: sticky;
            top: 0;
            z-index: 10;
        }

    .table-erp th {
        background: #f8fafc;
        padding: 12px 14px;
        font-size: 11.5px;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        white-space: nowrap;
        vertical-align: middle;
        box-shadow: inset 0 -1px 0 var(--border), inset 0 1px 0 var(--border);
    }

    .table-erp td {
        padding: 14px;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
        font-size: 13.5px;
        transition: background-color 0.2s;
    }

    .table-erp .filter-row th {
        background: #fff;
        padding: 6px 10px;
        box-shadow: inset 0 -2px 0 #cbd5e1;
    }

    .table-excel th, .table-excel td {
        border: 1px solid #cbd5e1;
        padding: 10px 14px;
        font-size: 13px;
        vertical-align: middle;
    }

    .table-excel th {
        background-color: #f1f5f9;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        white-space: nowrap;
        box-shadow: inset 0 -1px 0 #cbd5e1;
    }

    .erp-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid var(--border);
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .filter-input {
        width: 100%;
        padding: 6px 10px;
        font-size: 12.5px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-weight: 600;
        color: var(--primary);
        transition: 0.2s;
    }

        .filter-input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 2px #e0f2fe;
        }

    tr.row-suspended > td {
        background-color: color-mix(in srgb, var(--color-pending) 8%, transparent) !important;
        border-bottom-color: rgba(0,0,0,0.03) !important;
    }

        tr.row-suspended > td:first-child {
            box-shadow: inset 4px 0 0 0 var(--color-pending) !important;
        }

    tr.row-delivered > td {
        background-color: color-mix(in srgb, var(--color-delivered) 8%, transparent) !important;
        border-bottom-color: rgba(0,0,0,0.03) !important;
    }

        tr.row-delivered > td:first-child {
            box-shadow: inset 4px 0 0 0 var(--color-delivered) !important;
        }

    tr.row-completed > td {
        background-color: color-mix(in srgb, var(--color-completed) 8%, transparent) !important;
        border-bottom-color: rgba(0,0,0,0.03) !important;
    }

        tr.row-completed > td:first-child {
            box-shadow: inset 4px 0 0 0 var(--color-completed) !important;
        }

    tr.row-canceled > td {
        background-color: color-mix(in srgb, var(--color-canceled) 8%, transparent) !important;
        border-bottom-color: rgba(0,0,0,0.03) !important;
    }

        tr.row-canceled > td:first-child {
            box-shadow: inset 4px 0 0 0 var(--color-canceled) !important;
        }

    .main-row, .excel-row {
        cursor: pointer;
    }

        .main-row:hover td:not(.row-completed td, .row-delivered td, .row-canceled td, .row-suspended td) {
            background-color: #f1f5f9;
        }

    .row-expanded > td {
        background-color: #f8fafc !important;
        border-bottom: 2px solid #cbd5e1 !important;
    }

    .chevron-box {
        color: #94a3b8;
        transition: transform 0.3s;
        font-size: 12px;
    }

    .row-expanded .chevron-box {
        transform: rotate(90deg);
        color: var(--primary);
    }

    .badge-status {
        padding: 5px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 11px;
        background: #fff;
        border: 1px solid var(--border);
        white-space: nowrap;
    }

    .progress-track {
        height: 6px;
        background: #e2e8f0;
        border-radius: 10px;
        margin-top: 6px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        border-radius: 10px;
        transition: width 0.4s ease;
    }

    .editable-cell {
        cursor: context-menu;
        border-bottom: 1px dashed #cbd5e1;
        display: inline-block;
        padding-bottom: 2px;
        transition: 0.2s;
    }

        .editable-cell:hover {
            border-bottom-color: var(--primary);
            color: var(--primary) !important;
            background-color: #fef9c3;
            border-radius: 4px;
            padding: 0 4px;
        }

    #quickEditMenu {
        display: none;
        position: absolute;
        z-index: 999999;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2);
        border: 1px solid var(--border);
        min-width: 220px;
        overflow: hidden;
    }

    .ctx-item {
        padding: 12px 16px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: 0.2s;
    }

        .ctx-item:hover {
            background: #f0f9ff;
            color: var(--primary);
            padding-left: 20px;
        }

    .ctx-header {
        background: #f8fafc;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        font-weight: 800;
        font-size: 11px;
        text-transform: uppercase;
        color: #64748b;
    }

    .sortable-col {
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .sortable-col:hover {
            color: var(--primary);
        }

    .sort-icon {
        font-size: 10px;
        opacity: 0.5;
    }

        .sort-icon.active {
            opacity: 1;
            color: var(--primary);
        }

    .detail-flex-container {
        display: flex;
        width: 100%;
        background: #f1f5f9;
        box-shadow: inset 0 3px 6px rgba(0,0,0,0.04);
        overflow: hidden;
        border-radius: 8px;
    }

    .panel-col {
        transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-right: 2px solid #e2e8f0;
        position: relative;
    }

        .panel-col:last-child {
            border-right: none;
        }

    .panel-prod:not(.collapsed-panel) {
        flex: 5 1 0%;
    }

    .panel-bom:not(.collapsed-panel) {
        flex: 4 1 0%;
    }

    .panel-inv:not(.collapsed-panel) {
        flex: 3 1 0%;
    }

    .panel-col.collapsed-panel {
        flex: 0 0 55px;
        background-color: #f8fafc;
        cursor: pointer;
    }

        .panel-col.collapsed-panel:hover {
            background-color: #e2e8f0;
        }

    .panel-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        min-width: 350px;
        transition: opacity 0.2s;
        padding: 15px;
    }

    .panel-prod .panel-inner {
        min-width: 450px;
    }

    .collapsed-panel .panel-inner {
        opacity: 0;
        pointer-events: none;
    }

    .vertical-title {
        position: absolute;
        top: 0;
        left: 0;
        width: 55px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 25px;
        color: #64748b;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: 1px;
        white-space: nowrap;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
    }

    .collapsed-panel .vertical-title {
        opacity: 1;
        pointer-events: auto;
    }

    .vertical-title i {
        transform: rotate(180deg);
        margin-bottom: 15px;
        font-size: 1.2rem;
    }

    .card-header-custom {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s;
        border-radius: 8px 8px 0 0;
    }

        .card-header-custom:hover {
            background-color: #f1f5f9 !important;
        }
</style>

<div id="topProgressBar"></div>

<div class="erp-layout-wrapper">
    <div class="erp-header-section">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <h3 class="fw-800 text-dark mb-1"><i class="fa-solid fa-layer-group text-primary me-2"></i>TRUNG TÂM ĐƠN HÀNG</h3>
                <div class="text-muted fw-600 small">
                    <span class="text-warning"><i class="fa-solid fa-mouse-pointer me-1"></i> Chuột phải vào ô đứt nét để sửa nhanh.</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (canEdit)
                {
                    <button type="button" class="btn btn-success rounded-pill px-3 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#importOrderModal"><i class="fa-solid fa-file-import me-1"></i> Import Excel</button>
                }
                @if (canCreate)
                {
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm"><i class="fa-solid fa-plus me-1"></i> Lên Đơn Mới</a>
                }
            </div>
        </div>

        <div class="erp-card mb-3" id="kpiContainer">
            <div class="row g-0">
                <div class="col-md-3"><div class="p-2 px-3 border-end"><div class="d-flex align-items-center gap-3"><div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 fs-5"><i class="fa-solid fa-clipboard-list"></i></div><div><div class="small fw-800 text-muted" style="font-size:10px;">TỔNG SỐ ĐƠN</div><div class="h5 fw-800 mb-0">@totalOrders</div></div></div></div></div>
                <div class="col-md-3"><div class="p-2 px-3 border-end"><div class="d-flex align-items-center gap-3"><div class="bg-warning bg-opacity-10 text-warning p-2 rounded-3 fs-5"><i class="fa-solid fa-hourglass-half"></i></div><div><div class="small fw-800 text-muted" style="font-size:10px;">CHỜ DUYỆT</div><div class="h5 fw-800 mb-0">@pendingCount</div></div></div></div></div>
                <div class="col-md-3"><div class="p-2 px-3 border-end"><div class="d-flex align-items-center gap-3"><div class="bg-info bg-opacity-10 text-info p-2 rounded-3 fs-5"><i class="fa-solid fa-gears"></i></div><div><div class="small fw-800 text-muted" style="font-size:10px;">ĐANG SẢN XUẤT</div><div class="h5 fw-800 mb-0">@productionCount</div></div></div></div></div>
                @if (canViewFinance)
                {
                    <div class="col-md-3"><div class="p-2 px-3"><div class="d-flex align-items-center gap-3"><div class="bg-success bg-opacity-10 text-success p-2 rounded-3 fs-5"><i class="fa-solid fa-sack-dollar"></i></div><div><div class="small fw-800 text-muted" style="font-size:10px;">DOANH THU LỌC</div><div class="h5 fw-800 text-success mb-0">@totalRevenue.ToString("N0") ₫</div></div></div></div></div>
                }
            </div>
        </div>

        <div class="erp-card shadow-sm mb-0 rounded-bottom-0">
            <div class="bg-light p-2 border-bottom">

                <form id="filterForm" asp-action="Index" method="get" class="row g-2 align-items-center m-0">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="sortOrder" id="sortOrder" value="@ViewBag.CurrentSort" />
                    <input type="hidden" name="viewMode" id="hdnViewMode" value="@viewMode" />
                    <input type="hidden" name="pageSize" id="hdnPageSize" value="@(ViewBag.PageSize ?? 30)" />

                    <input type="hidden" name="colCode" id="hdnColCode" value="@ViewBag.ColCode" />
                    <input type="hidden" name="colCustomer" id="hdnColCustomer" value="@ViewBag.ColCustomer" />
                    <input type="hidden" name="colProduct" id="hdnColProduct" value="@ViewBag.ColProduct" />
                    <input type="hidden" name="status" id="hdnStatus" value="@ViewBag.Status" />

                    <div class="col-md-3">
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-white text-muted fw-bold border-end-0"><i class="fa-regular fa-calendar-alt"></i></span>
                            <input type="text" id="filterFromDate" name="fromDate" class="form-control datepicker border-start-0 fw-bold text-primary px-1 text-center" placeholder="Từ ngày" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                            <span class="input-group-text bg-light text-muted border-start-0 border-end-0 px-1">-</span>
                            <input type="text" id="filterToDate" name="toDate" class="form-control datepicker border-start-0 fw-bold text-primary px-1 text-center" placeholder="Đến ngày" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select name="customerId" id="filterCustomerId" class="form-select form-select-sm shadow-sm fw-bold text-secondary">
                            <option value="">-- Khách hàng --</option>
                            @if (customerList != null)
                            {
                                foreach (var item in customerList)
                                {
                                    <option value="@item.Value" selected="@(ViewBag.CustomerId?.ToString() == item.Value ? "selected" : null)">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="fa-solid fa-barcode"></i></span>
                            <input type="text" class="form-control fw-bold border-start-0 sync-filter" data-field="hdnColCode" placeholder="Mã giấy / Mã HT / Khách..." value="@ViewBag.ColCode" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group input-group-sm shadow-sm">
                            <span class="input-group-text bg-primary text-white border-primary"><i class="fa-solid fa-box"></i></span>
                            <input type="text" class="form-control fw-bold border-primary sync-filter" data-field="hdnColProduct" placeholder="Nhập tên SP để lọc..." value="@ViewBag.ColProduct" autocomplete="off" />
                            <button type="button" class="btn btn-primary fw-bold px-3" onclick="submitFilterAjax(null, true)">LỌC</button>
                            <a asp-action="Index" class="btn btn-white border fw-bold px-2 text-danger" title="Xóa bộ lọc"><i class="fa-solid fa-xmark"></i></a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="d-flex justify-content-between align-items-center p-2 border-bottom bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="btn-group shadow-sm border rounded-pill p-1 bg-light">
                        <button type="button" class="btn btn-sm px-3 rounded-pill fw-bold @(viewMode == "list" ? "btn-dark" : "btn-light border-0 text-muted")" onclick="switchView('list')"><i class="fa-solid fa-list-check me-2"></i>Bảng</button>
                        <button type="button" class="btn btn-sm px-3 rounded-pill fw-bold @(viewMode == "grid" ? "btn-dark" : "btn-light border-0 text-muted")" onclick="switchView('grid')"><i class="fa-solid fa-file-excel me-2"></i>Lưới Excel</button>
                    </div>

                    @if (viewMode == "list")
                    {
                        <div class="form-check form-switch cursor-pointer mb-0 ms-2">
                            <input class="form-check-input cursor-pointer shadow-sm" type="checkbox" id="chkToggleAllDetails" onchange="toggleAllDetails(this)">
                            <label class="form-check-label small fw-bold text-dark cursor-pointer select-none" for="chkToggleAllDetails">Mở rộng tất cả chi tiết</label>
                        </div>
                    }
                    else
                    {
                        <div class="form-check form-switch cursor-pointer mb-0 ms-2">
                            <input class="form-check-input cursor-pointer shadow-sm" type="checkbox" id="chkGroupProduct" onchange="toggleGroupByProduct(this)">
                            <label class="form-check-label small fw-bold text-primary cursor-pointer select-none" for="chkGroupProduct"><i class="fa-solid fa-layer-group me-1"></i> Nhóm Sản phẩm</label>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2 align-items-center">
                    @if (canDelete)
                    {
                        <div id="bulkActionContainer" style="display: none;">
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-warning btn-sm rounded-pill px-3 fw-bold shadow-sm" type="button" data-bs-toggle="dropdown"><i class="fa-solid fa-pen-to-square me-1"></i> Đổi Trạng thái (<span id="bulkCount">0</span>) <i class="fa-solid fa-caret-down ms-1"></i></button>
                                <ul class="dropdown-menu shadow border-0" style="border-radius: 12px;">
                                    <li><h6 class="dropdown-header text-uppercase fw-bold">Chọn trạng thái:</h6></li>
                                    <li><a class="dropdown-item fw-bold text-warning" href="javascript:void(0)" onclick="executeBulkAction(@((int)OrderStatus.PendingApproval))">Chờ duyệt</a></li>
                                    <li><a class="dropdown-item fw-bold text-success" href="javascript:void(0)" onclick="executeBulkAction(@((int)OrderStatus.Approved))">Đã duyệt</a></li>
                                    <li><a class="dropdown-item fw-bold text-info" href="javascript:void(0)" onclick="executeBulkAction(@((int)OrderStatus.InProduction))">Đang Sản Xuất</a></li>
                                    <li><a class="dropdown-item fw-bold text-primary" href="javascript:void(0)" onclick="executeBulkAction(@((int)OrderStatus.Delivered))">Đã giao</a></li>
                                </ul>
                            </div>
                        </div>
                    }

                    <button type="button" class="btn btn-outline-secondary btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#colorConfigModal" title="Cấu hình màu sắc"><i class="fa-solid fa-palette"></i> TÙY CHỈNH MÀU</button>
                    @if (canEdit)
                    {
                        <a asp-action="BatchInvoice" class="btn btn-outline-info btn-sm fw-bold shadow-sm"><i class="fa-solid fa-file-invoice me-1"></i> Xuất HĐ Lô</a>
                    }
                    <button type="submit" form="filterForm" formaction="/Order/ExportExcel" class="btn btn-outline-success btn-sm fw-bold shadow-sm"><i class="fa-solid fa-download me-1"></i> Tải Excel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- VÙNG BẢNG DỮ LIỆU CHÍNH -->
    <div id="ajaxDataContainer" class="erp-body-section border-top-0 rounded-top-0 mb-0">
        <div class="table-scroll-container">
            <!-- ================= VIEW 1: DẠNG BẢNG CHUẨN ================= -->
            @if (viewMode == "list")
            {
                <table class="table-erp">
                    <thead>
                        <tr>
                            @if (canDelete)
                            {
                                <th width="30" class="text-center align-middle border-end"><input type="checkbox" class="form-check-input shadow-sm" id="cbAllList" onchange="toggleCheckAll(this)"></th>
                            }
                            <th width="30" class="text-center"></th>
                            <th style="min-width: 140px;"><div class="sortable-col" onclick="setSort('code')">MÃ ĐƠN GIẤY @Html.Raw(ViewBag.CurrentSort == "code_asc" ? "<i class='fa-solid fa-arrow-up-a-z sort-icon active'></i>" : ViewBag.CurrentSort == "code_desc" ? "<i class='fa-solid fa-arrow-down-z-a sort-icon active'></i>" : "<i class='fa-solid fa-sort sort-icon'></i>")</div></th>
                            <th style="min-width: 200px;"><div class="sortable-col" onclick="setSort('cus')">KHÁCH HÀNG @Html.Raw(ViewBag.CurrentSort == "cus_asc" ? "<i class='fa-solid fa-arrow-up-a-z sort-icon active'></i>" : ViewBag.CurrentSort == "cus_desc" ? "<i class='fa-solid fa-arrow-down-z-a sort-icon active'></i>" : "<i class='fa-solid fa-sort sort-icon'></i>")</div></th>
                            <th class="text-center" style="min-width: 130px;"><div class="sortable-col justify-content-center" onclick="setSort('date')">NGÀY NHẬN/GIAO @Html.Raw(ViewBag.CurrentSort == "date_asc" ? "<i class='fa-solid fa-sort-up sort-icon active'></i>" : ViewBag.CurrentSort == "date_desc" ? "<i class='fa-solid fa-sort-down sort-icon active'></i>" : "<i class='fa-solid fa-sort sort-icon'></i>")</div></th>
                            <th class="text-center">TIẾN ĐỘ X.KHO</th>
                            @if (canViewFinance)
                            {
                                <th class="text-end" style="min-width: 140px;"><div class="sortable-col justify-content-end" onclick="setSort('total')">THÀNH TIỀN / NỢ @Html.Raw(ViewBag.CurrentSort == "total_asc" ? "<i class='fa-solid fa-sort-up sort-icon active'></i>" : ViewBag.CurrentSort == "total_desc" ? "<i class='fa-solid fa-sort-down sort-icon active'></i>" : "<i class='fa-solid fa-sort sort-icon'></i>")</div></th>
                            }
                            @if (isShowingInvoiced)
                            {
                                <th class="text-center text-primary">NGÀY XUẤT HĐ</th>
                            }
                            <th class="text-center" style="min-width: 130px;">HÓA ĐƠN / THU</th>
                            <th class="text-center" style="min-width: 140px;">TRẠNG THÁI</th>
                            <th class="text-center pe-4"><i class="fa-solid fa-gears text-muted"></i></th>
                        </tr>
                        <tr class="filter-row">
                            @if (canDelete)
                            {
                                <th class="border-end bg-light"></th>
                            }
                            <th class="bg-light"></th>
                            <th class="bg-light"><input type="text" class="filter-input sync-filter" data-field="hdnColCode" value="@ViewBag.ColCode" placeholder="Mã giấy/Hệ thống..." autocomplete="off"></th>
                            <th class="bg-light"><input type="text" class="filter-input sync-filter" data-field="hdnColCustomer" value="@ViewBag.ColCustomer" placeholder="Tên khách..." autocomplete="off"></th>
                            <th class="bg-light"></th>
                            <th class="bg-light"></th>
                            @if (canViewFinance)
                            {
                                <th class="bg-light"></th>
                            }
                            @if (isShowingInvoiced)
                            {
                                <th class="bg-light"></th>
                            }
                            <th class="bg-light"></th>
                            <th class="bg-light">
                                <div class="dropdown">
                                    <button class="filter-input bg-white text-start d-flex justify-content-between align-items-center w-100" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                        <span class="status-filter-text text-truncate">@(string.IsNullOrEmpty(currentStatusStr) ? "-- Tất cả --" : $"Đã chọn ({currentStatusStr.Split(',').Length})")</span>
                                        <i class="fa-solid fa-caret-down text-muted"></i>
                                    </button>
                                    <ul class="dropdown-menu p-0 shadow-sm" style="min-width: 220px; border-radius: 8px; overflow: hidden;">
                                        <li class="p-2" style="max-height: 250px; overflow-y: auto;">
                                            @foreach (var stt in statusTranslations)
                                            {
                                                bool isChecked = !string.IsNullOrEmpty(currentStatusStr) && currentStatusStr.Split(',').Contains(((int)stt.Key).ToString());
                                                <label class="dropdown-item p-2 d-flex align-items-center cursor-pointer rounded hover-bg-light">
                                                    <input type="checkbox" class="form-check-input me-2 mt-0 sync-status" value="@((int)stt.Key)" @(isChecked ? "checked" : "")>
                                                    @stt.Value
                                                </label>
                                            }
                                        </li>
                                        <li class="p-2 border-top bg-light text-center">
                                            <button type="button" class="btn btn-primary btn-sm w-100 fw-bold" onclick="applyStatusFilter()">ÁP DỤNG LỌC</button>
                                        </li>
                                    </ul>
                                </div>
                            </th>
                            <th class="bg-light"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="@totalColumnsList" class="text-center py-5 text-muted fw-bold"><i class="fa-solid fa-box-open fa-3x mb-3 opacity-25 d-block"></i>Không tìm thấy dữ liệu.</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                var allItems = item.OrderDetails != null ? item.OrderDetails.ToList() : new List<OrderDetail>();

                                int salesQty = allItems.Where(x => !x.IsComponent).Sum(x => x.Quantity);
                                int shippableQty = 0; int shippedQty = 0;
                                var groups = allItems.GroupBy(x => string.IsNullOrEmpty(x.BundleCode) ? x.Id.ToString() : x.BundleCode).ToList();
                                foreach (var g in groups)
                                {
                                    var comps = g.Where(x => x.IsComponent).ToList();
                                    if (comps.Any())
                                    {
                                        shippableQty += comps.Sum(x => x.Quantity);
                                        shippedQty += comps.Sum(c => c.ShipmentDetails?.Sum(s => (int)s.QuantityShipped) ?? 0);
                                    }
                                    else
                                    {
                                        shippableQty += g.Sum(x => x.Quantity);
                                        shippedQty += g.Sum(c => c.ShipmentDetails?.Sum(s => (int)s.QuantityShipped) ?? 0);
                                    }
                                }

                                double shipPct = shippableQty > 0 ? ((double)shippedQty / shippableQty) * 100 : 0;
                                decimal paidAmount = paymentMap != null && paymentMap.ContainsKey(item.Id) ? paymentMap[item.Id] : 0;
                                decimal remainAmount = item.TotalAmount - paidAmount;
                                decimal billed = item.InvoiceDetails?.Sum(d => d.BilledAmount) ?? 0;
                                decimal remainToBill = item.TotalAmount - billed;
                                decimal billPct = item.TotalAmount > 0 ? (billed / item.TotalAmount) * 100 : 0;
                                var latestInvDate = item.InvoiceDetails?.OrderByDescending(d => d.Invoice.InvoiceDate).FirstOrDefault()?.Invoice.InvoiceDate;
                                string sttName = statusTranslations.ContainsKey(item.Status) ? statusTranslations[item.Status] : item.Status.ToString();

                                string rowHighlightClass = ""; string badgeColor = "text-secondary";
                                if (item.Status == OrderStatus.Completed) { rowHighlightClass = "row-completed"; badgeColor = "text-success"; }
                                else if (item.Status == OrderStatus.Delivered) { rowHighlightClass = "row-delivered"; badgeColor = "text-primary"; }
                                else if (item.Status == OrderStatus.Invoiced) { rowHighlightClass = "row-invoiced"; badgeColor = "text-dark"; }
                                else if (item.Status == OrderStatus.Canceled) { rowHighlightClass = "row-canceled"; badgeColor = "text-danger"; }
                                else if (item.Status == OrderStatus.PendingApproval) { rowHighlightClass = "row-suspended"; badgeColor = "text-warning"; }
                                else if (item.Status == OrderStatus.InProduction) badgeColor = "text-info";

                                string sttBadge = $"<span class='badge-status {badgeColor}'>{sttName}</span>";

                                <tr class="main-row @rowHighlightClass" data-order-id="@item.Id" onclick="toggleDetail(@item.Id, this)">
                                    @if (canDelete)
                                    {
                                        <td class="text-center border-end bg-light" onclick="event.stopPropagation();"><input type="checkbox" class="form-check-input order-cb shadow-sm" value="@item.Id" onchange="updateBulkUI()"></td>
                                    }
                                    <td class="text-center"><i class="fa-solid fa-chevron-right chevron-box"></i></td>

                                    <!-- ĐẢO MÃ GIẤY LÊN TRÊN, MÃ HỆ THỐNG XUỐNG DƯỚI -->
                                    <td>
                                        <div class="fw-800 font-monospace fs-6 mb-1 text-primary editable-cell" data-id="@item.Id" data-field="PaperOrderCode" data-value="@item.PaperOrderCode">@(string.IsNullOrEmpty(item.PaperOrderCode) ? "Chưa có mã giấy" : item.PaperOrderCode)</div>
                                        <div class="text-muted small font-monospace fw-normal opacity-75" title="Mã định danh hệ thống (Không bao giờ trùng)"><i class="fa-solid fa-barcode me-1"></i>@item.OrderCode</div>
                                    </td>

                                    <td><div class="editable-cell fw-bold text-dark text-truncate" style="max-width: 180px;" data-id="@item.Id" data-field="Customer" data-value="@item.CustomerId">@item.Customer?.CompanyName</div></td>
                                    <td class="text-center">
                                        <div class="editable-cell small fw-700 mb-1 text-dark" data-id="@item.Id" data-field="OrderDate" data-value="@item.OrderDate.ToString("yyyy-MM-dd")"><i class="fa-solid fa-calendar-plus text-muted me-1"></i> @item.OrderDate.ToString("dd/MM")</div><br />
                                        <div class="editable-cell small fw-700 @(item.DeliveryDeadline < DateTime.Now.Date && item.Status != OrderStatus.Completed ? "text-danger" : "text-muted")" data-id="@item.Id" data-field="DeliveryDeadline" data-value="@item.DeliveryDeadline?.ToString("yyyy-MM-dd")"><i class="fa-solid fa-clock me-1"></i> @(item.DeliveryDeadline?.ToString("dd/MM") ?? "-/-")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-between small fw-bold mb-1"><span class="text-dark">@shippedQty / @shippableQty</span><span class="text-primary">@shipPct.ToString("0")%</span></div>
                                        <div class="progress-track"><div class="progress-bar bg-primary" style="width: @shipPct%"></div></div>
                                    </td>
                                    @if (canViewFinance)
                                    {
                                        <td class="text-end">
                                            <div class="fw-800 text-dark fs-6 mb-1">Tổng: <span class="text-primary">@item.TotalAmount.ToString("N0")</span></div>
                                            @if (remainAmount > 0)
                                            {
                                                <div class="small text-danger fw-bold" style="font-size: 0.75rem;">Nợ: @remainAmount.ToString("N0")</div>
                                            }
                                            else
                                            {

                                                <div class="small text-success fw-bold" style="font-size: 0.75rem;"><i class="fa-solid fa-check-double me-1"></i> Đã thu đủ</div>
                                            }
                                        </td>
                                    }
                                    @if (isShowingInvoiced)
                                    {
                                        <td class="text-center fw-bold text-primary">@(latestInvDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    }
                                    <td class="align-middle" onclick="event.stopPropagation()">
                                        @if (billed > 0)
                                        {
                                            <div class="text-start mb-2" style="font-size: 0.8rem;">
                                                <div class="d-flex justify-content-between mb-1"><span class="text-muted">Đã xuất:</span><span class="fw-bold text-success">@billed.ToString("N0")</span></div>
                                                <div class="progress" style="height: 6px;" title="@billPct.ToString("0.0")%"><div class="progress-bar bg-success" role="progressbar" style="width: @billPct%;"></div></div>
                                            </div>
                                        }
                                        @if (remainToBill > 0)
                                        {
                                            <button onclick="openUploadModal(@item.Id, '@item.OrderCode', @remainToBill)" class="btn btn-sm btn-outline-primary py-1 px-2 w-100 shadow-sm" title="Up thêm HĐ mới"><i class="fa-solid fa-plus"></i> Hóa đơn</button>
                                        }
                                        else
                                        {

                                            <div class="text-center fw-bold text-success" style="font-size: 0.75rem;"><i class="fa-solid fa-check-circle"></i> Đã xuất 100%</div>
                                        }
                                    </td>
                                    <td class="text-center"><div class="editable-cell" data-id="@item.Id" data-field="Status" data-value="@((int)item.Status)">@Html.Raw(sttBadge)</div></td>
                                    <td class="text-center pe-4" onclick="event.stopPropagation()">
                                        <div class="d-flex justify-content-end align-items-center gap-1">
                                            @if (item.Status == OrderStatus.PendingApproval && canApprove)
                                            {
                                                <button class="btn btn-sm btn-success fw-bold py-1 px-2 shadow-sm" onclick="event.stopPropagation(); document.getElementById('form-approve-@item.Id').submit();" title="Duyệt Đơn"><i class="fa-solid fa-check text-white"></i></button>
                                                <form id="form-approve-@item.Id" asp-action="ApproveOrder" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /></form>
                                            }
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm border bg-white rounded-circle shadow-sm" style="width: 32px; height: 32px;" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 10px;">
                                                    <li><a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item py-2 fw-600"><i class="fa-solid fa-expand text-primary me-2"></i>Chi tiết Đơn</a></li>
                                                    <li><a asp-action="PrintOrder" asp-route-id="@item.Id" target="_blank" class="dropdown-item py-2 fw-600 text-dark"><i class="fa-solid fa-print text-secondary me-2"></i>In Hồ sơ A4</a></li>
                                                    @if (canEdit && !item.IsLocked)
                                                    {
                                                        <li><a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item py-2 fw-600"><i class="fa-solid fa-pen-to-square text-info me-2"></i>Sửa dữ liệu</a></li>
                                                    }
                                                    @if (canDelete)
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><a asp-action="Delete" asp-route-id="@item.Id" class="dropdown-item text-danger py-2 fw-bold" onclick="return confirm('Xác nhận Xóa?')"><i class="fa-solid fa-trash-can me-2"></i>Xóa Đơn</a></li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <!-- EXPAND ROW -->
                                <tr id="detail-@item.Id" class="detail-row" style="display: none;">
                                    <td colspan="@totalColumnsList" class="p-0 border-bottom-0">
                                        <div class="detail-flex-container">

                                            <div class="panel-col panel-prod" id="panel-prod-@item.Id">
                                                <div class="vertical-title" onclick="toggleHorizontalPanel('panel-prod-@item.Id')"><i class="fa-solid fa-boxes-packing text-primary"></i> SẢN PHẨM</div>
                                                <div class="panel-inner">
                                                    <div class="card border-0 shadow-sm h-100">
                                                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between card-header-custom" onclick="toggleHorizontalPanel('panel-prod-@item.Id')">
                                                            <div class="d-flex align-items-center"><i class="fa-solid fa-boxes-packing text-primary me-2"></i><h6 class="m-0 fw-bold text-dark d-inline">SẢN PHẨM CẦN GIAO</h6></div>
                                                            <i class="fa-solid fa-chevron-right text-muted icon-collapse"></i>
                                                        </div>
                                                        <div class="table-responsive flex-grow-1">
                                                            <table class="table table-hover table-sm mb-0">
                                                                <thead class="bg-light text-muted" style="font-size: 0.8rem;">
                                                                    <tr>
                                                                        <th class="ps-4 py-2 text-uppercase">Tên Sản Phẩm / Chi tiết con</th>
                                                                        <th class="text-center py-2 text-uppercase" width="90">SL Đặt</th>
                                                                        <th class="text-center text-success py-2 text-uppercase" width="90">Đã Giao</th>
                                                                        <th class="text-center text-danger py-2 text-uppercase pe-3" width="90">Còn Thiếu</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var group in groups)
                                                                    {
                                                                        var parent = group.FirstOrDefault(x => !x.IsComponent);
                                                                        var children = group.Where(x => x.IsComponent).ToList();

                                                                        if (parent != null)
                                                                        {
                                                                            int pShipped = parent.ShipmentDetails?.Sum(s => (int)s.QuantityShipped) ?? 0;
                                                                            <tr class="bg-light border-top">
                                                                                <td class="ps-4"><div class="fw-bold text-dark fs-6">@parent.ProductName</div><div class="small text-muted fw-normal fst-italic">@parent.Specifications</div></td>
                                                                                <td class="text-center fw-bold text-primary align-middle fs-6">@parent.Quantity</td>
                                                                                <td class="text-center fw-bold text-success align-middle">@(children.Any() ? "-" : pShipped.ToString())</td>
                                                                                <td class="text-center fw-bold text-danger align-middle pe-3">@(children.Any() ? "-" : (parent.Quantity - pShipped).ToString())</td>
                                                                            </tr>
                                                                        }
                                                                        foreach (var child in children)
                                                                        {
                                                                            int cShipped = child.ShipmentDetails?.Sum(s => (int)s.QuantityShipped) ?? 0;
                                                                            <tr>
                                                                                <td class="ps-5"><div class="fw-600 text-muted"><i class="fa-solid fa-arrow-turn-up fa-rotate-90 text-warning me-2"></i> @child.ProductName</div><div class="small text-muted fw-normal ms-4">@child.Specifications</div></td>
                                                                                <td class="text-center text-muted align-middle">@child.Quantity</td>
                                                                                <td class="text-center text-success fw-bold align-middle">@cShipped</td>
                                                                                <td class="text-center text-danger fw-bold align-middle pe-3">@(child.Quantity - cShipped)</td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="panel-col panel-bom" id="panel-bom-@item.Id">
                                                <div class="vertical-title" onclick="toggleHorizontalPanel('panel-bom-@item.Id')"><i class="fa-solid fa-calculator text-info"></i> VẬT TƯ</div>
                                                <div class="panel-inner">
                                                    <div class="card border-0 shadow-sm h-100">
                                                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center card-header-custom" onclick="toggleHorizontalPanel('panel-bom-@item.Id')">
                                                            <div class="d-flex align-items-center"><i class="fa-solid fa-calculator text-info me-2"></i><h6 class="m-0 fw-bold text-dark d-inline">VẬT TƯ GỐC (BOM)</h6></div>
                                                            <div class="d-flex align-items-center gap-2"><button type="button" class="btn btn-sm btn-outline-info py-0 px-2 rounded-pill fw-bold" onclick="event.stopPropagation(); loadBomInline(@item.Id)"><i class="fa-solid fa-rotate-right me-1"></i> Tải lại</button><i class="fa-solid fa-chevron-right text-muted icon-collapse"></i></div>
                                                        </div>
                                                        <div class="flex-grow-1 p-0" id="bom-container-@item.Id"><div class="p-4 text-center text-muted"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>Đang bóc tách dữ liệu...</div></div></div>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (canViewFinance)
                                            {
                                                <div class="panel-col panel-inv" id="panel-inv-@item.Id">
                                                    <div class="vertical-title" onclick="toggleHorizontalPanel('panel-inv-@item.Id')"><i class="fa-solid fa-file-invoice-dollar text-success"></i> HÓA ĐƠN</div>
                                                    <div class="panel-inner">
                                                        <div class="card border-0 shadow-sm h-100">
                                                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center card-header-custom" onclick="toggleHorizontalPanel('panel-inv-@item.Id')">
                                                                <div class="d-flex align-items-center"><i class="fa-solid fa-file-invoice-dollar text-success me-2"></i><h6 class="m-0 fw-bold text-dark d-inline">HÓA ĐƠN</h6></div>
                                                                <div class="d-flex align-items-center gap-2"><span class="badge bg-success bg-opacity-10 text-success border border-success">@((item.InvoiceDetails?.Count ?? 0)) đợt</span><i class="fa-solid fa-chevron-right text-muted icon-collapse"></i></div>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <div class="p-2 bg-light border-bottom text-center" style="font-size: 0.85rem;">
                                                                    <div class="d-flex justify-content-between px-2"><span class="text-muted">Giá trị Đơn:</span><span class="fw-bold text-dark">@item.TotalAmount.ToString("N0")</span></div>
                                                                    <div class="d-flex justify-content-between px-2 mt-1 border-top pt-1"><span class="text-muted fw-bold">Chưa xuất HĐ:</span><span class="fw-bold text-danger">@remainToBill.ToString("N0")</span></div>
                                                                </div>
                                                                <div class="table-responsive" style="max-height: 200px;">
                                                                    <table class="table table-hover table-borderless mb-0 small align-middle">
                                                                        <tbody>
                                                                            @if (item.InvoiceDetails != null && item.InvoiceDetails.Any())
                                                                            {
                                                                                foreach (var detail in item.InvoiceDetails.OrderByDescending(x => x.Invoice.InvoiceDate))
                                                                                {
                                                                                    <tr class="border-bottom border-light">
                                                                                        <td class="ps-3"><div class="fw-bold text-dark font-monospace" style="font-size: 0.85rem;">@detail.Invoice.InvoiceNumber</div><div class="text-muted mt-1" style="font-size:0.75rem;"><i class="fa-solid fa-calendar-check me-1"></i> @detail.Invoice.InvoiceDate.ToString("dd/MM/yyyy")</div></td>
                                                                                        <td class="text-end pe-3">
                                                                                            <div class="fw-bold text-success mb-1">@detail.BilledAmount.ToString("N0") đ</div>
                                                                                            <div class="btn-group shadow-sm">
                                                                                                @if (!string.IsNullOrEmpty(detail.Invoice.InvoiceFile))
                                                                                                {
                                                                                                    <a href="~/invoices/@detail.Invoice.InvoiceFile" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2" title="Tải PDF"><i class="fa-solid fa-file-pdf"></i></a>
                                                                                                }
                                                                                                <button onclick="openEditInvoiceModal(@detail.Id, '@(detail.Invoice.InvoiceNumber ?? "")', '@detail.Invoice.InvoiceDate.ToString("yyyy-MM-dd")', @detail.BilledAmount.ToString(System.Globalization.CultureInfo.InvariantCulture), @((detail.BilledAmount + remainToBill).ToString(System.Globalization.CultureInfo.InvariantCulture)))" class="btn btn-sm btn-outline-warning py-0 px-2" title="Sửa Hóa đơn"><i class="fa-solid fa-pen"></i></button>
                                                                                                <button onclick="deleteInvoice(@detail.Id)" class="btn btn-sm btn-outline-danger py-0 px-2" title="Xóa Hóa đơn"><i class="fa-solid fa-trash"></i></button>
                                                                                            </div>
                                                                                        </td>
                                                                                    </tr>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <tr><td class="text-center py-4 text-muted fst-italic"><i class="fa-solid fa-folder-open mb-2 opacity-50 fa-2x"></i><br /> Chưa xuất hóa đơn.</td></tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- ================= VIEW 2: DẠNG LƯỚI EXCEL ================= -->
            @if (viewMode == "grid")
            {
                <table class="table table-hover table-excel bg-white m-0" id="gridTable">
                    <thead>
                        <tr>
                            @if (canDelete)
                            {
                                <th width="30" class="text-center align-middle border-end bg-light"><input type="checkbox" class="form-check-input shadow-sm" id="cbAllGrid" onchange="toggleCheckAll(this)"></th>
                            }
                            <th class="text-center" width="40">STT</th>
                            <th>Mã Đơn Giấy / Hệ thống</th>
                            <th>Khách Hàng</th>
                            <th>Tên Sản Phẩm / Chi tiết</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-center text-success">Đã Giao</th>
                            <th class="text-center text-danger">Còn Thiếu</th>
                            @if (canViewFinance)
                            {
                                <th class="text-end">Đơn Giá</th>
                                <th class="text-end">Thành Tiền</th>
                            }
                            <th class="text-center">Ngày Đặt</th>
                            <th class="text-center">Hạn Giao</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center"><i class="fa-solid fa-gears text-muted"></i> Thao tác</th>
                        </tr>
                        <tr class="filter-row">
                            @if (canDelete)
                            {
                                <th class="border-end bg-light"></th>
                            }
                            <th class="bg-light"></th>
                            <th class="bg-light"><input type="text" class="filter-input sync-filter" data-field="hdnColCode" value="@ViewBag.ColCode" placeholder="Mã..." autocomplete="off"></th>
                            <th class="bg-light"><input type="text" class="filter-input sync-filter" data-field="hdnColCustomer" value="@ViewBag.ColCustomer" placeholder="Tên khách..." autocomplete="off"></th>
                            <th class="bg-light"><input type="text" class="filter-input sync-filter" data-field="hdnColProduct" value="@ViewBag.ColProduct" placeholder="Sản phẩm..." autocomplete="off"></th>
                            <th class="bg-light"></th>
                            <th class="bg-light"></th>
                            <th class="bg-light"></th>
                            @if (canViewFinance)
                            {
                                <th class="bg-light"></th>
                                <th class="bg-light"></th>
                            }
                            <th class="bg-light"></th>
                            <th class="bg-light"></th>
                            <th class="bg-light">
                                <div class="dropdown">
                                    <button class="filter-input bg-white text-start d-flex justify-content-between align-items-center w-100" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                        <span class="status-filter-text text-truncate">@(string.IsNullOrEmpty(currentStatusStr) ? "-- Tất cả --" : $"Đã chọn ({currentStatusStr.Split(',').Length})")</span>
                                        <i class="fa-solid fa-caret-down text-muted"></i>
                                    </button>
                                    <ul class="dropdown-menu p-0 shadow-sm" style="min-width: 220px; border-radius: 8px; overflow: hidden;">
                                        <li class="p-2" style="max-height: 250px; overflow-y: auto;">
                                            @foreach (var stt in statusTranslations)
                                            {
                                                bool isChecked = !string.IsNullOrEmpty(currentStatusStr) && currentStatusStr.Split(',').Contains(((int)stt.Key).ToString());
                                                <label class="dropdown-item p-2 d-flex align-items-center cursor-pointer rounded hover-bg-light">
                                                    <input type="checkbox" class="form-check-input me-2 mt-0 sync-status" value="@((int)stt.Key)" @(isChecked ? "checked" : "")>
                                                    @stt.Value
                                                </label>
                                            }
                                        </li>
                                        <li class="p-2 border-top bg-light text-center">
                                            <button type="button" class="btn btn-primary btn-sm w-100 fw-bold" onclick="applyStatusFilter()">ÁP DỤNG LỌC</button>
                                        </li>
                                    </ul>
                                </div>
                            </th>
                            <th class="bg-light"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="100%" class="text-center py-5 text-muted fw-bold">Không tìm thấy dữ liệu.</td></tr>
                        }
                        else
                        {
                            int sttExcel = 1;
                            foreach (var order in Model)
                            {
                                string sttNameGrid = statusTranslations.ContainsKey(order.Status) ? statusTranslations[order.Status] : order.Status.ToString();
                                string rowHighlightClass = ""; string badgeColor = "text-secondary";
                                if (order.Status == OrderStatus.Completed) { rowHighlightClass = "row-completed"; badgeColor = "text-success"; }
                                else if (order.Status == OrderStatus.Delivered) { rowHighlightClass = "row-delivered"; badgeColor = "text-primary"; }
                                else if (order.Status == OrderStatus.Invoiced) { rowHighlightClass = "row-invoiced"; badgeColor = "text-dark"; }
                                else if (order.Status == OrderStatus.Canceled) { rowHighlightClass = "row-canceled"; badgeColor = "text-danger"; }
                                else if (order.Status == OrderStatus.PendingApproval) { rowHighlightClass = "row-suspended"; badgeColor = "text-warning"; }
                                else if (order.Status == OrderStatus.InProduction) badgeColor = "text-info";
                                string sttBadge = $"<span class='badge-status {badgeColor}'>{sttNameGrid}</span>";

                                var allItems = order.OrderDetails != null ? order.OrderDetails.ToList() : new List<OrderDetail>();

                                if (allItems.Any())
                                {
                                    foreach (var d in allItems.OrderBy(x => x.BundleCode).ThenBy(x => x.IsComponent))
                                    {
                                        int shippedDetailQty = d.ShipmentDetails != null ? d.ShipmentDetails.Sum(sd => (int)sd.QuantityShipped) : 0;
                                        int missingDetailQty = (int)d.Quantity - shippedDetailQty;

                                        <tr class="excel-row @rowHighlightClass @(!d.IsComponent ? "bg-light border-top" : "")">
                                            @if (canDelete)
                                            {
                                                <td class="text-center border-end" onclick="event.stopPropagation();"><input type="checkbox" class="form-check-input order-cb shadow-sm" value="@order.Id" onchange="updateBulkUI()"></td>
                                            }
                                            <td class="text-center text-muted fw-bold">@(sttExcel++)</td>

                                            <!-- ĐẢO MÃ GIẤY LÊN TRÊN, MÃ HỆ THỐNG XUỐNG DƯỚI (DẠNG GRID) -->
                                            <td class="fw-bold font-monospace text-dark">
                                                <div class="editable-cell text-primary mb-1" data-id="@order.Id" data-field="PaperOrderCode" data-value="@order.PaperOrderCode">@(string.IsNullOrEmpty(order.PaperOrderCode) ? "N/A" : order.PaperOrderCode)</div>
                                                <div class="text-muted small font-monospace fw-normal opacity-75">@order.OrderCode</div>
                                            </td>

                                            <td class="fw-600 text-dark">
                                                <div class="editable-cell" data-id="@order.Id" data-field="Customer" data-value="@order.CustomerId">@order.Customer?.CompanyName</div>
                                            </td>
                                            <td class="col-product">
                                                <div class="fw-bold product-name-cell @(d.IsComponent ? "text-muted ms-3 fst-italic" : "text-primary")">@(d.IsComponent ? "↳ " : "")@d.ProductName</div>
                                                @if (!string.IsNullOrEmpty(d.Specifications))
                                                {
                                                    <div class="small text-muted fst-italic @(d.IsComponent ? "ms-4" : "")">@d.Specifications</div>
                                                }
                                            </td>
                                            <td class="text-center fw-800 text-dark fs-6 col-qty">@d.Quantity</td>
                                            <td class="text-center fw-bold text-success col-shipped">@shippedDetailQty</td>
                                            <td class="text-center fw-bold text-danger col-missing">@missingDetailQty</td>
                                            @if (canViewFinance)
                                            {
                                                <td class="text-end fw-600 text-muted">@(d.IsComponent ? "-" : d.UnitPrice.ToString("N0"))</td>
                                                <td class="text-end fw-bold text-success">@(d.IsComponent ? "-" : ((d.Quantity * d.UnitPrice).ToString("N0")))</td>
                                            }
                                            <td class="text-center fw-600 text-muted">
                                                <div class="editable-cell" data-id="@order.Id" data-field="OrderDate" data-value="@order.OrderDate.ToString("yyyy-MM-dd")">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                            </td>
                                            <td class="text-center fw-bold text-danger">
                                                <div class="editable-cell" data-id="@order.Id" data-field="DeliveryDeadline" data-value="@order.DeliveryDeadline?.ToString("yyyy-MM-dd")">@(order.DeliveryDeadline?.ToString("dd/MM/yyyy") ?? "-")</div>
                                            </td>
                                            <td class="text-center">
                                                <div class="editable-cell" data-id="@order.Id" data-field="Status" data-value="@((int)order.Status)">@Html.Raw(sttBadge)</div>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group shadow-sm">
                                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-light border text-primary fw-bold" title="Xem Chi tiết"><i class="fa-solid fa-expand"></i></a>
                                                    <button type="button" onclick="viewBom(@order.Id); event.stopPropagation();" class="btn btn-sm btn-light border text-success fw-bold" title="Vật tư"><i class="fa-solid fa-calculator"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- PHÂN TRANG CỐ ĐỊNH PHÍA DƯỚI -->
        <div id="paginationContainer" class="p-2 px-3 bg-light d-flex justify-content-between align-items-center flex-wrap gap-3 border-top flex-shrink-0">
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted fw-bold small">Trang @Model.PageNumber / @Model.PageCount</span>
                <select class="form-select form-select-sm fw-bold text-primary shadow-sm" style="width: 120px;" form="filterForm" id="filterPageSize" onchange="document.getElementById('hdnPageSize').value = this.value; submitFilterAjax(null, true);">
                    <option value="15" selected="@(ViewBag.PageSize == 15 ? "selected" : null)">15 dòng</option>
                    <option value="30" selected="@(ViewBag.PageSize == 30 || ViewBag.PageSize == null ? "selected" : null)">30 dòng</option>
                    <option value="50" selected="@(ViewBag.PageSize == 50 ? "selected" : null)">50 dòng</option>
                </select>
            </div>
            <div class="pagination-sm m-0">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, sortOrder = ViewBag.CurrentSort, colCode = ViewBag.ColCode, colCustomer = ViewBag.ColCustomer, colProduct = ViewBag.ColProduct, viewMode = ViewBag.ViewMode, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, status = ViewBag.Status, customerId = ViewBag.CustomerId, pageSize = ViewBag.PageSize }), new PagedListRenderOptions { LiElementClasses = new string[] { "page-item" }, PageClasses = new string[] { "page-link shadow-sm fw-bold text-primary ajax-page" }, DisplayLinkToPreviousPage = PagedListDisplayMode.Always, DisplayLinkToNextPage = PagedListDisplayMode.Always })
            </div>
        </div>
    </div>
</div>

<!-- ================= MODALS & MENU CHUỘT PHẢI ================= -->
<div class="modal fade" id="importOrderModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow-lg rounded-4"><div class="modal-header bg-success text-white border-0"><h6 class="modal-title fw-bold"><i class="fa-solid fa-file-excel me-2"></i> Nhập Đơn hàng từ Excel</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><form asp-action="PreviewImport" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="modal-body bg-light p-4"><input type="file" name="file" class="form-control bg-white shadow-sm" accept=".xlsx, .xls" required></div><div class="modal-footer border-0 bg-light"><button type="button" class="btn btn-light fw-bold border" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-success fw-bold px-4">Xem Preview</button></div></form></div></div></div>
<div class="modal fade" id="uploadModal" tabindex="-1"><div class="modal-dialog modal-sm modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-light"><h6 class="modal-title fw-bold text-dark"><i class="fa-solid fa-file-invoice text-primary me-2"></i>Xuất Hóa đơn mới</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="frmUpload" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" id="hdOrderId" name="id" /><div class="mb-3"><label class="small fw-bold text-muted mb-1">Số hóa đơn</label><input type="text" name="invoiceNumber" id="txtInvoiceNumber" class="form-control fw-bold" required /></div><div class="mb-3"><label class="small fw-bold text-muted mb-1">Ngày xuất HĐ</label><input type="text" name="invoiceDate" id="txtInvoiceDate" class="form-control datepicker" required /></div><div class="mb-3"><label class="small fw-bold text-muted mb-1">Số tiền xuất <span class="text-danger">*</span></label><div class="input-group"><input type="number" id="billedAmount" name="billedAmount" class="form-control fw-bold text-success" required min="1"><span class="input-group-text fw-bold">VNĐ</span></div><small class="text-muted mt-1 d-block" id="billedAmountHint"></small></div><div class="mb-4"><label class="small fw-bold text-muted mb-1">File đính kèm</label><input type="file" name="invoiceFile" class="form-control form-control-sm" accept=".pdf,.jpg,.png,.jpeg" /></div><button type="button" onclick="submitUpload()" class="btn btn-primary w-100 fw-bold shadow-sm py-2"><i class="fa-solid fa-floppy-disk me-1"></i> LƯU</button></form></div></div></div></div>

<div class="modal fade" id="editInvoiceModal" tabindex="-1"><div class="modal-dialog modal-sm modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-light"><h6 class="modal-title fw-bold text-warning"><i class="fa-solid fa-pen-to-square me-2"></i>Sửa Hóa đơn</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="frmEditInvoice" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="hidden" id="editDetailId" name="detailId" /><div class="mb-3"><label class="small fw-bold text-muted mb-1">Số hóa đơn</label><input type="text" name="invoiceNumber" id="editInvoiceNumber" class="form-control fw-bold" required /></div><div class="mb-3"><label class="small fw-bold text-muted mb-1">Ngày xuất HĐ</label><input type="text" name="invoiceDate" id="editInvoiceDate" class="form-control datepicker" required /></div><div class="mb-3"><label class="small fw-bold text-muted mb-1">Sửa số tiền xuất HĐ <span class="text-danger">*</span></label><div class="input-group"><input type="number" id="editBilledAmount" name="billedAmount" class="form-control fw-bold text-warning" required min="1"><span class="input-group-text fw-bold">VNĐ</span></div><small class="text-muted mt-1 d-block" id="editBilledAmountHint"></small></div><div class="mb-4"><label class="small fw-bold text-muted mb-1">Up đè File mới (Để trống nếu giữ cũ)</label><input type="file" name="invoiceFile" class="form-control form-control-sm" accept=".pdf,.jpg,.png,.jpeg" /></div><button type="button" onclick="submitEditInvoice()" class="btn btn-warning text-dark w-100 fw-bold shadow-sm py-2"><i class="fa-solid fa-floppy-disk me-1"></i> CẬP NHẬT</button></form></div></div></div></div>

<!-- MODAL CẤU HÌNH MÀU SẮC -->
<div class="modal fade" id="colorConfigModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h6 class="modal-title fw-bold text-dark"><i class="fa-solid fa-palette text-primary me-2"></i>Cấu hình màu trạng thái</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <label class="fw-bold small text-muted">Chờ duyệt</label>
                    <input type="color" id="cpPending" class="form-control form-control-color border-0 p-0 shadow-sm" style="width:40px; height:30px;" value="#f59e0b">
                </div>
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <label class="fw-bold small text-muted">Đã giao</label>
                    <input type="color" id="cpDelivered" class="form-control form-control-color border-0 p-0 shadow-sm" style="width:40px; height:30px;" value="#0ea5e9">
                </div>
                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <label class="fw-bold small text-muted">Hoàn thành</label>
                    <input type="color" id="cpCompleted" class="form-control form-control-color border-0 p-0 shadow-sm" style="width:40px; height:30px;" value="#10b981">
                </div>
                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <label class="fw-bold small text-muted">Bị hủy</label>
                    <input type="color" id="cpCanceled" class="form-control form-control-color border-0 p-0 shadow-sm" style="width:40px; height:30px;" value="#ef4444">
                </div>
                <button type="button" onclick="saveColorConfig()" class="btn btn-primary w-100 fw-bold shadow-sm py-2"><i class="fa-solid fa-save me-1"></i> LƯU MÀU NỀN</button>
                <button type="button" onclick="resetColorConfig()" class="btn btn-light w-100 fw-bold shadow-sm py-2 mt-2 border text-muted"><i class="fa-solid fa-rotate-left me-1"></i> Trở về mặc định</button>
            </div>
        </div>
    </div>
</div>

<div id="quickEditMenu">
    <div class="ctx-header"><i class="fa-solid fa-bolt text-warning me-2"></i>SỬA NHANH</div>
    <div class="ctx-item" id="btnQuickEditAction"><i class="fa-solid fa-pen-to-square text-primary me-3"></i> Cập nhật ô này</div>
    <div class="ctx-item text-danger" onclick="document.getElementById('quickEditMenu').style.display='none'"><i class="fa-solid fa-xmark me-3"></i> Hủy</div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>

    <script>
        // =====================================
        // 🔥 BẢO MẬT & SETUP GLOBAL AJAX
        // =====================================
        $(document).ready(function() {
            var token = $('input[name="__RequestVerificationToken"]').val();
            if (token) { $.ajaxSetup({ headers: { 'RequestVerificationToken': token } }); }
        });

        // =====================================
        // 🔥 MÀU SẮC LOCAL STORAGE & COLOR-MIX
        // =====================================
        function loadColorConfig() {
            const pending = localStorage.getItem('color_pending') || '#f59e0b';
            const delivered = localStorage.getItem('color_delivered') || '#0ea5e9';
            const completed = localStorage.getItem('color_completed') || '#10b981';
            const canceled = localStorage.getItem('color_canceled') || '#ef4444';

            document.documentElement.style.setProperty('--color-pending', pending);
            document.documentElement.style.setProperty('--color-delivered', delivered);
            document.documentElement.style.setProperty('--color-completed', completed);
            document.documentElement.style.setProperty('--color-canceled', canceled);

            document.getElementById('cpPending').value = pending;
            document.getElementById('cpDelivered').value = delivered;
            document.getElementById('cpCompleted').value = completed;
            document.getElementById('cpCanceled').value = canceled;
        }

        function saveColorConfig() {
            localStorage.setItem('color_pending', document.getElementById('cpPending').value);
            localStorage.setItem('color_delivered', document.getElementById('cpDelivered').value);
            localStorage.setItem('color_completed', document.getElementById('cpCompleted').value);
            localStorage.setItem('color_canceled', document.getElementById('cpCanceled').value);

            loadColorConfig();
            $('#colorConfigModal').modal('hide');
            Swal.fire({ icon: 'success', title: 'Đã cập nhật màu sắc!', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500 });
        }

        function resetColorConfig() {
            localStorage.removeItem('color_pending'); localStorage.removeItem('color_delivered'); localStorage.removeItem('color_completed'); localStorage.removeItem('color_canceled');
            loadColorConfig(); $('#colorConfigModal').modal('hide');
            Swal.fire({ icon: 'info', title: 'Đã về màu mặc định!', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500 });
        }

        // =====================================
        // 1. BULK ACTIONS & EXCEL GROUPING
        // =====================================
        function toggleCheckAll(source) { $('.order-cb').prop('checked', source.checked); updateBulkUI(); }
        function updateBulkUI() {
            let count = $('.order-cb:checked').length;
            if (count > 0) { $('#bulkCount').text(count); $('#bulkActionContainer').fadeIn(200); }
            else { $('#bulkActionContainer').fadeOut(200); $('#cbAllList, #cbAllGrid').prop('checked', false); }
        }

        function executeBulkAction(newStatus) {
            let ids = []; $('.order-cb:checked').each(function() { ids.push($(this).val()); });
            if (ids.length === 0) return;
            Swal.fire({
                title: 'Xác nhận đổi trạng thái?', text: `Đổi trạng thái cho ${ids.length} đơn hàng đã chọn?`, icon: 'question',
                showCancelButton: true, confirmButtonText: 'Đồng ý', confirmButtonColor: '#0ea5e9'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Order/BulkUpdateStatus', { ids: ids.join(','), newStatus: newStatus }, function(res) {
                        if (res.success) { Swal.fire({ icon: 'success', title: 'Thành công!', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500 }); updateBulkUI(); submitFilterAjax(null, true); }
                        else { Swal.fire('Lỗi', res.message, 'error'); }
                    });
                }
            });
        }

        function toggleGroupByProduct(checkbox) {
            const isGrouped = checkbox.checked; const $tbody = $('#gridTable tbody'); const $rows = $tbody.find('tr.excel-row');
            if (isGrouped) {
                $('#paginationContainer').slideUp(200); let groups = {};
                $rows.each(function() {
                    let $r = $(this); let product = $r.find('.product-name-cell').text().replace("↳", "").trim();
                    if (!product) product = "Đơn lẻ/Khác";
                    if (!groups[product]) groups[product] = []; groups[product].push($r);
                });
                $rows.hide(); $('.group-header-row, .grouped-child').remove();
                for (let prod in groups) {
                    let qtySum = 0, shippedSum = 0, missingSum = 0;
                    groups[prod].forEach($r => {
                        qtySum += parseFloat($r.find('.col-qty').text().replace(/,/g, '')) || 0;
                        shippedSum += parseFloat($r.find('.col-shipped').text().replace(/,/g, '')) || 0;
                        missingSum += parseFloat($r.find('.col-missing').text().replace(/,/g, '')) || 0;
                    });
                    $tbody.append(`<tr class="group-header-row bg-light" style="cursor:pointer; border-bottom: 2px solid #cbd5e1;" onclick="$(this).nextUntil('.group-header-row').toggle()"><td colspan="5" class="fw-800 text-dark fs-6"><i class="fa-solid fa-folder-open me-2 text-warning"></i>${prod} <span class="badge bg-secondary ms-2">${groups[prod].length} dòng</span></td><td class="text-center fw-800 text-dark fs-6">${qtySum}</td><td class="text-center fw-bold text-success">${shippedSum}</td><td class="text-center fw-bold text-danger">${missingSum}</td><td colspan="5"></td></tr>`);
                    groups[prod].forEach($r => { $tbody.append($r.clone().show().addClass('grouped-child').removeClass('excel-row')); });
                }
            } else { $('#paginationContainer').slideDown(200); $('.group-header-row, .grouped-child').remove(); $rows.show(); }
        }

        // =====================================
        // 2. AJAX FILTER PROXY ĐỒNG BỘ
        // =====================================

        $(document).on('input', '.sync-filter', function() {
            let fieldId = $(this).data('field');
            let val = $(this).val();
            $('#' + fieldId).val(val);
            $(`.sync-filter[data-field="${fieldId}"]`).not(this).val(val);
        });

        $(document).on('keypress', '.sync-filter', function(e) {
            if (e.which == 13) { e.preventDefault(); submitFilterAjax(null, true); }
        });

        $(document).on('change', '.sync-status', function() {
            let selected = [];
            let $dropdown = $(this).closest('.dropdown-menu');
            $dropdown.find('.sync-status:checked').each(function() { selected.push($(this).val()); });

            $('#hdnStatus').val(selected.join(','));

            $('.sync-status').prop('checked', false);
            selected.forEach(val => { $(`.sync-status[value="${val}"]`).prop('checked', true); });

            let text = selected.length > 0 ? `Đã chọn (${selected.length})` : '-- Tất cả --';
            $('.status-filter-text').text(text);
        });

        function applyStatusFilter() { submitFilterAjax(null, true); $('[data-bs-toggle="dropdown"]').dropdown('hide'); }

        $(document).on('change', 'select[name="customerId"], input[name="fromDate"], input[name="toDate"]', function() { submitFilterAjax(null, true); });
        $(document).on('click', '.ajax-page', function(e) { e.preventDefault(); let url = $(this).attr('href'); if (url) submitFilterAjax(url, true); });

        $('#filterForm').on('keydown', function(e) { if (e.keyCode === 13) { e.preventDefault(); return false; } });
        $('#filterForm').on('submit', function(e) { if (e.originalEvent && e.originalEvent.submitter && e.originalEvent.submitter.formAction && e.originalEvent.submitter.formAction.includes("ExportExcel")) { return true; } e.preventDefault(); submitFilterAjax(null, true); });

        window.addEventListener('popstate', function(event) { window.location.reload(); });

        function submitFilterAjax(urlOverride = null, isPushState = false) {
            let formEl = document.getElementById('filterForm');
            let formData = new FormData(formEl);
            let params = new URLSearchParams(formData);

            let activeEl = document.activeElement;
            let activeDataField = activeEl ? activeEl.getAttribute('data-field') : null;
            let cursorStart = 0;
            if (activeEl && activeEl.tagName === 'INPUT') { try { cursorStart = activeEl.selectionStart; } catch (err) { } }

            let url = urlOverride || formEl.action + '?' + params.toString();
            let isGrouped = $('#chkGroupProduct').is(':checked');

            $('#topProgressBar').show();

            $.ajax({
                url: url, type: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(response) {
                    let $newHtml = $(response);

                    $('#kpiContainer').html($newHtml.find('#kpiContainer').html());
                    $('#ajaxDataContainer').html($newHtml.find('#ajaxDataContainer').html());

                    if (isPushState) { window.history.pushState(null, '', url); }
                    else { window.history.replaceState(null, '', url); }

                    if (activeDataField) {
                        let newEl = document.querySelector(`.sync-filter:visible[data-field="${activeDataField}"]`);
                        if (newEl) { newEl.focus(); try { newEl.setSelectionRange(cursorStart, cursorStart); } catch (e) { } }
                    }

                    applyExpandedState();
                    updateBulkUI();
                    if (isGrouped) { $('#chkGroupProduct').prop('checked', true); toggleGroupByProduct(document.getElementById('chkGroupProduct')); }
                    $('#topProgressBar').hide();
                },
                error: function() { $('#topProgressBar').hide(); }
            });
        }

        function switchView(mode) { document.getElementById('hdnViewMode').value = mode; submitFilterAjax(null, true); }
        function setSort(col) { document.getElementById('sortOrder').value = document.getElementById('sortOrder').value === col + "_asc" ? col + "_desc" : col + "_asc"; submitFilterAjax(null, true); }

        // =====================================
        // 3. HORIZONTAL ACCORDION & EXPAND ROW
        // =====================================
        const STORAGE_KEY = 'erp_expanded_orders';
        function getExpandedOrders() { let data = localStorage.getItem(STORAGE_KEY); return data ? JSON.parse(data) : []; }
        function saveExpandedOrders(arr) { localStorage.setItem(STORAGE_KEY, JSON.stringify(arr)); }

        function toggleDetail(id, row) {
            var d = document.getElementById('detail-' + id); if (!d) return;
            let expanded = getExpandedOrders(); let isHidden = d.style.display === 'none';
            if (isHidden) { d.style.display = 'table-row'; row.classList.add('row-expanded'); if (!expanded.includes(id)) { expanded.push(id); saveExpandedOrders(expanded); } if (!$(`#bom-container-${id}`).hasClass('loaded')) { loadBomInline(id); } }
            else { d.style.display = 'none'; row.classList.remove('row-expanded'); expanded = expanded.filter(x => x !== id); saveExpandedOrders(expanded); }
            updateToggleAllCheckboxState();
        }

        function toggleAllDetails(checkbox) {
            let isChecked = checkbox.checked; let expanded = getExpandedOrders();
            document.querySelectorAll('.main-row').forEach(row => {
                let id = parseInt(row.getAttribute('data-order-id')); let d = document.getElementById('detail-' + id);
                if (d) {
                    if (isChecked) { d.style.display = 'table-row'; row.classList.add('row-expanded'); if (!expanded.includes(id)) expanded.push(id); if (!$(`#bom-container-${id}`).hasClass('loaded')) { loadBomInline(id); } }
                    else { d.style.display = 'none'; row.classList.remove('row-expanded'); expanded = expanded.filter(x => x !== id); }
                }
            });
            saveExpandedOrders(expanded);
        }

        function applyExpandedState() {
            let expanded = getExpandedOrders();
            document.querySelectorAll('.main-row').forEach(row => {
                let id = parseInt(row.getAttribute('data-order-id')); let d = document.getElementById('detail-' + id);
                if (d) { if (expanded.includes(id)) { d.style.display = 'table-row'; row.classList.add('row-expanded'); if (!$(`#bom-container-${id}`).hasClass('loaded')) { loadBomInline(id); } } else { d.style.display = 'none'; row.classList.remove('row-expanded'); } }
            });
            updateToggleAllCheckboxState();
        }

        function updateToggleAllCheckboxState() {
            let chk = document.getElementById('chkToggleAllDetails'); if (!chk) return;
            let expanded = getExpandedOrders(); let allMainRows = document.querySelectorAll('.main-row');
            if (allMainRows.length === 0) { chk.checked = false; return; }
            let allExpanded = true; allMainRows.forEach(row => { let id = parseInt(row.getAttribute('data-order-id')); if (!expanded.includes(id)) allExpanded = false; });
            chk.checked = allExpanded;
        }

        function toggleHorizontalPanel(panelId) {
            var el = document.getElementById(panelId);
            if (el) { el.classList.toggle('collapsed-panel'); }
        }

        function loadBomInline(orderId) {
            let container = $(`#bom-container-${orderId}`);
            container.html('<div class="p-4 text-center text-muted"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>Đang bóc tách dữ liệu...</div></div>');
            $.ajax({
                url: '/Order/GetOrderBom', type: 'GET', data: { id: orderId },
                success: function(res) {
                    if (res.success) {
                        let html = `<div class="table-responsive flex-grow-1"><table class="table table-sm table-hover mb-0 small"><thead class="bg-light text-muted border-bottom" style="font-size: 0.8rem;"><tr><th class="ps-4 py-2 text-uppercase">Tên Vật tư gốc</th><th class="text-center py-2 text-uppercase" width="90">Cần xuất</th><th class="text-center py-2 text-uppercase" width="90">ĐVT</th><th class="text-center py-2 text-uppercase pe-4" width="90">Tồn kho</th></tr></thead><tbody>`;
                        res.data.forEach(item => {
                            let qty = Number(item.qty ?? 0); let stock = Number(item.stock ?? 0);
                            let isVolume = item.unit && (item.unit.toLowerCase().includes("m3") || item.unit.toLowerCase().includes("khối"));
                            let qtyStr = isVolume ? qty.toFixed(5) : qty.toLocaleString('vi-VN');
                            let stockStr = isVolume ? stock.toFixed(5) : stock.toLocaleString('vi-VN');
                            let stockColor = stock >= qty ? "text-success" : "text-danger";

                            html += `<tr class="bg-light border-top"><td class="fw-bold text-dark ps-4 align-middle"><i class="fa-solid fa-box text-primary me-2 opacity-50"></i>${item.name}</td><td class="text-center fw-800 text-danger align-middle fs-6">${qtyStr}</td><td class="text-center text-muted fw-bold align-middle">${item.unit}</td><td class="text-center fw-bold ${stockColor} align-middle pe-4">${stockStr}</td></tr>`;
                        });
                        html += `</tbody></table></div>`; container.html(html); container.addClass('loaded');
                    } else { container.html(`<div class="p-4 text-center text-warning fw-bold mt-4"><i class="fa-solid fa-triangle-exclamation fa-2x mb-2 opacity-50"></i><br>${res.message}</div>`); }
                }, error: function(xhr) { container.html(`<div class="p-4 text-center text-danger fw-bold"><i class="fa-solid fa-circle-xmark me-2"></i>Lỗi kết nối.</div>`); }
            });
        }

        function viewBom(orderId) {
            Swal.fire({ title: 'Đang bóc tách định mức...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            $.ajax({
                url: '/Order/GetOrderBom', type: 'GET', data: { id: orderId },
                success: function(res) {
                    if (res.success) {
                        let html = `<div class="table-responsive"><table class="table table-bordered text-start align-middle mb-0"><thead class="bg-light text-secondary small"><tr><th class="text-uppercase ps-3">Tên Vật tư gốc</th><th class="text-center text-uppercase">Cần xuất</th><th class="text-center text-uppercase">ĐVT</th><th class="text-center text-uppercase">Tồn kho</th></tr></thead><tbody>`;
                        res.data.forEach(item => {
                            let qty = Number(item.qty ?? 0); let stock = Number(item.stock ?? 0);
                            let isVolume = item.unit && (item.unit.toLowerCase().includes("m3") || item.unit.toLowerCase().includes("khối"));
                            let qtyStr = isVolume ? qty.toFixed(5) : qty.toLocaleString('vi-VN');
                            let stockStr = isVolume ? stock.toFixed(5) : stock.toLocaleString('vi-VN');
                            let stockColor = stock >= qty ? "text-success" : "text-danger";
                            html += `<tr><td class="fw-bold text-dark ps-3"><i class="fa-solid fa-box text-primary me-2 opacity-50"></i>${item.name}</td><td class="text-center fw-800 text-danger fs-5">${qtyStr}</td><td class="text-center text-muted fw-bold">${item.unit}</td><td class="text-center fw-bold ${stockColor}">${stockStr}</td></tr>`;
                        });
                        html += `</tbody></table></div>`;
                        Swal.fire({ title: '<i class="fa-solid fa-calculator text-primary me-2"></i> DỰ TOÁN VẬT TƯ (BOM)', html: html, width: '700px', showCloseButton: true, showConfirmButton: false });
                    } else { Swal.fire('Thông báo', res.message, 'info'); }
                }, error: function() { Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error'); }
            });
        }

        // =====================================
        // 4. QUICK EDIT MENU (CHUỘT PHẢI MỌI NƠI)
        // =====================================
        const statusMap = { '@((int)OrderStatus.PendingApproval)': 'Chờ duyệt', '@((int)OrderStatus.Approved)': 'Đã duyệt', '@((int)OrderStatus.InProduction)': 'Đang Sản Xuất', '@((int)OrderStatus.Packing)': 'Đóng gói', '@((int)OrderStatus.Delivered)': 'Đã giao', '@((int)OrderStatus.Invoiced)': 'Đã xuất HĐ', '@((int)OrderStatus.Completed)': 'Hoàn thành', '@((int)OrderStatus.Canceled)': 'Bị hủy' };

        document.addEventListener("DOMContentLoaded", function() {
            flatpickr(".datepicker", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn" });
            loadColorConfig();
            document.body.appendChild(document.getElementById('quickEditMenu')); applyExpandedState();
        });

        let contextData = { id: 0, field: '', value: '' }; const menu = document.getElementById('quickEditMenu');
        document.addEventListener('contextmenu', function(e) {
            const cell = e.target.closest('.editable-cell');
            if (cell) {
                e.preventDefault(); e.stopPropagation();
                contextData.id = cell.getAttribute('data-id'); contextData.field = cell.getAttribute('data-field'); contextData.value = cell.getAttribute('data-value');
                menu.style.display = 'block'; let posX = e.pageX; let posY = e.pageY;
                if (posX + menu.offsetWidth > document.documentElement.clientWidth + window.scrollX) posX -= menu.offsetWidth;
                if (posY + menu.offsetHeight > document.documentElement.clientHeight + window.scrollY) posY -= menu.offsetHeight;
                menu.style.left = posX + 'px'; menu.style.top = posY + 'px';
            } else { menu.style.display = 'none'; }
        });

        document.addEventListener('click', (e) => { if (!e.target.closest('#quickEditMenu')) menu.style.display = 'none'; });
        document.getElementById('btnQuickEditAction').addEventListener('click', function() {
            menu.style.display = 'none'; const { id, field, value } = contextData;
            let title = ''; let inputType = 'text'; let inputOptions = null; let htmlContent = '';
            if (field === 'OrderDate' || field === 'DeliveryDeadline') { title = field === 'OrderDate' ? 'Sửa Ngày nhận đơn' : 'Sửa Hạn giao hàng'; inputType = null; htmlContent = `<input type="text" id="swal-date" class="form-control text-center fw-bold fs-5 text-primary" value="${value}">`; }
            else if (field === 'PaperOrderCode') { title = 'Sửa PO Gốc'; inputType = 'text'; }
            else if (field === 'Status') { title = 'Đổi Trạng Thái Đơn'; inputType = 'select'; inputOptions = statusMap; }
            else if (field === 'Customer') { Swal.fire('Thông báo', 'Vui lòng bấm Sửa Đơn để đổi Khách.', 'info'); return; }

            Swal.fire({
                title: title, input: inputType, inputOptions: inputOptions, inputValue: value, html: htmlContent, showCancelButton: true, confirmButtonText: 'Cập nhật', confirmButtonColor: '#0ea5e9',
                didOpen: () => { if (field === 'OrderDate' || field === 'DeliveryDeadline') { flatpickr("#swal-date", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", defaultDate: value, locale: "vn", zIndex: 999999 }); } },
                preConfirm: () => { if (htmlContent) return document.getElementById('swal-date').value; }
            }).then((result) => {
                if (result.isConfirmed) { $.post('/Order/QuickUpdate', { id: id, field: field, value: result.value || result.value === 0 ? result.value : '' }, function(res) { if (res.success) submitFilterAjax(null, true); else Swal.fire('Lỗi', res.message, 'error'); }); }
            });
        });

        // =====================================
        // 5. INVOICES (XUẤT & SỬA HÓA ĐƠN)
        // =====================================
        function openUploadModal(orderId, orderCode, remainAmount) {
            var modalEl = document.getElementById('uploadModal'); if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);
            $('#hdOrderId').val(orderId); document.getElementById('frmUpload').reset();
            document.getElementById('billedAmount').value = remainAmount; document.getElementById('billedAmount').max = remainAmount; document.getElementById('billedAmountHint').innerText = "Tối đa: " + new Intl.NumberFormat('vi-VN').format(remainAmount) + " đ";
            flatpickr("#txtInvoiceDate", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn", defaultDate: new Date() });
            (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)).show();
        }
        function submitUpload() {
            if (!$('#txtInvoiceNumber').val() || !$('#billedAmount').val()) { Swal.fire('Lỗi', 'Nhập đủ trường', 'warning'); return; }
            $.ajax({ url: '/Order/UploadInvoice', type: 'POST', data: new FormData($('#frmUpload')[0]), processData: false, contentType: false, success: function(res) { if (res.success) location.reload(); else Swal.fire('Lỗi', res.message, 'error'); } });
        }

        let editInvoiceDatePickr = null;
        function openEditInvoiceModal(detailId, num, date, currentAmount, maxAmount) {
            var modalEl = document.getElementById('editInvoiceModal');
            if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);
            document.getElementById('frmEditInvoice').reset();
            $('#editDetailId').val(detailId); $('#editInvoiceNumber').val(num);
            document.getElementById('editBilledAmount').value = currentAmount; document.getElementById('editBilledAmount').max = maxAmount;
            document.getElementById('editBilledAmountHint').innerText = "Tối đa: " + new Intl.NumberFormat('vi-VN').format(maxAmount) + " đ";
            if (editInvoiceDatePickr) editInvoiceDatePickr.destroy();
            editInvoiceDatePickr = flatpickr("#editInvoiceDate", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn", defaultDate: date });
            (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)).show();
        }
        function submitEditInvoice() {
            var form = document.getElementById('frmEditInvoice'); if (!form.checkValidity()) { form.reportValidity(); return; }
            $.ajax({ url: '/Order/UpdateInvoice', type: 'POST', data: new FormData(form), processData: false, contentType: false, success: function(res) { if (res.success) location.reload(); else Swal.fire('Lỗi', res.message, 'error'); }, error: function() { Swal.fire('Lỗi', 'Lỗi kết nối', 'error'); } });
        }
        function deleteInvoice(detailId) {
            Swal.fire({ title: 'Xóa Hóa đơn?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Xóa', confirmButtonColor: '#dc3545' }).then((result) => {
                if (result.isConfirmed) { $.post('/Order/DeleteInvoice', { detailId: detailId }, function(res) { if (res.success) location.reload(); else Swal.fire('Lỗi', res.message, 'error'); }); }
            });
        }
    </script>
}