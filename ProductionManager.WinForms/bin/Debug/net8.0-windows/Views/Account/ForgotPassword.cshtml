@{ ViewData["Title"] = "Quên mật khẩu"; }
<div class="container mt-5" style="max-width: 500px">
    <div class="card shadow border-0">
        <div class="card-body p-4 text-center">
            <h3 class="fw-bold text-primary mb-3">Quên mật khẩu?</h3>
            <p class="text-muted mb-4">Nhập email của bạn để nhận liên kết đặt lại mật khẩu.</p>
            <form asp-action="ForgotPassword" method="post">
                <div class="form-floating mb-3">
                    <input name="email" type="email" class="form-control" placeholder="name@example.com" required />
                    <label>Email của bạn</label>
                </div>
                <button class="btn btn-primary w-100 fw-bold py-2">Gửi liên kết</button>
            </form>
            <div class="mt-3">
                <a asp-action="Login" class="text-decoration-none small">Quay lại Đăng nhập</a>
            </div>
        </div>
    </div>
</div>