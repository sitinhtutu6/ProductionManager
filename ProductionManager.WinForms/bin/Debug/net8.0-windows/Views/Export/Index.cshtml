@using ProductionManager.Data
@model IEnumerable<ExportShipment>

@{
    ViewData["Title"] = "Quản lý Giao hàng & Logistics";
    bool canViewPrice = ViewBag.CanViewPrice ?? false;
    string viewMode = ViewBag.ViewMode?.ToString() ?? "list";

    var total = Model.Count();
    var completed = Model.Count(x => x.ProgressPercent == 100);
    var processing = total - completed;

    string GetSortUrl(string sortOrder)
    {
        return Url.Action("Index", new { sortOrder = sortOrder, searchString = ViewData["CurrentSearch"], fromDate = ViewData["FromDate"], toDate = ViewData["ToDate"], statusFilter = ViewData["StatusFilter"], viewMode = ViewBag.ViewMode });
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    body {
        background-color: #f4f7f6;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .card-custom {
        background: #ffffff;
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        transition: 0.2s ease;
    }

    .btn-action-main {
        border-radius: 8px;
        font-weight: 700;
        padding: 8px 24px;
    }

    /* Bảng Master-Detail */
    .table-erp {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-erp thead th {
            background-color: #f8fafc;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            padding: 14px 16px;
            border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
        }

        .table-erp tbody td {
            padding: 12px 16px;
            vertical-align: middle;
            font-size: 0.9rem;
            border-bottom: 1px solid #f1f5f9;
        }

    .master-row {
        cursor: pointer;
        transition: 0.2s;
        border-left: 4px solid transparent;
    }

        .master-row:hover {
            background-color: #f1f5f9;
        }

    .row-expanded {
        background-color: #f8fafc !important;
        border-left: 4px solid #0d6efd;
    }

    .chevron-box {
        color: #94a3b8;
        transition: transform 0.3s;
        font-size: 12px;
    }

    .row-expanded .chevron-box {
        transform: rotate(90deg);
        color: #0d6efd;
    }

    /* Lưới Excel */
    .table-excel {
        width: 100%;
        border-collapse: collapse;
    }

        .table-excel th, .table-excel td {
            border: 1px solid #cbd5e1;
            padding: 10px 14px;
            font-size: 13px;
            vertical-align: middle;
        }

        .table-excel th {
            background-color: #f1f5f9;
            font-weight: 800;
            color: #475569;
            text-transform: uppercase;
            white-space: nowrap;
        }

    /* Context Menu */
    #contextMenu {
        display: none;
        position: absolute;
        z-index: 1050;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        border: 1px solid #e2e8f0;
        width: 230px;
        overflow: hidden;
    }

    .ctx-item {
        padding: 10px 20px;
        color: #334155;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        transition: 0.2s;
        text-decoration: none;
    }

        .ctx-item i {
            width: 24px;
        }

        .ctx-item:hover {
            background-color: #f1f5f9;
            color: #2563eb;
        }

        .ctx-item.delete:hover {
            background-color: #fef2f2;
            color: #dc2626;
        }

    .sort-active {
        color: #2563eb;
        font-weight: bold;
    }
</style>

<div class="container-fluid py-4">

    <!-- HEADER KPI -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-layer-group text-primary me-2"></i>ĐIỀU PHỐI LOGISTICS</h3>
            <span class="text-muted small">Quản lý tổng quan tiến độ giao hàng, phương tiện và hàng hóa.</span>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <a asp-action="Create" class="btn btn-primary btn-action-main shadow-sm"><i class="fa-solid fa-plus me-1"></i> Tạo Chuyến Mới</a>
        </div>
    </div>

    <!-- FILTER -->
    <div class="card-custom p-3 mb-4">
        <form method="get" asp-action="Index" id="filterForm" class="row g-2 align-items-end">
            <input type="hidden" name="viewMode" id="hdnViewMode" value="@viewMode" />
            <input type="hidden" name="sortOrder" value="@ViewData["CodeSort"]" />

            <div class="col-lg-4">
                <label class="form-label small fw-bold text-secondary mb-1">🔍 Tìm kiếm</label>
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control form-control-sm bg-light border-0" placeholder="Mã lô, xe, tuyến đường, khách...">
            </div>
            <div class="col-lg-2">
                <label class="form-label small fw-bold text-secondary mb-1">📅 Từ ngày</label>
                <input type="text" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-control-sm bg-light border-0 datepicker" placeholder="Chọn ngày">
            </div>
            <div class="col-lg-2">
                <label class="form-label small fw-bold text-secondary mb-1">📅 Đến ngày</label>
                <input type="text" name="toDate" value="@ViewData["ToDate"]" class="form-control form-control-sm bg-light border-0 datepicker" placeholder="Chọn ngày">
            </div>
            <div class="col-lg-2">
                <label class="form-label small fw-bold text-secondary mb-1">⚡ Trạng thái</label>
                <select name="statusFilter" class="form-select form-select-sm bg-light border-0 fw-bold">
                    <option value="">📂 Tất cả</option>
                    <option value="Running" selected="@((string)ViewData["StatusFilter"] == "Running")">🏃 Đang chạy</option>
                    <option value="Done" selected="@((string)ViewData["StatusFilter"] == "Done")">🏁 Đã xong</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark btn-sm fw-bold flex-grow-1 shadow-sm"><i class="fa-solid fa-filter me-1"></i> Lọc</button>
                <button type="submit" formaction="@Url.Action("ExportToExcel")" class="btn btn-success btn-sm fw-bold shadow-sm" title="Xuất báo cáo Excel"><i class="fa-solid fa-file-excel"></i></button>
            </div>
        </form>
    </div>

    <!-- MAIN DATA AREA -->
    <div class="card-custom overflow-hidden mb-4">

        <div class="bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-800 text-dark m-0"><i class="fa-solid fa-database text-primary me-2"></i>DỮ LIỆU ĐIỀU PHỐI</h6>
            <div class="btn-group shadow-sm border rounded-pill p-1 bg-light">
                <button type="button" class="btn btn-sm px-4 rounded-pill fw-bold @(viewMode == "list" ? "btn-dark" : "btn-light text-muted border-0")" onclick="switchView('list')"><i class="fa-solid fa-list me-2"></i>Lịch sử Gộp</button>
                <button type="button" class="btn btn-sm px-4 rounded-pill fw-bold @(viewMode == "grid" ? "btn-dark" : "btn-light text-muted border-0")" onclick="switchView('grid')"><i class="fa-solid fa-table-cells me-2"></i>Lưới Excel (Chi tiết)</button>
            </div>
        </div>

        <div class="table-responsive">

            @if (viewMode == "list")
            {
                <table class="table table-erp mb-0">
                    <thead>
                        <tr>
                            <th width="30" class="text-center"></th>
                            <th><a href="@GetSortUrl((string)ViewData["CodeSort"])" class="text-decoration-none text-secondary">CHUYẾN / KHÁCH HÀNG <i class="fa-solid fa-sort ms-1"></i></a></th>
                            <th>TUYẾN ĐƯỜNG</th>
                            <th><a href="@GetSortUrl((string)ViewData["DateSort"])" class="text-decoration-none text-secondary">PHƯƠNG TIỆN & LỊCH <i class="fa-solid fa-sort ms-1"></i></a></th>
                            @if (canViewPrice)
                            {
                                <th class="text-end">CƯỚC PHÍ</th>
                            }
                            <th style="width: 15%;"><a href="@GetSortUrl((string)ViewData["ProgressSort"])" class="text-decoration-none text-secondary">TIẾN ĐỘ <i class="fa-solid fa-sort ms-1"></i></a></th>
                            <th class="text-center pe-4" width="60"><i class="fa-solid fa-ellipsis"></i></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="10" class="text-center py-5 text-muted fst-italic">Không tìm thấy dữ liệu.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr class="master-row context-row" data-id="@item.Id" data-code="@item.ShipmentCode" onclick="toggleDetail(@item.Id, this)">
                                <td class="text-center"><i class="fa-solid fa-chevron-right chevron-box"></i></td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark fs-6">@item.ShipmentCode</div>
                                    <div class="text-muted small"><i class="fa-regular fa-building me-1"></i> @item.Customer?.CompanyName</div>
                                </td>
                                <td>
                                    <div class="small fw-bold text-dark"><i class="fa-solid fa-location-dot text-success me-1"></i> Bắt đầu: @(item.Departure ?? "Kho Nội Bộ")</div>
                                    <div class="small fw-bold text-dark mt-1"><i class="fa-solid fa-location-dot text-danger me-1"></i> Kết thúc: @(item.Destination ?? "Kho Khách Hàng")</div>
                                </td>
                                <td>
                                    <div class="mb-1">
                                        @if (item.TransportType == TransportType.Truck)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="fa-solid fa-truck me-1"></i> @(string.IsNullOrEmpty(item.LicensePlate) ? "Chưa gắn xe" : item.LicensePlate)</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-info bg-opacity-10 text-info border border-info"><i class="fa-solid fa-ship me-1"></i> @(string.IsNullOrEmpty(item.BookingNumber) ? "Chưa Booking" : item.BookingNumber)</span>
                                        }
                                    </div>
                                    <div class="small text-muted fw-bold mt-1"><i class="fa-regular fa-calendar-check me-1"></i> @(item.ETD?.ToString("dd/MM/yyyy") ?? "Chưa chốt")</div>
                                </td>
                                @if (canViewPrice)
                                {
                                    <td class="text-end fw-bold text-danger">@item.ShippingCost.ToString("N0")</td>
                                }
                                <td>
                                    <div class="d-flex justify-content-between small mb-1"><span class="fw-bold text-primary">@GetStepEmoji(item.CurrentStep)</span><span class="fw-bold">@item.ProgressPercent%</span></div>
                                    <div class="progress bg-light border" style="height: 6px;"><div class="progress-bar" style="width: @item.ProgressPercent%; background: linear-gradient(90deg, #3b82f6, #2563eb);"></div></div>
                                </td>
                                <td class="text-center pe-4" onclick="event.stopPropagation()"><button class="btn btn-sm btn-light text-muted rounded-circle shadow-sm" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button></td>
                            </tr>

                            <!-- LƯỚI CHI TIẾT HÀNG HÓA -->
                            <tr class="detail-row" id="detail-@item.Id" style="display: none;">
                                <td colspan="10" class="p-0 border-0">
                                    <div class="p-4 bg-light">
                                        <div class="card border-0 shadow-sm">
                                            <div class="card-header bg-white py-2"><div class="fw-bold text-primary small text-uppercase"><i class="fa-solid fa-boxes-packing me-2"></i>CHI TIẾT HÀNG HÓA TRÊN XE</div></div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered mb-0">
                                                    <thead class="bg-light text-muted">
                                                        <tr>
                                                            <th class="ps-3">Sản Phẩm</th>
                                                            <th class="text-center">Phiếu Xuất</th>
                                                            <th class="text-center" width="100">Số Lượng</th>
                                                            @if (canViewPrice)
                                                            {
                                                                <th class="text-end">Đơn Giá</th>
                                                                <th class="text-end pe-3">Thành Tiền</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (item.Shipments != null && item.Shipments.Any(sh => sh.ShipmentDetails.Any()))
                                                        {
                                                            foreach (var ship in item.Shipments)
                                                            {
                                                                foreach (var d in ship.ShipmentDetails)
                                                                {
                                                                    decimal price = d.OrderDetail?.UnitPrice ?? 0;
                                                                    <tr class="bg-white">
                                                                        <td class="ps-3 fw-bold text-dark">@d.OrderDetail?.ProductName</td>
                                                                        <td class="text-center text-muted font-monospace small">@ship.ShipmentCode</td>
                                                                        <td class="text-center fw-bold text-primary">@d.QuantityShipped</td>
                                                                        @if (canViewPrice)
                                                                        {
                                                                            <td class="text-end text-muted">@price.ToString("N0")</td>
                                                                            <td class="text-end fw-bold text-dark pe-3">@((d.QuantityShipped * price).ToString("N0"))</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr><td colspan="5" class="text-center fst-italic py-3 text-muted">Chưa có hàng hóa xuất kho lên xe này.</td></tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <!-- ================= VIEW 2: DẠNG LƯỚI EXCEL CHUẨN ================= -->
            @if (viewMode == "grid")
            {
                <table class="table table-hover table-excel bg-white mb-0">
                    <thead>
                        <tr>
                            <th class="text-center" width="40">STT</th>
                            <th>Mã Chuyến</th>
                            <th>Khách Hàng</th>
                            <th>Tuyến Đường</th>
                            <th>Phương Tiện & Ngày Đi</th>
                            <th>Tên Sản Phẩm (Hàng Hóa)</th>
                            <th class="text-center">Số Lượng</th>
                            @if (canViewPrice)
                            {
                                <th class="text-end">Đơn Giá</th>
                                <th class="text-end text-success">Thành Tiền</th>
                                <th class="text-end text-danger">Cước Xe</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="10" class="text-center py-5 text-muted fw-bold">Không tìm thấy dữ liệu.</td></tr>
                        }
                        @{
                            int sttExcel = 1;
                        }
                        @foreach (var s in Model)
                        {
                            string routeInfo = (s.Departure ?? "Kho") + " -> " + (s.Destination ?? "Khách");
                            string vehicleInfo = (s.TransportType == TransportType.Container ? s.BookingNumber : s.LicensePlate) + " (" + (s.ETD?.ToString("dd/MM/yyyy") ?? "-") + ")";

                            if (s.Shipments == null || !s.Shipments.Any(sh => sh.ShipmentDetails.Any()))
                            {
                                <tr>
                                    <td class="text-center text-muted fw-bold">@(sttExcel++)</td>
                                    <td class="fw-bold font-monospace text-dark">@s.ShipmentCode</td>
                                    <td class="fw-bold text-dark">@s.Customer?.CompanyName</td>
                                    <td class="text-muted small">@routeInfo</td>
                                    <td class="text-muted fw-bold">@vehicleInfo</td>
                                    <td class="text-muted fst-italic">(Chưa xuất hàng)</td>
                                    <td class="text-center">-</td>
                                    @if (canViewPrice)
                                    {
                                        <td class="text-end">-</td>
                                        <td class="text-end">-</td>
                                        <td class="text-end fw-bold text-danger">@s.ShippingCost.ToString("N0")</td>
                                    }
                                </tr>
                            }
                            else
                            {
                                bool isFirstItem = true;
                                foreach (var ship in s.Shipments)
                                {
                                    foreach (var d in ship.ShipmentDetails)
                                    {
                                        decimal price = d.OrderDetail?.UnitPrice ?? 0;
                                        <tr>
                                            <td class="text-center text-muted fw-bold">@(sttExcel++)</td>
                                            <td class="fw-bold font-monospace text-dark">@s.ShipmentCode</td>
                                            <td class="fw-bold text-dark">@s.Customer?.CompanyName</td>
                                            <td class="text-muted small">@routeInfo</td>
                                            <td class="text-muted fw-bold">@vehicleInfo</td>
                                            <td class="fw-bold text-primary">@d.OrderDetail?.ProductName</td>
                                            <td class="text-center fw-800 text-dark">@d.QuantityShipped</td>
                                            @if (canViewPrice)
                                            {
                                                <td class="text-end text-muted">@price.ToString("N0")</td>
                                                <td class="text-end fw-bold text-success">@((d.QuantityShipped * price).ToString("N0"))</td>
                                                <td class="text-end fw-bold text-danger">@(isFirstItem ? s.ShippingCost.ToString("N0") : "")</td>
                                            }
                                        </tr>
                                        isFirstItem = false;
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<!-- MENU CHUỘT PHẢI -->
<div id="contextMenu">
    <div class="p-2 border-bottom bg-light small fw-bold text-muted ps-3" id="ctxTitle">TÙY CHỌN</div>
    <a href="#" id="ctxView" class="ctx-item"><i class="fa-solid fa-folder-open text-primary"></i> Xem & Điều phối</a>
    <a href="#" id="ctxPrint" target="_blank" class="ctx-item"><i class="fa-solid fa-print text-dark"></i> In lệnh vận chuyển</a>
    <div class="ctx-divider"></div>
    <a href="#" id="ctxDelete" class="ctx-item delete"><i class="fa-solid fa-trash-can"></i> Xóa chuyến xe này</a>
</div>
<form id="deleteForm" method="post" style="display:none;"></form>

@functions {
    public string GetStepEmoji(ExportStep step) => step switch
    {
        ExportStep.Contract => "📄 Lên Kế hoạch",
        ExportStep.Booking => "🚢 Đặt Xe/Booking",
        ExportStep.Packing => "📦 Chứng từ",
        ExportStep.Container => "🏗️ Xếp Hàng",
        ExportStep.Customs => "🛃 Hải quan",
        ExportStep.PortDropOff => "⚓ Xuất phát",
        ExportStep.BillOfLading => "📜 Vận đơn",
        ExportStep.DocSend => "📨 Gửi hồ sơ",
        ExportStep.Payment => "💰 Hoàn tất",
        _ => "Khác"
    };
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
        flatpickr(".datepicker", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn", allowInput: true });

        let activeId = null; let activeCode = "";
        $('.context-row').on('contextmenu', function (e) {
        e.preventDefault();
        activeId = $(this).data('id'); activeCode = $(this).data('code');
        $('#ctxTitle').text("CHUYẾN: " + activeCode);
        $('#ctxView').attr('href', '/Export/Details/' + activeId);
        $('#ctxPrint').attr('href', '/Export/Print/' + activeId);

        let x = e.pageX; let y = e.pageY;
        if (x + 230 > $(window).width()) x -= 230;
        if (y + 200 > $(window).height()) y -= 200;
        $('#contextMenu').css({ top: y + 'px', left: x + 'px' }).fadeIn(150);
        });

        $(document).on('click', function (e) { if (!$(e.target).closest('#contextMenu').length) $('#contextMenu').fadeOut(100); });

        $('#ctxDelete').on('click', function (e) {
        e.preventDefault(); $('#contextMenu').fadeOut(100);
        Swal.fire({
        title: `Xóa chuyến ${activeCode}?`,
        html: "Cảnh báo: Toàn bộ đơn hàng sẽ bị gỡ khỏi xe.<br/><b class='text-danger'>Phiếu xuất kho KHÔNG bị ảnh hưởng.</b>",
        icon: 'warning', showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Xóa ngay', cancelButtonText: 'Hủy bỏ'
        }).then((result) => {
        if (result.isConfirmed) {
        Swal.fire({ title: 'Đang xử lý...', didOpen: () => Swal.showLoading() });
        let form = $('#deleteForm'); form.attr('action', '/Export/Delete/' + activeId); form.submit();
        }
        });
        });
        });

        function switchView(mode) {
        document.getElementById('hdnViewMode').value = mode;
        document.getElementById('filterForm').submit();
        }

        function toggleDetail(id, row) {
        var d = document.getElementById('detail-' + id);
        if (!d) return;
        if (d.style.display === 'none') { d.style.display = 'table-row'; row.classList.add('row-expanded'); }
        else { d.style.display = 'none'; row.classList.remove('row-expanded'); }
        }
    </script>
}