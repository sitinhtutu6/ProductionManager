@model ProductionManager.Data.PurchaseOrder
@{
    ViewData["Title"] = "Cập nhật Đơn hàng";
    ViewData["Breadcrumbs"] = new List<(string Title, string Url)>
    {
        ("Đặt Hàng", Url.Action("Index", "PurchaseOrder")),
        ("Chỉnh Sửa", "")
    };
    var itemsJson = ViewBag.ItemsJson;
    var existingDetailsJson = ViewBag.ExistingDetailsJson;
    var suppJson = ViewBag.SuppliersJson;
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<style>
    .select2-container .select2-selection--single {
        height: 38px !important;
        padding: 5px 8px;
        border: 1px solid #ced4da;
        border-radius: 6px;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px !important;
        right: 8px;
    }

    .input-locked {
        cursor: not-allowed !important;
        opacity: 0.6;
        background-color: #f8f9fa !important;
    }

    .financial-summary-table td {
        padding: 8px 12px;
        vertical-align: middle;
    }
</style>

<div class="container-fluid mt-4" style="max-width: 1200px;">
    <form id="poForm" onsubmit="submitEditPO(event)">
        <input type="hidden" id="poId" value="@Model.Id" />

        <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-warning text-dark py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>CẬP NHẬT ĐƠN HÀNG @Model.POCode</h5>
                <a href="/PurchaseOrder" class="btn btn-sm btn-light fw-bold text-dark border shadow-sm px-3 rounded-pill">Trở về</a>
            </div>
            <div class="card-body bg-light p-4">
                <div class="row g-4">
                    <div class="col-md-3">
                        <label class="fw-bold small text-muted text-uppercase mb-1">Mã Đơn</label>
                        <input id="poCode" class="form-control fw-bold bg-secondary bg-opacity-10 shadow-sm" value="@Model.POCode" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-bold small text-primary text-uppercase mb-1"><i class="fa-regular fa-calendar me-1"></i> Ngày Đặt</label>
                        <input type="text" id="orderDate" class="form-control bg-white fw-bold datepicker shadow-sm" value="@Model.OrderDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label class="fw-bold small text-muted text-uppercase mb-1">Loại Đơn</label>
                        <select id="poType" class="form-select fw-bold text-dark shadow-sm">
                            <option value="1" selected="@(Model.Type == ProductionManager.Data.POType.Purchase)">Mua hàng thương mại</option>
                            <option value="2" selected="@(Model.Type == ProductionManager.Data.POType.Outsourcing)">Đặt gia công ngoài</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="fw-bold small text-danger text-uppercase mb-1">Nhà Cung Cấp (*)</label>
                        <select id="supplierId" class="form-control fw-bold shadow-sm" required></select>
                    </div>
                    <div class="col-12">
                        <label class="fw-bold small text-muted text-uppercase mb-1">Ghi chú nội bộ</label>
                        <input id="note" class="form-control shadow-sm" value="@Model.Note" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold text-secondary mb-0"><i class="fa-solid fa-boxes-stacked me-2"></i>DANH SÁCH VẬT TƯ & TÀI CHÍNH</h6>
                <button type="button" class="btn btn-sm btn-primary fw-bold rounded-pill px-3 shadow-sm" onclick="addRow()">
                    <i class="fa-solid fa-plus me-1"></i> Thêm dòng
                </button>
            </div>

            <div class="table-responsive" style="min-height: 200px;">
                <table class="table table-hover mb-0 align-middle" id="tblDetails">
                    <thead class="bg-light text-center small text-muted text-uppercase border-bottom">
                        <tr>
                            <th style="width: 35%" class="text-start ps-4">Sản phẩm / Vật tư</th>
                            <th style="width: 10%">ĐVT</th>
                            <th style="width: 15%">Số lượng Đặt</th>
                            <th style="width: 20%">Đơn giá (VNĐ)</th>
                            <th style="width: 15%" class="text-end">Thành Tiền</th>
                            <th style="width: 5%"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-4">
                <div class="row">
                    <div class="col-lg-6 mb-3 mb-lg-0 d-flex align-items-end">
                        <div class="alert alert-warning border-0 shadow-sm mb-0 w-100 d-flex align-items-center">
                            <i class="fa-solid fa-shield-halved fa-2x me-3 text-warning"></i>
                            <div class="small text-dark">
                                <strong class="d-block mb-1">Chế độ Cập nhật An toàn</strong>
                                Nếu đơn hàng đã tiến hành nhập kho, bạn sẽ không thể chỉnh sửa vật tư. Tuy nhiên, Kế toán vẫn có thể điều chỉnh <b>Thuế VAT</b> và <b>Tiền Cọc</b>.
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="bg-light p-3 rounded-4 shadow-sm border">
                            <table class="table table-borderless financial-summary-table mb-0 w-100">
                                <tr>
                                    <td class="text-end fw-bold text-muted">Cộng tiền hàng:</td>
                                    <td width="200" class="text-end fw-bold fs-6 text-dark" id="lblTotalAmount">@Model.TotalAmount.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="text-end fw-bold text-muted">
                                        Thuế VAT (%)
                                        <input type="number" id="vatPercent" class="form-control form-control-sm d-inline-block text-center ms-2 fw-bold" style="width: 70px;" value="@Model.VATPercent" min="0" max="100" oninput="calcTotalFinancial()" />
                                    </td>
                                    <td width="200" class="text-end fw-bold text-muted" id="lblVatAmount">@Model.VATAmount.ToString("N0")</td>
                                </tr>
                                <tr class="border-top border-bottom border-2 border-warning">
                                    <td class="text-end fw-bold text-warning text-uppercase">Tổng Thanh Toán:</td>
                                    <td width="200" class="text-end fw-bold text-warning fs-4" id="lblFinalTotal">@Model.FinalTotal.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td class="text-end fw-bold text-danger pt-3">Tiền đặt cọc trước:</td>
                                    <td width="200" class="pt-3">
                                        <input type="number" id="depositAmount" class="form-control text-end fw-bold text-danger shadow-sm" value="@Model.DepositAmount" min="0" oninput="calcTotalFinancial()" />
                                    </td>
                                </tr>
                                <tr class="border-top border-secondary border-dashed">
                                    <td class="text-end fw-bold text-uppercase pt-3">Còn Lại (Phải Trả):</td>
                                    <td width="200" class="text-end fw-bold text-success fs-4 pt-3" id="lblRemainingAmount">@Model.RemainingAmount.ToString("N0")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light text-end py-3">
                <button type="submit" class="btn btn-warning btn-lg fw-bold px-5 shadow-sm rounded-pill text-dark">
                    <i class="fa-solid fa-floppy-disk me-2"></i> LƯU THAY ĐỔI
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const itemList = @Html.Raw(itemsJson);
        const existingData = @Html.Raw(existingDetailsJson);
        const suppList = @Html.Raw(suppJson);
        const currentSupplierId = @Model.SupplierId;
        let rowIndex = 0;

        $(document).ready(function () {
            flatpickr(".datepicker", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn" });

            let suppSelect = $('#supplierId');
            suppList.forEach(s => {
                let opt = new Option(s.Text, s.Id);
                if (s.Id === currentSupplierId) opt.selected = true;
                suppSelect.append(opt);
            });
            suppSelect.val('@Model.SupplierId').select2({ theme: 'bootstrap-5', width: '100%', placeholder: "🔍 Tìm NCC..." });

            if (existingData && existingData.length > 0) {
                existingData.forEach(item => {
                    let wId = item.WarehouseItemId || item.warehouseItemId;
                    let qty = item.QuantityOrdered || item.quantityOrdered;
                    let price = item.UnitPrice || item.unitPrice;
                    addRow(wId, qty, price);
                });
            } else { addRow(); }

            calcTotalFinancial();
        });

        function addRow(selectedItemId = null, qtyVal = 1, priceVal = 0) {
            const tbody = document.querySelector("#tblDetails tbody");
            const row = tbody.insertRow();
            row.id = `row-${rowIndex}`;

            let options = '<option value="">-- Tìm vật tư --</option>';
            let unitText = '';
            itemList.forEach(item => {
                let selected = (selectedItemId && item.Id == selectedItemId) ? "selected" : "";
                if (selected) unitText = item.Unit;
                options += `<option value="${item.Id}" data-unit="${item.Unit}" ${selected}>${item.Code} - ${item.Name}</option>`;
            });

            let stateAttr = selectedItemId ? "" : "readonly";
            let stateClass = selectedItemId ? "" : "input-locked";

            row.innerHTML = `
                        <td class="ps-4"><select class="form-control row-item" required>${options}</select></td>
                        <td class="text-center fw-bold text-secondary row-unit bg-light align-middle">${unitText}</td>
                        <td><input type="number" class="form-control text-center fw-bold text-primary row-qty ${stateClass}" value="${qtyVal}" min="0.01" step="0.01" required ${stateAttr}></td>
                        <td><input type="number" class="form-control text-end fw-bold text-dark row-price ${stateClass}" value="${priceVal}" min="0" ${stateAttr}></td>
                        <td class="text-end fw-bold text-success row-total align-middle fs-6">0</td>
                        <td class="text-center align-middle"><button type="button" class="btn btn-sm btn-light text-danger shadow-sm rounded-circle" onclick="removeRow(this)"><i class="fa-solid fa-trash"></i></button></td>
                    `;

            let newSelect = $(row).find('.row-item');
            newSelect.select2({ theme: 'bootstrap-5', width: '100%' });

            newSelect.on('select2:select', function (e) { onItemChange(this); });
            newSelect.on('select2:unselect', function (e) { lockRow(this.closest('tr')); });

            rowIndex++;
            calcTotalFinancial();
        }

        function removeRow(btn) { btn.closest('tr').remove(); calcTotalFinancial(); }

        function lockRow(tr) {
            tr.querySelector('.row-unit').innerText = '';
            let qtyInp = tr.querySelector('.row-qty');
            let priceInp = tr.querySelector('.row-price');
            qtyInp.readOnly = true; qtyInp.classList.add('input-locked');
            priceInp.readOnly = true; priceInp.classList.add('input-locked');
            calcTotalFinancial();
        }

        function onItemChange(select) {
            const opt = select.selectedOptions[0];
            let tr = select.closest('tr');

            if (opt && opt.value) {
                tr.querySelector('.row-unit').innerText = opt.getAttribute('data-unit') || '';
                let qtyInp = tr.querySelector('.row-qty');
                let priceInp = tr.querySelector('.row-price');
                qtyInp.readOnly = false; qtyInp.classList.remove('input-locked');
                priceInp.readOnly = false; priceInp.classList.remove('input-locked');
            } else { lockRow(tr); }
            calcTotalFinancial();
        }

        function calcTotalFinancial() {
            let total = 0;
            document.querySelectorAll("#tblDetails tbody tr").forEach(row => {
                let qty = parseFloat(row.querySelector(".row-qty").value) || 0;
                let price = parseFloat(row.querySelector(".row-price").value) || 0;
                let lineTotal = qty * price;
                row.querySelector(".row-total").innerText = lineTotal.toLocaleString('vi-VN');
                total += lineTotal;
            });

            let vatPercent = parseFloat(document.getElementById("vatPercent").value) || 0;
            let vatAmt = total * (vatPercent / 100);
            let finalT = total + vatAmt;
            let deposit = parseFloat(document.getElementById("depositAmount").value) || 0;
            let remain = finalT - deposit;

            document.getElementById("lblTotalAmount").innerText = total.toLocaleString('vi-VN');
            document.getElementById("lblVatAmount").innerText = vatAmt.toLocaleString('vi-VN');
            document.getElementById("lblFinalTotal").innerText = finalT.toLocaleString('vi-VN');
            document.getElementById("lblRemainingAmount").innerText = remain.toLocaleString('vi-VN');
        }

        $(document).on('input', '.row-qty, .row-price', function () { calcTotalFinancial(); });

        function submitEditPO(e) {
            e.preventDefault();
            const id = document.getElementById("poId").value;
            const suppSelect = document.getElementById("supplierId");

            if (!suppSelect.value) { Swal.fire("Lỗi", "Vui lòng chọn Nhà Cung Cấp!", "warning"); return; }

            let rawSuppName = suppSelect.options[suppSelect.selectedIndex].text;
            let cleanSuppName = rawSuppName.substring(rawSuppName.indexOf("]") + 1).trim();

            const poData = {
                Id: parseInt(id),
                POCode: document.getElementById("poCode").value,
                OrderDate: document.getElementById("orderDate").value,
                SupplierId: parseInt(suppSelect.value),
                SupplierName: cleanSuppName,
                Type: parseInt(document.getElementById("poType").value),
                Note: document.getElementById("note").value,
                VATPercent: parseFloat(document.getElementById("vatPercent").value) || 0,
                DepositAmount: parseFloat(document.getElementById("depositAmount").value) || 0,
                Details: []
            };

            const rows = document.querySelectorAll("#tblDetails tbody tr");
            if (rows.length === 0) { Swal.fire("Lỗi", "Vui lòng nhập ít nhất 1 vật tư", "warning"); return; }

            let isValid = true;
            rows.forEach(row => {
                const itemId = row.querySelector(".row-item").value;
                const qty = parseFloat(row.querySelector(".row-qty").value);
                const price = parseFloat(row.querySelector(".row-price").value) || 0;
                if (!itemId || qty <= 0) isValid = false;
                if (itemId) poData.Details.push({ WarehouseItemId: parseInt(itemId), QuantityOrdered: qty, UnitPrice: price });
            });

            if (!isValid) { Swal.fire("Lỗi", "Vui lòng kiểm tra lại vật tư (Chưa chọn hoặc SL <= 0)", "error"); return; }

            Swal.fire({ title: 'Đang cập nhật...', didOpen: () => Swal.showLoading() });
            fetch(`/PurchaseOrder/Edit/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(poData)
            }).then(res => res.json()).then(res => {
                if (res.success) { Swal.fire("Thành công", res.message, "success").then(() => window.location.href = "/PurchaseOrder/Index"); }
                else { Swal.fire("Lỗi", res.message, "error"); }
            });
        }
    </script>
}