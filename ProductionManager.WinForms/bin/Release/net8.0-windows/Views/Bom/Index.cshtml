@model IEnumerable<ProductionApp.Web.Models.ViewModels.BomProductStatsVM>
@{
    ViewData["Title"] = "Danh sách Định mức (BOM)";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-uppercase mb-1">Quản lý Định mức (BOM)</h4>
            <p class="text-muted small mb-0">Thiết lập công thức vật tư cho sản phẩm</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-plus me-2"></i>Thiết lập BOM
        </a>
        <a asp-action="RecalculateAllQuantities"
           class="btn btn-outline-danger fw-bold rounded-pill px-4 shadow-sm"
           onclick="return confirm('Hệ thống sẽ tính toán lại toàn bộ tiêu hao dựa trên kích thước và ĐVT hiện tại. Bạn chắc chắn chứ?')">
            <i class="fa-solid fa-sync me-2"></i>Cập nhật công thức toàn hệ thống
        </a>
    </div>

    <div class="card mb-3 border-0 shadow-sm bg-light">
        <div class="card-body p-2">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="keyword" class="form-control border-0" placeholder="Tìm kiếm theo tên hoặc mã sản phẩm..." value="@ViewBag.Keyword">
                <button type="submit" class="btn btn-secondary px-4"><i class="fa-solid fa-magnifying-glass"></i></button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase small fw-bold">
                    <tr>
                        <th class="ps-4">Mã SP</th>
                        <th>Tên Sản Phẩm</th>
                        <th class="text-center">ĐVT</th>
                        <th class="text-center">Số chi tiết</th>
                        <th class="text-end">Giá vốn vật tư (Est)</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.ProductCode</td>
                                <td class="fw-bold">@item.ProductName</td>
                                <td class="text-center text-muted small">@item.Unit</td>
                                <td class="text-center"><span class="badge bg-info text-dark">@item.MaterialCount loại vật tư</span></td>
                                <td class="text-end fw-bold text-success">@item.EstimatedCost.ToString("N0") ₫</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-light text-primary" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></a>
                                        <a asp-action="Create" asp-route-productId="@item.ProductId" class="btn btn-light text-warning" title="Sửa (Ghi đè)"><i class="fa-solid fa-pen"></i></a>
                                        <a asp-action="ExportOptions" asp-route-id="@item.ProductId" class="btn btn-success btn-sm fw-bold shadow-sm" title="Excel"><i class="fa-solid fa-file-excel"></i></a>
                                        
                                        <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" onsubmit="return confirm('CẢNH BÁO: Xóa toàn bộ định mức của sản phẩm này?');" class="d-inline">
                                            <button type="submit" class="btn btn-light text-danger" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có dữ liệu định mức. Hãy bấm "Thiết lập BOM" để tạo mới.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>