@using Microsoft.AspNetCore.Authorization
@using ProductionManager.Data
@using ProductionApp.Web.Constants
@using System.Security.Claims
@model IEnumerable<ProductionManager.Data.WarehouseItem>

@{
    ViewData["Title"] = "Quản lý Kho Vật Tư";

    // --- CẤU HÌNH QUYỀN HẠN ---
    bool canCreate = User.IsInRole("Admin") || User.HasClaim(c => c.Type == AppPermissions.ClaimType && c.Value == AppPermissions.Warehouse.Create);
    bool canEdit = User.IsInRole("Admin") || User.HasClaim(c => c.Type == AppPermissions.ClaimType && c.Value == AppPermissions.Warehouse.Edit);

    var totalItems = Model.Count();
    var lowStock = Model.Count(x => x.StockQuantity <= 5);
    var totalValue = Model.Sum(x => (decimal)x.StockQuantity * x.CostPrice);

    // Lấy danh sách danh mục từ Database
    var dbCategories = ViewBag.Categories as List<ProductionManager.Data.WarehouseCategory> ?? new List<ProductionManager.Data.WarehouseCategory>();

    var tagColors = new[] {
        "text-primary bg-primary",      // Xanh dương
        "text-success bg-success",      // Xanh lá
        "text-danger bg-danger",        // Đỏ
        "text-warning bg-warning",      // Vàng cam
        "text-info bg-info",            // Xanh ngọc
        "text-dark bg-dark",            // Đen
        "text-secondary bg-secondary"   // Xám
    };
}

<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

<style>
    body {
        background-color: #f4f6f8;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    /* Card thống kê */
    .stats-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: 1px solid white;
        transition: all 0.2s;
    }

        .stats-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            border-color: #e9ecef;
        }

    /* Ảnh Thumbnail */
    .item-img-box {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        overflow: hidden;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e9ecef;
        cursor: zoom-in;
        transition: transform 0.2s;
    }

        .item-img-box:hover {
            transform: scale(1.1);
        }

        .item-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* 🔥 STYLE CHO TAG NAVIGATION (TAB SWITCH) 🔥 */
    .category-nav {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 5px 2px;
        scrollbar-width: none;
    }

        .category-nav::-webkit-scrollbar {
            display: none;
        }

    .cat-tag {
        cursor: pointer;
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        user-select: none;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        /* Mặc định nếu không có class màu */
        color: #64748b;
        background: white;
        border: 1px solid #e2e8f0;
    }

        .cat-tag:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        /* Khi Active: Màu xanh đậm Gradient - Dùng !important để đè màu class bootstrap */
        .cat-tag.active {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%) !important;
            color: white !important;
            border: 1px solid #0a58ca !important;
            box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3);
        }

    /* Table Styles */
    .table-custom thead th {
        background: #f8f9fa;
        color: #475569;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 16px;
        border-bottom: 2px solid #e2e8f0;
    }

    .table-custom tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .table-custom tbody tr:hover {
        background-color: #f8faff;
    }

    /* Upload Preview */
    .img-upload-preview {
        width: 100%;
        height: 150px;
        border: 2px dashed #dee2e6;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background-size: cover;
        background-position: center;
        transition: 0.2s;
    }

        .img-upload-preview:hover {
            border-color: #0d6efd;
            background-color: #f8f9fa;
        }
</style>

<div class="container-fluid py-4">

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div><div class="text-muted small fw-bold text-uppercase">Tổng Mã</div><h2 class="mb-0 fw-bold text-dark">@totalItems</h2></div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3"><i class="fa-solid fa-boxes-stacked fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div><div class="text-muted small fw-bold text-uppercase">Cảnh báo tồn</div><h2 class="mb-0 fw-bold text-danger">@lowStock</h2></div>
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3"><i class="fa-solid fa-triangle-exclamation fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div><div class="text-muted small fw-bold text-uppercase">Giá trị kho</div><h4 class="mb-0 fw-bold text-success">@totalValue.ToString("#,##0") <small class="fs-6 text-muted">₫</small></h4></div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3"><i class="fa-solid fa-sack-dollar fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card bg-primary text-white h-100 d-flex flex-row align-items-center justify-content-center gap-3" role="button" onclick="openModal(0)" style="border:none; cursor:pointer;">
                <div class="bg-white bg-opacity-25 rounded-circle p-3"><i class="fa-solid fa-plus fa-lg"></i></div>
                <div class="fw-bold fs-5">THÊM VẬT TƯ</div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-center mb-3">
        <div class="category-nav w-100 w-md-auto flex-grow-1 align-items-center">
            <div class="cat-tag active" onclick="filterCategory('', this)">
                <i class="fa-solid fa-layer-group me-1"></i> Tất cả
            </div>

            @{
                int i = 0;
            }
            @foreach (var cat in dbCategories)
            {
                // Lấy màu xoay vòng theo index
                var colorClass = tagColors[i % tagColors.Length];

                // Render thẻ Tag với màu sắc riêng biệt (bg-opacity-10 để màu dịu mắt)
                <div class="cat-tag @colorClass bg-opacity-10 border border-0"
                     onclick="filterCategory('@cat.Id', this)">
                    @cat.Name
                </div>

                i++;
            }

            @if (canEdit)
            {
                <button class="btn btn-sm btn-light border rounded-circle ms-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="openCategoryManager()" title="Quản lý nhóm hàng">
                    <i class="fa-solid fa-gear text-secondary"></i>
                </button>
            }
        </div>

        <div class="d-flex gap-2 w-100 w-md-auto">
            <div class="input-group shadow-sm" style="min-width: 300px;">
                <span class="input-group-text bg-white border-end-0 ps-3"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" id="customSearch" class="form-control border-start-0 py-2" placeholder="Tìm tên, mã, quy cách..." onkeyup="filterTable()">
                <button type="button" class="btn btn-white border border-start-0" onclick="startScanner()" title="Quét mã"><i class="fa-solid fa-qrcode"></i></button>
            </div>

            <div class="dropdown">
                <button class="btn btn-white bg-white border fw-bold shadow-sm dropdown-toggle py-2 px-3" data-bs-toggle="dropdown"><i class="fa-solid fa-gear me-1"></i> Tiện ích</button>
                <ul class="dropdown-menu shadow-lg border-0 rounded-3 mt-2">
                    <li><a class="dropdown-item py-2" asp-action="History"><i class="fa-solid fa-clock-rotate-left me-2 text-info"></i> Lịch sử kho</a></li>
                    <li><a class="dropdown-item py-2" asp-action="Report"><i class="fa-solid fa-chart-pie me-2 text-warning"></i> Báo cáo NXT</a></li>
                    <li><a class="dropdown-item py-2" asp-action="StockTake"><i class="fa-solid fa-clipboard-check me-2 text-success"></i> Kiểm kê kho</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2" asp-action="ExportExcel"><i class="fa-solid fa-file-excel me-2 text-success"></i> Xuất Excel</a></li>
                </ul>
            </div>

            <div class="btn-group shadow-sm">
                <a asp-action="ImportExport" asp-route-type="Import" class="btn btn-success fw-bold py-2"><i class="fa-solid fa-arrow-down"></i></a>
                <a asp-action="ImportExport" asp-route-type="Export" class="btn btn-warning fw-bold py-2"><i class="fa-solid fa-arrow-up"></i></a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive" style="min-height: 500px;">
            <table class="table table-custom table-hover mb-0" id="warehouseTable">
                <thead>
                    <tr>
                        <th class="ps-4" width="80">Ảnh</th>
                        <th width="120">Mã VT</th>
                        <th>Tên Vật Tư</th>
                        <th class="text-center">ĐVT</th>
                        <th class="text-end">Tồn kho</th>
                        <th class="text-end pe-4">Giá vốn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Truyền CategoryId vào data-category-id để JS có thể lọc
                        <tr class="item-row" data-id="@item.Id" data-code="@item.Code" data-category-id="@item.CategoryId"
                            oncontextmenu="showContextMenu(event, @item.Id, '@item.Code', '@item.Name')">

                            <td class="ps-4">
                                <div class="item-img-box shadow-sm" onclick="showImage('@item.Image', '@item.Name')">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="/uploads/items/@item.Image" alt="img" loading="lazy">
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-image text-muted opacity-50"></i>
                                    }
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace px-2 py-1">@item.Code</span></td>
                            <td>
                                <div class="fw-bold text-dark search-name fs-6">@item.Name</div>
                                @if (!string.IsNullOrEmpty(item.Note))
                                {
                                    <div class="small text-muted fst-italic text-truncate" style="max-width: 250px;">@item.Note</div>
                                }
                                <div class="d-flex gap-2 mt-1">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-10 rounded-pill fw-normal" style="font-size: 10px;">
                                        @(item.WarehouseCategory?.Name ?? "Chưa phân loại")
                                    </span>
                                </div>
                            </td>
                            <td class="text-center text-muted fw-bold small">@item.Unit</td>
                            <td class="text-end">
                                @if (item.StockQuantity <= 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Hết hàng</span>
                                }
                                else if (item.StockQuantity <= 5)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">@item.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark fs-6">@item.StockQuantity.ToString("N2")</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-secondary pe-4">@item.CostPrice.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="noDataFound" class="text-center py-5 d-none">
                <i class="fa-solid fa-magnifying-glass fa-3x text-muted opacity-25 mb-3"></i>
                <h5 class="text-muted fw-bold">Không tìm thấy vật tư nào</h5>
                <p class="small text-muted">Thử chọn nhóm khác hoặc đổi từ khóa tìm kiếm</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-white border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-primary" id="modalTitle">Thông tin vật tư</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-3">
                <form id="itemForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="ItemId" name="Id" value="0" />

                    <div class="row g-4">
                        <div class="col-md-4 text-center">
                            <label class="form-label fw-bold small text-muted">Hình ảnh</label>
                            <div class="img-upload-preview mb-2" id="previewBox" onclick="document.getElementById('ImageFile').click()">
                                <div class="text-center text-muted"><i class="fa-solid fa-cloud-arrow-up fa-2x mb-2"></i><br><small>Click chọn ảnh</small></div>
                            </div>
                            <input type="file" id="ImageFile" name="ImageFile" class="d-none" accept="image/*" onchange="previewImage(this)">
                            <button type="button" class="btn btn-sm btn-outline-danger w-100 rounded-pill" onclick="clearImage()" id="btnClearImg" style="display:none">Xóa ảnh</button>
                        </div>
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="small fw-bold text-muted">Mã VT <span class="text-danger">*</span></label><input type="text" class="form-control fw-bold" id="Code" name="Code" required placeholder="VD: VT-001"></div>
                                <div class="col-md-6"><label class="small fw-bold text-muted">Đơn vị tính</label><input type="text" class="form-control" id="Unit" name="Unit" required placeholder="Cái, Kg..."></div>
                                <div class="col-12"><label class="small fw-bold text-muted">Tên vật tư <span class="text-danger">*</span></label><input type="text" class="form-control fw-bold" id="Name" name="Name" required></div>

                                <div class="col-12">
                                    <label class="small fw-bold text-muted">Nhóm hàng / Phân loại <span class="text-danger">*</span></label>
                                    <select class="form-select fw-bold border-primary shadow-sm" id="CategoryId" name="CategoryId" required>
                                        <option value="">-- Chọn nhóm hàng --</option>
                                        @foreach (var cat in dbCategories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-6"><label class="small fw-bold text-muted">Tồn đầu kỳ</label><input type="number" step="0.01" class="form-control" id="StockQuantity" name="StockQuantity" value="0"></div>
                                <div class="col-6"><label class="small fw-bold text-muted">Giá vốn</label><input type="number" class="form-control" id="CostPrice" name="CostPrice" value="0"></div>
                                <div class="col-12"><label class="small fw-bold text-muted">Ghi chú</label><textarea class="form-control" id="Note" name="Note" rows="2"></textarea></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0 pe-4 pb-4">
                <button type="button" class="btn btn-light fw-bold rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary fw-bold rounded-pill px-5 shadow-sm" onclick="saveItem()">Lưu dữ liệu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-light pb-3">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-tags me-2 text-primary"></i>Quản lý Nhóm Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light pt-0 p-4">
                <div class="input-group mb-3 shadow-sm">
                    <input type="text" id="newCategoryName" class="form-control fw-bold border-0" placeholder="Nhập tên nhóm hàng mới...">
                    <button class="btn btn-primary fw-bold px-3" onclick="addCategory()"><i class="fa-solid fa-plus me-1"></i> Thêm</button>
                </div>

                <div class="bg-white rounded-3 border overflow-hidden" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-hover mb-0 align-middle">
                        <tbody id="categoryTableBody">
                            @foreach (var cat in dbCategories)
                            {
                                <tr id="cat_row_@cat.Id">
                                    <td class="fw-bold ps-3 text-dark">@cat.Name</td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-sm text-danger bg-danger-subtle rounded-circle" onclick="deleteCategory(@cat.Id, '@cat.Name')" title="Xóa nhóm"><i class="fa-solid fa-trash-can"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="contextMenu" style="display:none; position:absolute; z-index:9999;" class="bg-white shadow-lg rounded-3 border p-1">
    <button class="dropdown-item py-2 px-3 rounded" onclick="triggerEdit()"><i class="fa-solid fa-pen text-primary me-2"></i> Sửa thông tin</button>
    <button class="dropdown-item py-2 px-3 rounded" onclick="triggerPrintLabel()"><i class="fa-solid fa-print text-dark me-2"></i> In Tem Mã</button>
    <div class="dropdown-divider"></div>
    <button class="dropdown-item py-2 px-3 rounded" onclick="copyCode()"><i class="fa-regular fa-copy text-secondary me-2"></i> Copy mã</button>
</div>

<div class="modal fade" id="imgModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-transparent border-0"><div class="text-end mb-2"><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><img src="" id="zoomImg" class="img-fluid rounded shadow-lg"></div></div></div>

<div class="modal fade" id="scannerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white"><h5 class="modal-title"><i class="fa-solid fa-camera me-2"></i>Quét Mã</h5><button type="button" class="btn-close btn-close-white" onclick="stopScanner()" data-bs-dismiss="modal"></button></div>
            <div class="modal-body p-0"><div id="reader" style="width: 100%;"></div></div>
            <div class="modal-footer justify-content-center bg-light"><small class="text-muted">Đưa mã vào khung hình để tìm kiếm</small></div>
        </div>
    </div>
</div>

<div class="modal fade" id="printLabelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light"><h5 class="modal-title fw-bold"><i class="fa-solid fa-tag me-2"></i>In Tem Kho</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body text-center" id="labelContent">
                <div class="border border-2 border-dark p-2 d-inline-block rounded" style="width: 320px; background: white;">
                    <h5 class="fw-bold mb-1 text-uppercase text-truncate" id="lblItemName">TÊN VẬT TƯ</h5>
                    <div class="text-muted small mb-2" id="lblItemCode">MÃ: VT-001</div>
                    <svg id="barcodeDisplay" style="width: 100%;"></svg>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button><button type="button" class="btn btn-primary fw-bold" onclick="printDiv('labelContent')"><i class="fa-solid fa-print me-2"></i>IN NGAY</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let selectedId = 0; let selectedCode = ""; let selectedName = "";
        let currentCategory = ""; // ID Tag đang chọn

        // 🔥 1. LOGIC LỌC BẢNG THEO TAG ID & TỪ KHÓA 🔥
        function filterCategory(categoryId, element) {
            currentCategory = categoryId;

            document.querySelectorAll('.cat-tag').forEach(el => el.classList.remove('active'));
            element.classList.add('active');

            filterTable();
        }

        function filterTable() {
            let input = document.getElementById("customSearch").value.toLowerCase();
            let rows = document.querySelectorAll(".item-row");
            let hasData = false;

            rows.forEach(row => {
                let name = row.querySelector(".search-name").innerText.toLowerCase();
                let code = row.getAttribute("data-code").toLowerCase();
                let catId = row.getAttribute("data-category-id");

                let matchText = name.includes(input) || code.includes(input);
                let matchCat = currentCategory === "" || catId === currentCategory;

                if (matchText && matchCat) {
                    row.style.display = "";
                    hasData = true;
                } else {
                    row.style.display = "none";
                }
            });

            document.getElementById("noDataFound").classList.toggle("d-none", hasData);
        }

        // 🔥 2. LOGIC QUẢN LÝ DANH MỤC QUA AJAX 🔥
        function openCategoryManager() { $('#categoryModal').modal('show'); }

        function addCategory() {
            let name = $('#newCategoryName').val();
            if (!name) { Swal.fire('Lỗi', 'Vui lòng nhập tên nhóm', 'warning'); return; }

            $.post('/Warehouse/AddCategory', { name: name }, function (res) {
                if (res.success) {
                    $('#newCategoryName').val('');
                    // Thêm vào bảng quản lý
                    $('#categoryTableBody').append(`<tr id="cat_row_${res.id}"><td class="fw-bold ps-3">${res.name}</td><td class="text-end pe-3"><button class="btn btn-sm text-danger bg-danger-subtle rounded-circle" onclick="deleteCategory(${res.id}, '${res.name}')"><i class="fa-solid fa-trash-can"></i></button></td></tr>`);
                    // Thêm vào Dropdown Form thêm vật tư
                    $('#CategoryId').append(new Option(res.name, res.id));
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Đã thêm nhóm mới', showConfirmButton: false, timer: 1500 });
                    setTimeout(() => location.reload(), 1500); // Reload lại trang để vẽ lại thanh Tags
                } else { Swal.fire('Lỗi', res.message, 'error'); }
            });
        }

        function deleteCategory(id, name) {
            Swal.fire({
                title: 'Xóa nhóm ' + name + '?',
                text: "Hệ thống sẽ chặn thao tác nếu nhóm này đang có vật tư.",
                icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Xóa ngay', cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Warehouse/DeleteCategory', { id: id }, function (res) {
                        if (res.success) {
                            $(`#cat_row_${id}`).remove();
                            $(`#CategoryId option[value='${id}']`).remove();
                            Swal.fire('Đã xóa!', 'Xóa nhóm hàng thành công.', 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else { Swal.fire('Không thể xóa', res.message, 'error'); }
                    });
                }
            });
        }

        // --- CÁC HÀM CŨ GIỮ NGUYÊN ---
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#previewBox').css('background-image', 'url(' + e.target.result + ')').html('');
                    $('#btnClearImg').show();
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        function clearImage() {
            $('#ImageFile').val('');
            $('#previewBox').css('background-image', 'none').html('<div class="text-center text-muted"><i class="fa-solid fa-cloud-arrow-up fa-2x mb-2"></i><br><small>Click chọn ảnh</small></div>');
            $('#btnClearImg').hide();
        }
        function showImage(src, title) {
            if (!src) return;
            $('#zoomImg').attr('src', '/uploads/items/' + src);
            $('#imgModal').modal('show');
        }

        // Context Menu
        function showContextMenu(e, id, code, name) {
            e.preventDefault();
            selectedId = id; selectedCode = code; selectedName = name;
            $('#contextMenu').css({ display: 'block', left: e.pageX, top: e.pageY });
        }
        $(document).on('click', function () { $('#contextMenu').hide(); });
        function triggerEdit() { if (selectedId > 0) openModal(selectedId); }
        function copyCode() {
            navigator.clipboard.writeText(selectedCode);
            Swal.fire({ icon: 'success', title: 'Đã copy: ' + selectedCode, toast: true, position: 'top-end', showConfirmButton: false, timer: 1000 });
        }

        // In Tem
        function triggerPrintLabel() {
            document.getElementById('lblItemName').innerText = selectedName;
            document.getElementById('lblItemCode').innerText = "MÃ: " + selectedCode;
            JsBarcode("#barcodeDisplay", selectedCode, { format: "CODE128", lineColor: "#000", width: 2, height: 50, displayValue: true, fontSize: 14 });
            new bootstrap.Modal(document.getElementById('printLabelModal')).show();
        }
        function printDiv(divId) {
            var content = document.getElementById(divId).innerHTML;
            var myWindow = window.open('', '', 'width=600,height=600');
            myWindow.document.write('<html><head><title>Print Label</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"></head><body class="text-center pt-5">' + content + '</body></html>');
            myWindow.document.close(); myWindow.focus();
            setTimeout(function () { myWindow.print(); myWindow.close(); }, 500);
        }

        // Scanner
        let html5QrcodeScanner;
        function startScanner() {
            const modal = new bootstrap.Modal(document.getElementById('scannerModal')); modal.show();
            html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: { width: 250, height: 250 } }, false);
            html5QrcodeScanner.render(onScanSuccess, onScanFailure);
        }
        function onScanSuccess(decodedText, decodedResult) {
            stopScanner();
            bootstrap.Modal.getInstance(document.getElementById('scannerModal')).hide();
            new Audio('https://media.geeksforgeeks.org/wp-content/uploads/20190531135120/beep.mp3').play();
            Swal.fire({ icon: 'success', title: 'Đã tìm thấy mã!', text: decodedText, timer: 800, showConfirmButton: false }).then(() => {
                let searchInput = document.getElementById("customSearch");
                searchInput.value = decodedText;
                filterTable();
            });
        }
        function onScanFailure(error) { }
        function stopScanner() { if (html5QrcodeScanner) { html5QrcodeScanner.clear().catch(error => console.error("Failed to clear scanner. ", error)); } }

        // Save & Edit Data
        function saveItem() {
            var form = $('#itemForm')[0];
            if (!form.checkValidity()) { form.reportValidity(); return; }
            var formData = new FormData(form);
            var id = $('#ItemId').val();
            var url = id == 0 ? '/Warehouse/Create' : '/Warehouse/Edit';
            Swal.fire({ title: 'Đang xử lý...', didOpen: () => Swal.showLoading() });
            $.ajax({
                url: url, type: 'POST', data: formData, contentType: false, processData: false,
                success: function (res) {
                    if (res.success) Swal.fire("Thành công", res.message, "success").then(() => location.reload());
                    else Swal.fire("Lỗi", res.message, "error");
                },
                error: function () { Swal.fire("Lỗi", "Không thể kết nối server", "error"); }
            });
        }

        function openModal(id) {
            $('#itemForm')[0].reset();
            clearImage(); $('#ItemId').val(id);
            if (id > 0) {
                $('#modalTitle').text("Cập nhật vật tư");
                $('#StockQuantity').prop('disabled', true); $('#CostPrice').prop('disabled', true);

                $.get('/Warehouse/GetJson/' + id, function (data) {
                    $('#Code').val(data.code);
                    $('#Name').val(data.name);
                    $('#CategoryId').val(data.categoryId); // Load lại Select ID
                    $('#Unit').val(data.unit);
                    $('#StockQuantity').val(data.stockQuantity);
                    $('#CostPrice').val(data.costPrice);
                    $('#Note').val(data.note);
                    if (data.image) {
                        $('#previewBox').css('background-image', 'url(/uploads/items/' + data.image + ')').html('');
                        $('#btnClearImg').show();
                    }
                    $('#itemModal').modal('show');
                });
            } else {
                $('#modalTitle').text("Thêm vật tư mới");
                $('#StockQuantity').prop('disabled', false); $('#CostPrice').prop('disabled', false);
                $('#itemModal').modal('show');
            }
        }
    </script>
}