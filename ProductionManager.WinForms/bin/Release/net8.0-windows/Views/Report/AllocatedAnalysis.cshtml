@* @model ProductionApp.Web.Models.ViewModels.AllocatedReportVM
@{
    ViewData["Title"] = $"Phân bổ Lợi nhuận - Tháng {Model.Month}/{Model.Year}";
}

<style>
    .report-bg {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding-bottom: 50px;
        font-family: 'Segoe UI', sans-serif;
    }

    /* CSS THANH SWITCH */
    .nav-pill-switch {
        background: #fff;
        border-radius: 50px;
        padding: 4px;
        display: inline-flex;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        border: 1px solid #e9ecef;
    }

        .nav-pill-switch .btn {
            border-radius: 50px;
            padding: 6px 20px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s;
            border: none;
            color: #6c757d;
            min-width: 160px;
        }

            .nav-pill-switch .btn:hover {
                background: #f8f9fa;
                color: #000;
            }

            .nav-pill-switch .btn.active {
                background-color: #6610f2; /* Màu tím đặc trưng cho trang này */
                color: white;
                box-shadow: 0 2px 4px rgba(102, 16, 242, 0.3);
            }

    /* Card & Table Styles */
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .table-alloc th {
        background-color: #f8f9fa;
        font-size: 0.85rem;
        color: #6c757d;
        text-transform: uppercase;
    }

    .table-alloc td {
        font-size: 0.9rem;
        vertical-align: middle;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .report-bg {
            background: white;
        }
    }
</style>

<div class="report-bg">
    <div class="container-fluid px-4 pt-4">

        <div class="d-flex justify-content-center mb-5 no-print">
            <div class="nav-pill-switch">
                <a href="@Url.Action("Index", "Report")" class="btn">
                    <i class="fa-solid fa-chart-pie me-2"></i>Hiệu quả SXKD
                </a>
                <a href="@Url.Action("CashFlow", "Report")" class="btn">
                    <i class="fa-solid fa-money-bill-trend-up me-2"></i>Dòng tiền Thực tế
                </a>
                <a href="javascript:void(0)" class="btn active">
                    <i class="fa-solid fa-scale-balanced me-2"></i>Phân bổ Lợi nhuận
                </a>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-0">PHÂN BỔ DOANH THU & CHI PHÍ</h4>
                <small class="text-muted">Ghi nhận lợi nhuận kế toán (Accrual Basis) theo tháng được chọn</small>
            </div>
            <div class="d-flex gap-2 bg-white p-2 rounded-pill shadow-sm border no-print">
                <form method="get" class="d-flex gap-2">
                    <select name="month" class="form-select form-select-sm border-0 fw-bold rounded-pill text-center bg-light" style="width: 100px;">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(Model.Month==i)">Tháng @i</option>
                        }
                    </select>
                    <select name="year" class="form-select form-select-sm border-0 fw-bold rounded-pill text-center bg-light" style="width: 80px;">
                        @for (int i = 2023; i <= 2030; i++)
                        {
                            <option value="@i" selected="@(Model.Year==i)">@i</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-3 rounded-pill">Xem</button>
                </form>

                <div class="vr mx-1"></div> <form asp-action="ExportExcel" method="post" class="d-flex">
                    <input type="hidden" name="month" value="@Model.Month" />
                    <input type="hidden" name="year" value="@Model.Year" />
                    <button type="submit" class="btn btn-success btn-sm fw-bold px-3 rounded-pill" title="Xuất tất cả 4 loại báo cáo">
                        <i class="fa-solid fa-file-excel me-1"></i> Xuất Excel
                    </button>
                </form>
            </div>
            <form method="get" class="d-flex gap-2 bg-white p-2 rounded-pill shadow-sm border no-print">
                <select name="month" class="form-select form-select-sm border-0 fw-bold rounded-pill text-center bg-light" style="width: 100px;">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(Model.Month==i)">Tháng @i</option>
                    }
                </select>
                <select name="year" class="form-select form-select-sm border-0 fw-bold rounded-pill text-center bg-light" style="width: 80px;">
                    @for (int i = 2023; i <= 2030; i++)
                    {
                        <option value="@i" selected="@(Model.Year==i)">@i</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary btn-sm fw-bold px-3 rounded-pill">Xem</button>
            </form>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 shadow-sm border-start border-4 border-primary">
                            <div class="text-primary small fw-bold text-uppercase">Doanh thu Ghi nhận</div>
                            <h4 class="fw-bold text-dark mb-0">@Model.TotalRevenueAllocated.ToString("N0")</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 shadow-sm border-start border-4 border-danger">
                            <div class="text-danger small fw-bold text-uppercase">Chi phí Ghi nhận</div>
                            <h4 class="fw-bold text-dark mb-0">@Model.TotalCostAllocated.ToString("N0")</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 shadow-sm border-start border-4 @(Model.NetProfit >=0 ? "border-success":"border-warning")">
                            <div class="@(Model.NetProfit >=0 ? "text-success":"text-dark") small fw-bold text-uppercase">Lợi nhuận Ghi nhận</div>
                            <h4 class="fw-bold @(Model.NetProfit >=0 ? "text-success":"text-dark") mb-0">
                                @(Model.NetProfit >= 0 ? "+" : "")@Model.NetProfit.ToString("N0")
                            </h4>
                        </div>
                    </div>
                </div>

                <div class="glass-card h-100">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold m-0 text-dark"><i class="fa-solid fa-list-check me-2 text-secondary"></i>CHI TIẾT KHOẢN MỤC ĐÃ PHÂN BỔ</h6>
                        <span class="badge bg-light text-dark border">@Model.AllocatedList.Count khoản mục</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-alloc table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3">Ngày CT</th>
                                    <th>Số Phiếu</th>
                                    <th>Diễn giải</th>
                                    <th class="text-center">Loại</th>
                                    <th class="text-end">Số tiền Phân bổ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AllocatedList.Any())
                                {
                                    foreach (var item in Model.AllocatedList)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small">@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                                            <td class="fw-bold text-primary small">@item.VoucherCode</td>
                                            <td class="text-truncate" style="max-width: 200px;" title="@item.Description">
                                                @item.Description
                                                @if (!string.IsNullOrEmpty(item.Note))
                                                {
                                                    <br />

                                                    <small class="text-muted fst-italic">(@item.Note)</small>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @(item.Type == "Thu" ? "bg-success" : "bg-danger") bg-opacity-10 text-@(item.Type == "Thu" ? "success" : "danger") border border-@(item.Type == "Thu" ? "success" : "danger")">@item.Type</span>
                                            </td>
                                            <td class="text-end fw-bold text-dark">@item.Amount.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center py-5 text-muted fst-italic">Chưa có dữ liệu phân bổ cho tháng này.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-header bg-secondary text-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold m-0 small text-uppercase"><i class="fa-solid fa-inbox me-2"></i>Kho chờ phân bổ</h6>
                        <span class="badge bg-white text-dark rounded-pill">@Model.UnallocatedItems.Count</span>
                    </div>
                    <div class="card-body p-2 overflow-auto" style="max-height: 700px;">
                        <div class="alert alert-light border small mb-2 text-center text-muted">
                            <i class="fa-solid fa-circle-info me-1"></i> Các khoản thu/chi phát sinh trước tháng @Model.Month/@Model.Year nhưng chưa được phân bổ hết.
                        </div>

                        @foreach (var item in Model.UnallocatedItems)
                        {
                            var borderClass = item.Type == "Thu" ? "border-success" : "border-danger";
                            var textClass = item.Type == "Thu" ? "text-success" : "text-danger";

                            <div class="card mb-2 shadow-sm border-start border-3 @borderClass">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-bold small @textClass">@item.VoucherCode (@item.Type)</span>
                                        <small class="text-muted" style="font-size: 0.75rem;">@item.TransactionDate.ToString("dd/MM/yy")</small>
                                    </div>
                                    <div class="small text-dark mb-2 text-truncate">@item.Description</div>

                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <div>
                                            <div class="text-muted" style="font-size: 10px;">Tổng gốc: @item.TotalAmount.ToString("N0")</div>
                                            <div class="fw-bold text-dark small">Còn: <span class="text-primary">@item.RemainingAmount.ToString("N0")</span></div>
                                        </div>
                                        <button onclick="openAllocateModal(@item.EntryId, '@item.VoucherCode', @item.RemainingAmount)" class="btn btn-sm btn-outline-dark fw-bold py-1 px-2" style="font-size: 11px;">
                                            <i class="fa-solid fa-arrow-left me-1"></i> Chọn
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!Model.UnallocatedItems.Any())
                        {
                            <div class="text-center py-5 text-muted small opacity-50">
                                <i class="fa-solid fa-box-open fs-1 mb-2"></i><br>Không có khoản nào chờ phân bổ.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="allocModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-light py-2">
                <h6 class="modal-title fw-bold">Phân bổ <span id="lblVoucher"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdEntryId" />
                <div class="mb-3">
                    <label class="small fw-bold text-muted">Vào tháng @Model.Month/@Model.Year</label>
                    <div class="input-group">
                        <input type="number" id="txtAmount" class="form-control fw-bold" placeholder="Nhập số tiền..." />
                        <span class="input-group-text small">VNĐ</span>
                    </div>
                    <div class="form-text text-end small">Tối đa: <span id="lblMax" class="fw-bold text-primary"></span></div>
                </div>
                <button onclick="submitAllocation()" class="btn btn-primary w-100 fw-bold">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    let currentMax = 0;

    function openAllocateModal(id, code, max) {
        document.getElementById('hdEntryId').value = id;
        document.getElementById('lblVoucher').innerText = code;
        document.getElementById('lblMax').innerText = new Intl.NumberFormat('vi-VN').format(max);
        document.getElementById('txtAmount').value = max;
        currentMax = max;
        new bootstrap.Modal(document.getElementById('allocModal')).show();
    }

    function submitAllocation() {
        let amt = parseFloat(document.getElementById('txtAmount').value);
        let id = document.getElementById('hdEntryId').value;

        if (!amt || amt <= 0) { alert('Nhập số tiền hợp lệ'); return; }
        if (amt > currentMax) { alert('Vượt quá số dư còn lại'); return; }

        $.post('/Report/SaveAllocation', {
            entryId: id,
            month: @Model.Month,
            year: @Model.Year,
            amount: amt
        }, function (res) {
            if (res.success) {
                location.reload();
            } else {
                Swal.fire('Lỗi', res.msg, 'error');
            }
        });
    }
</script> *@

@model ProductionApp.Web.Controllers.MonthlyPnLViewModel
@{
    ViewData["Title"] = $"Báo cáo P&L Tháng {Model.Month}/{Model.Year}";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
    /* UI Dashboard */
    body { background-color: #f4f6f9; font-family: 'Segoe UI', sans-serif; color: #2d3748; }
    .report-card { background: #fff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #edf2f7; margin-bottom: 24px; overflow: hidden; }
    .card-header-custom { background: #fff; padding: 16px 24px; border-bottom: 2px solid #edf2f7; font-weight: 700; font-size: 1.1rem; color: #1a202c; }
    
    /* Bảng Báo cáo Tài chính */
    .table-pnl { width: 100%; border-collapse: collapse; }
    .table-pnl th { text-align: right; padding: 12px 20px; font-size: 0.85rem; color: #718096; text-transform: uppercase; border-bottom: 1px solid #edf2f7; }
    .table-pnl th:first-child { text-align: left; }
    .table-pnl td { padding: 14px 20px; border-bottom: 1px solid #edf2f7; font-size: 0.95rem; }
    
    /* Phân cấp dòng */
    .row-level-1 { font-weight: 700; background-color: #f8fafc; color: #2d3748; }
    .row-level-2 { padding-left: 40px !important; color: #4a5568; }
    .row-total { font-weight: 800; font-size: 1.1rem; background-color: #ebf8ff; color: #2b6cb0; }
    .row-net-profit { font-weight: 800; font-size: 1.2rem; background-color: #2b6cb0; color: #fff !important; }
    .row-net-profit td { color: #fff !important; }
    
    .text-money { text-align: right; font-family: 'Courier New', Courier, monospace; letter-spacing: -0.5px; }
    .text-red { color: #e53e3e; }
    .text-green { color: #38a169; }

    /* --- CẤU HÌNH XUẤT PDF BẰNG TRÌNH DUYỆT --- */
    @@media print {
        body { background: #fff !important; color: #000; }
        .no-print { display: none !important; }
        .report-card { box-shadow: none; border: none; }
        .table-pnl th { color: #000; border-bottom: 2px solid #000; }
        .table-pnl td { border-bottom: 1px solid #ddd; }
        .row-level-1 { background-color: #f0f0f0 !important; -webkit-print-color-adjust: exact; }
        .row-total { background-color: #e0e0e0 !important; color: #000 !important; -webkit-print-color-adjust: exact; }
        .row-net-profit { background-color: #000 !important; color: #fff !important; -webkit-print-color-adjust: exact; }
        @@page { margin: 1.5cm; size: A4 portrait; }
    }
</style>

<div class="container-fluid py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h3 class="fw-bold mb-1"><i class="fa-solid fa-chart-pie text-primary me-2"></i>BÁO CÁO P&L (KẾT QUẢ KINH DOANH)</h3>
            <p class="text-muted mb-0">Hệ thống phân tích lợi nhuận chuẩn quản trị</p>
        </div>
        
        <form method="get" class="d-flex gap-3 align-items-center bg-white p-2 rounded-pill shadow-sm border">
            <select name="month" class="form-select border-0 fw-bold bg-transparent">
                @for(int i=1; i<=12; i++){ <option value="@i" selected="@(Model.Month == i)">Tháng @i</option> }
            </select>
            <div class="vr"></div>
            <select name="year" class="form-select border-0 fw-bold bg-transparent">
                @for(int i=DateTime.Now.Year-2; i<=DateTime.Now.Year; i++){ <option value="@i" selected="@(Model.Year == i)">Năm @i</option> }
            </select>
            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold"><i class="fa-solid fa-filter me-1"></i> Lọc</button>
        </form>

        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-danger fw-bold rounded-pill shadow-sm px-4">
                <i class="fa-solid fa-file-pdf me-2"></i>Xuất PDF
            </button>
            <a href="@Url.Action("ExportExcel", new { month = Model.Month, year = Model.Year })" class="btn btn-success fw-bold rounded-pill shadow-sm px-4">
                <i class="fa-solid fa-file-excel me-2"></i>Xuất Excel
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="report-card p-4 border-bottom border-primary border-4 h-100">
                <div class="text-muted small fw-bold text-uppercase mb-2">DOANH THU THUẦN</div>
                <div class="fs-3 fw-bold text-primary text-money">@Model.NetRevenue.ToString("N0") ₫</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="report-card p-4 border-bottom border-success border-4 h-100">
                <div class="text-muted small fw-bold text-uppercase mb-2">LỢI NHUẬN GỘP</div>
                <div class="fs-3 fw-bold text-success text-money">@Model.GrossProfit.ToString("N0") ₫</div>
                <div class="small text-muted text-end mt-1">Biên LN: <span class="fw-bold text-dark">@Model.GrossMargin.ToString("0.0")%</span></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="report-card p-4 border-bottom border-warning border-4 h-100">
                <div class="text-muted small fw-bold text-uppercase mb-2">CHI PHÍ VẬN HÀNH (OPEX)</div>
                <div class="fs-3 fw-bold text-warning text-money">@Model.TotalOpex.ToString("N0") ₫</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="report-card p-4 border-bottom border-dark border-4 h-100 bg-dark text-white">
                <div class="text-gray-300 small fw-bold text-uppercase mb-2">LỢI NHUẬN RÒNG (NET PROFIT)</div>
                <div class="fs-3 fw-bold text-white text-money">@Model.NetProfit.ToString("N0") ₫</div>
                <div class="small text-gray-400 text-end mt-1">Biên LN Ròng: <span class="fw-bold text-white">@Model.NetMargin.ToString("0.0")%</span></div>
            </div>
        </div>
    </div>

    <div class="report-card">
        <div class="card-header-custom d-flex justify-content-between">
            <span>BẢNG KẾT QUẢ HOẠT ĐỘNG KINH DOANH CHI TIẾT</span>
            <span class="text-muted fw-normal">Đơn vị tính: VNĐ</span>
        </div>
        <div class="card-body p-0">
            <table class="table-pnl">
                <thead>
                    <tr>
                        <th width="50%">CÁC CHỈ TIÊU TÀI CHÍNH</th>
                        <th width="25%">SỐ TIỀN THỰC TẾ</th>
                        <th width="25%">% DOANH THU</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="row-level-1">
                        <td>I. DOANH THU KINH DOANH</td>
                        <td class="text-money">@Model.TotalGrossRevenue.ToString("N0")</td>
                        <td class="text-money">-</td>
                    </tr>
                    <tr>
                        <td class="row-level-2"><i class="fa-solid fa-minus text-muted me-2"></i>Thuế VAT phải nộp</td>
                        <td class="text-money text-red">(@Model.VatPayable.ToString("N0"))</td>
                        <td class="text-money">-</td>
                    </tr>
                    <tr class="row-total">
                        <td>DOANH THU THUẦN (NET REVENUE)</td>
                        <td class="text-money">@Model.NetRevenue.ToString("N0")</td>
                        <td class="text-money">100.0%</td>
                    </tr>

                    <tr class="row-level-1">
                        <td>II. GIÁ VỐN HÀNG BÁN (VẬT TƯ)</td>
                        <td class="text-money text-red">(@Model.MaterialConsumed.ToString("N0"))</td>
                        <td class="text-money text-red">@((Model.NetRevenue > 0 ? (Model.MaterialConsumed / Model.NetRevenue * 100) : 0).ToString("0.0"))%</td>
                    </tr>
                    <tr>
                        <td class="row-level-2"><i class="fa-solid fa-arrow-right text-muted me-2"></i>Tiền mua vật tư trong kỳ</td>
                        <td class="text-money text-muted">@Model.TotalMaterialPurchased.ToString("N0")</td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="row-level-2"><i class="fa-solid fa-box text-muted me-2"></i>Tồn kho cuối kỳ (Chưa dùng)</td>
                        <td class="text-money text-green">@Model.MaterialRemaining.ToString("N0")</td>
                        <td></td>
                    </tr>
                    
                    <tr class="row-total">
                        <td>LỢI NHUẬN GỘP (GROSS PROFIT)</td>
                        <td class="text-money text-green">@Model.GrossProfit.ToString("N0")</td>
                        <td class="text-money text-green">@Model.GrossMargin.ToString("0.0")%</td>
                    </tr>

                    <tr class="row-level-1">
                        <td>III. CHI PHÍ VẬN HÀNH (OPEX)</td>
                        <td class="text-money text-red">(@Model.TotalOpex.ToString("N0"))</td>
                        <td class="text-money text-red">@((Model.NetRevenue > 0 ? (Model.TotalOpex / Model.NetRevenue * 100) : 0).ToString("0.0"))%</td>
                    </tr>
                    @foreach (var item in Model.OpexGroups)
                    {
                        <tr>
                            <td class="row-level-2"><i class="fa-solid fa-money-bill-wave text-muted me-2"></i>@item.Key</td>
                            <td class="text-money text-red">(@item.Value.ToString("N0"))</td>
                            <td class="text-money">@((Model.NetRevenue > 0 ? (item.Value / Model.NetRevenue * 100) : 0).ToString("0.0"))%</td>
                        </tr>
                    }

                    <tr class="row-net-profit mt-4">
                        <td class="py-4">LỢI NHUẬN RÒNG (NET PROFIT)</td>
                        <td class="text-money py-4">@Model.NetProfit.ToString("N0")</td>
                        <td class="text-money py-4">@Model.NetMargin.ToString("0.0")%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>