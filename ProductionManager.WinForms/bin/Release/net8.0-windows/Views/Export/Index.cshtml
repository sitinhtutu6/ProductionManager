@using ProductionManager.Data
@model IEnumerable<ExportShipment>

@{
    ViewData["Title"] = "Quản lý Giao hàng & Logistics";

    var total = Model.Count();
    var completed = Model.Count(x => x.ProgressPercent == 100);
    var processing = total - completed;

    string GetSortUrl(string sortOrder)
    {
        return Url.Action("Index", new
        {
            sortOrder = sortOrder,
            searchString = ViewData["CurrentSearch"],
            fromDate = ViewData["FromDate"],
            toDate = ViewData["ToDate"],
            statusFilter = ViewData["StatusFilter"]
        });
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    /* UI ERP CHUẨN MỚI: CLEAN & WHITE */
    body {
        background-color: #f4f7f6;
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .card-custom {
        background: #ffffff;
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-custom:hover {
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        }

    .btn-action-main {
        border-radius: 8px;
        font-weight: 700;
        padding: 8px 24px;
    }

    /* Bảng dữ liệu chuyên nghiệp */
    .table-erp thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding: 14px 16px;
    }

    .table-erp tbody tr {
        transition: background-color 0.2s;
        border-bottom: 1px solid #f1f5f9;
        cursor: context-menu; /* Báo hiệu cho người dùng có thể click chuột phải */
    }

        .table-erp tbody tr:hover {
            background-color: #f8fafc;
        }

    .table-erp td {
        padding: 12px 16px;
        vertical-align: middle;
        font-size: 0.9rem;
    }

    /* Context Menu */
    #contextMenu {
        display: none;
        position: absolute;
        z-index: 1050;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        border: 1px solid #e2e8f0;
        width: 230px;
        overflow: hidden;
    }

    .ctx-item {
        padding: 10px 20px;
        color: #334155;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        transition: 0.2s;
        text-decoration: none;
    }

        .ctx-item i {
            width: 24px;
        }

        .ctx-item:hover {
            background-color: #f1f5f9;
            color: #2563eb;
        }

        .ctx-item.delete:hover {
            background-color: #fef2f2;
            color: #dc2626;
        }

    .ctx-divider {
        height: 1px;
        background: #e2e8f0;
        margin: 4px 0;
    }

    .sort-active {
        color: #2563eb;
        font-weight: bold;
    }

    .flatpickr-input {
        background-color: white !important;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="fa-solid fa-layer-group text-primary me-2"></i>ĐIỀU PHỐI LOGISTICS
            </h3>
            <span class="text-muted small">Quản lý tổng quan tiến độ giao hàng, phương tiện và kho xuất.</span>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div class="dropdown">
                <button class="btn btn-light bg-white border fw-bold shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" style="padding: 8px 16px; border-radius: 8px;">
                    <i class="fa-solid fa-boxes-stacked text-secondary me-1"></i> Nghiệp vụ Kho
                </button>
                <ul class="dropdown-menu shadow border-0" style="border-radius: 8px;">
                    <li><a class="dropdown-item fw-bold text-dark py-2" asp-controller="Shipment" asp-action="Index"><i class="fa-solid fa-list-check me-2 text-primary"></i>Lịch sử Phiếu Xuất</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item fw-bold text-danger py-2" asp-controller="Shipment" asp-action="CreateReturn"><i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Nhận Hàng Lỗi (Thu hồi)</a></li>
                    <li><a class="dropdown-item fw-bold text-dark py-2" asp-controller="Shipment" asp-action="ReturnHistory"><i class="fa-solid fa-clock-rotate-left me-2 text-warning"></i>Lịch sử Hàng Lỗi</a></li>
                </ul>
            </div>

            <a asp-action="Create" class="btn btn-primary btn-action-main shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> Tạo Chuyến Mới
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card-custom p-3 border-start border-4 border-primary h-100 d-flex align-items-center justify-content-between">
                <div>
                    <div class="small fw-bold text-uppercase text-muted mb-1">📦 Tổng Số Chuyến</div>
                    <h2 class="mb-0 fw-bold text-primary">@total</h2>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3"><i class="fa-solid fa-truck-fast fa-lg"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom p-3 border-start border-4 border-warning h-100 d-flex align-items-center justify-content-between">
                <div>
                    <div class="small fw-bold text-uppercase text-muted mb-1">⏳ Đang Vận Hành</div>
                    <h2 class="mb-0 fw-bold text-warning">@processing</h2>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3"><i class="fa-solid fa-spinner fa-spin-pulse fa-lg"></i></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom p-3 border-start border-4 border-success h-100 d-flex align-items-center justify-content-between">
                <div>
                    <div class="small fw-bold text-uppercase text-muted mb-1">✅ Đã Hoàn Thành</div>
                    <h2 class="mb-0 fw-bold text-success">@completed</h2>
                </div>
                <div class="bg-success bg-opacity-10 text-success rounded-circle p-3"><i class="fa-solid fa-check-double fa-lg"></i></div>
            </div>
        </div>
    </div>

    <div class="card-custom p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label class="form-label small fw-bold text-secondary mb-1">🔍 Tìm kiếm</label>
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control form-control-sm bg-light border-0" placeholder="Mã lô, biển số xe, tên khách...">
            </div>
            <div class="col-lg-2">
                <label class="form-label small fw-bold text-secondary mb-1">📅 Từ ngày</label>
                <input type="text" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-control-sm bg-light border-0 datepicker" placeholder="Chọn ngày">
            </div>
            <div class="col-lg-2">
                <label class="form-label small fw-bold text-secondary mb-1">📅 Đến ngày</label>
                <input type="text" name="toDate" value="@ViewData["ToDate"]" class="form-control form-control-sm bg-light border-0 datepicker" placeholder="Chọn ngày">
            </div>
            <div class="col-lg-2">
                <label class="form-label small fw-bold text-secondary mb-1">⚡ Trạng thái</label>
                <select name="statusFilter" class="form-select form-select-sm bg-light border-0 fw-bold">
                    <option value="">📂 Tất cả</option>
                    <option value="Running" selected="@((string)ViewData["StatusFilter"] == "Running")">🏃 Đang chạy</option>
                    <option value="Done" selected="@((string)ViewData["StatusFilter"] == "Done")">🏁 Đã xong</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark btn-sm fw-bold flex-grow-1 shadow-sm"><i class="fa-solid fa-filter me-1"></i> Lọc</button>
                <button type="submit" formaction="@Url.Action("ExportToExcel")" class="btn btn-success btn-sm fw-bold shadow-sm" title="Xuất báo cáo Excel"><i class="fa-solid fa-file-excel"></i></button>
                <a asp-action="Index" class="btn btn-light btn-sm border shadow-sm" title="Xóa lọc"><i class="fa-solid fa-rotate-right"></i></a>
            </div>
        </form>
    </div>

    <div class="card-custom overflow-hidden">
        <div class="table-responsive">
            <table class="table table-erp mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">
                            <a href="@GetSortUrl((string)ViewData["CodeSort"])" class="text-decoration-none text-secondary">CHUYẾN / KHÁCH HÀNG <i class="fa-solid fa-sort ms-1 @(ViewData["CodeSort"]?.ToString() == "" ? "sort-active" : "")"></i></a>
                        </th>
                        <th style="width: 25%;">
                            <a href="@GetSortUrl((string)ViewData["DateSort"])" class="text-decoration-none text-secondary">PHƯƠNG TIỆN & LỊCH TRÌNH <i class="fa-solid fa-sort ms-1 @(ViewData["DateSort"]?.ToString() == "Date" ? "sort-active" : "")"></i></a>
                        </th>
                        <th style="width: 20%;">
                            <a href="@GetSortUrl((string)ViewData["ProgressSort"])" class="text-decoration-none text-secondary">TIẾN ĐỘ <i class="fa-solid fa-sort ms-1 @(ViewData["ProgressSort"]?.ToString() == "Progress" ? "sort-active" : "")"></i></a>
                        </th>
                        <th class="text-center">TRẠNG THÁI</th>
                        <th class="text-center pe-4" width="80"><i class="fa-solid fa-ellipsis"></i></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="context-row" data-id="@item.Id" data-code="@item.ShipmentCode" onclick="window.location='@Url.Action("Details", new { id = item.Id })'">

                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded bg-light p-2 me-3 text-primary border">
                                        <i class="fa-solid @(item.TransportType == TransportType.Container ? "fa-ship" : "fa-truck-fast") fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@item.ShipmentCode</div>
                                        <div class="text-muted small"><i class="fa-regular fa-building me-1"></i> @item.Customer?.CompanyName</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="mb-1">
                                    @if (item.TransportType == TransportType.Truck)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                            <i class="fa-solid fa-id-card me-1"></i>
                                            @(string.IsNullOrEmpty(item.LicensePlate) ? "Chưa gắn xe" : item.LicensePlate)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info">
                                            <i class="fa-solid fa-bookmark me-1"></i>
                                            @(string.IsNullOrEmpty(item.BookingNumber) ? "Chưa Booking" : item.BookingNumber)
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.LicensePlate))
                                        {
                                            <span class="small fw-bold text-dark ms-1">Cont: @item.LicensePlate</span>
                                        }
                                    }
                                </div>

                                <div class="small text-muted fw-bold mt-1">
                                    <i class="fa-regular fa-calendar-check me-1"></i>
                                    @if (item.ETD.HasValue)
                                    {
                                        <span>@item.ETD.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="fst-italic opacity-50">-- Chưa chốt ngày --</span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-bold text-primary">@GetStepEmoji(item.CurrentStep)</span>
                                    <span class="fw-bold">@item.ProgressPercent%</span>
                                </div>
                                <div class="progress bg-light border" style="height: 6px;">
                                    <div class="progress-bar" style="width: @item.ProgressPercent%; background: linear-gradient(90deg, #3b82f6, #2563eb);"></div>
                                </div>
                            </td>

                            <td class="text-center">
                                @if (item.ProgressPercent == 100)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill"><i class="fa-solid fa-check me-1"></i> Xong</span>
                                }
                                else if (item.ProgressPercent == 0)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">Mới tạo</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill"><i class="fa-solid fa-truck-fast me-1"></i> Đang chạy</span>
                                }
                            </td>

                            <td class="text-center pe-4">
                                <button class="btn btn-sm btn-light text-muted rounded-circle shadow-sm" title="Nhấn chuột phải để xem thêm"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted fst-italic">Không tìm thấy dữ liệu nào phù hợp.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="contextMenu">
    <div class="p-2 border-bottom bg-light small fw-bold text-muted ps-3" id="ctxTitle">TÙY CHỌN</div>
    <a href="#" id="ctxView" class="ctx-item"><i class="fa-solid fa-folder-open text-primary"></i> Xem & Điều phối</a>
    <a href="#" id="ctxPrint" target="_blank" class="ctx-item"><i class="fa-solid fa-print text-dark"></i> In lệnh vận chuyển</a>
    <a href="#" id="ctxExcel" class="ctx-item"><i class="fa-solid fa-file-excel text-success"></i> Xuất Excel lô này</a>
    <div class="ctx-divider"></div>
    <a href="#" id="ctxDelete" class="ctx-item delete"><i class="fa-solid fa-trash-can"></i> Xóa chuyến xe này</a>
</div>

<form id="deleteForm" method="post" style="display:none;"></form>

@functions {
    public string GetStepEmoji(ExportStep step) => step switch
    {
        ExportStep.Contract => "📄 Lên Kế hoạch",
        ExportStep.Booking => "🚢 Đặt Xe/Booking",
        ExportStep.Packing => "📦 Chứng từ",
        ExportStep.Container => "🏗️ Xếp Hàng",
        ExportStep.Customs => "🛃 Hải quan",
        ExportStep.PortDropOff => "⚓ Xuất phát",
        ExportStep.BillOfLading => "📜 Vận đơn",
        ExportStep.DocSend => "📨 Gửi hồ sơ",
        ExportStep.Payment => "💰 Hoàn tất",
        _ => "Khác"
    };
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // Khởi tạo lịch
            flatpickr(".datepicker", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y", locale: "vn", allowInput: true });

            let activeId = null;
            let activeCode = "";

            // 1. BẮT SỰ KIỆN RIGHT-CLICK (Sử dụng jQuery để đảm bảo chạy mượt)
            $('.context-row').on('contextmenu', function (e) {
                e.preventDefault(); // Chặn menu mặc định của trình duyệt

                activeId = $(this).data('id');
                activeCode = $(this).data('code');
                $('#ctxTitle').text("CHUYẾN: " + activeCode);

                // Gắn sẵn Link (href) cho các nút Xem / In / Excel
                $('#ctxView').attr('href', '/Export/Details/' + activeId);
                $('#ctxPrint').attr('href', '/Export/Print/' + activeId);
                $('#ctxExcel').attr('href', '/Export/ExportToExcel?searchString=' + encodeURIComponent(activeCode));

                // Tính toán tọa độ hiển thị để không bị tràn màn hình
                let x = e.pageX; let y = e.pageY;
                if (x + 230 > $(window).width()) x -= 230;
                if (y + 200 > $(window).height()) y -= 200;

                $('#contextMenu').css({ top: y + 'px', left: x + 'px' }).fadeIn(150);
            });

            // 2. ẨN MENU KHI CLICK RA NGOÀI (Chỉ ẩn nếu không click vào bên trong Context Menu)
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#contextMenu').length) {
                    $('#contextMenu').fadeOut(100);
                }
            });

            // 3. XỬ LÝ NÚT XÓA CHUYẾN XE (Kèm cảnh báo)
            $('#ctxDelete').on('click', function (e) {
                e.preventDefault(); // Chặn hành vi chuyển trang của thẻ <a>
                $('#contextMenu').fadeOut(100);

                Swal.fire({
                    title: `Xóa chuyến ${activeCode}?`,
                    html: "Cảnh báo: Toàn bộ đơn hàng sẽ bị gỡ khỏi xe, và tài liệu đính kèm lô này sẽ bị xóa.<br/><b class='text-danger'>Phiếu xuất kho KHÔNG bị ảnh hưởng.</b>",
                    icon: 'warning',
                    showCancelButton: true, confirmButtonColor: '#d33', cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa-solid fa-trash-can"></i> Xóa ngay', cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({ title: 'Đang xử lý...', didOpen: () => Swal.showLoading() });

                        // Đẩy Form Action tới hàm Delete và tự động submit
                        let form = $('#deleteForm');
                        form.attr('action', '/Export/Delete/' + activeId);
                        form.submit();
                    }
                });
            });
        });
    </script>
}