@model ProductionManager.Data.Shipment
@{
    Layout = null;
    var orderCodes = ViewBag.OrderCodes as Dictionary<int, string>;
    
    var defaultCompany = "CÔNG TY TNHH SẢN XUẤT ABC";
    var defaultAddress = "Số 123, KCN VSIP, Bình Dương, Việt Nam";
    var defaultPhone = "Hotline: 0909.123.456 - Email: contact@abc.com";
    
    // Link xác thực
    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Shipment/Details/{Model.Id}";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>In Phiếu Xuất - @Model.ShipmentCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <style>
        body { font-family: 'Times New Roman', Times, serif; background: #e9ecef; }
        
        .page-sheet {
            width: 210mm; min-height: 297mm;
            padding: 15mm; margin: 20px auto;
            background: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            position: relative;
            overflow: hidden;
        }

        .security-pattern {
            background-image: radial-gradient(#e0e0e0 1px, transparent 0);
            background-size: 10px 10px;
        }

        .watermark-text {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 120px; font-weight: 900;
            color: rgba(255, 0, 0, 0.08);
            text-transform: uppercase;
            pointer-events: none;
            white-space: nowrap;
            border: 5px solid rgba(255, 0, 0, 0.08);
            padding: 20px 50px;
            border-radius: 20px;
        }

        /* 🔥 ĐÃ SỬA: Xóa position absolute để không bị đè chữ */
        .qr-box {
            margin-top: 10px;
            display: flex;
            justify-content: flex-end; /* Căn phải */
        }

        .company-name { font-size: 18px; font-weight: bold; text-transform: uppercase; color: #333; }
        .company-info { font-size: 13px; color: #555; }
        .header-title { font-size: 26px; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; color: #000; margin-top: 20px; }
        
        .table-print { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .table-print th { background-color: #f8f9fa !important; border: 1px solid #000; padding: 8px; text-align: center; }
        .table-print td { border: 1px solid #000; padding: 8px; vertical-align: middle; }

        .signature-box { margin-top: 40px; }
        .signature-title { font-weight: bold; text-transform: uppercase; font-size: 13px; }
        .signature-space { height: 100px; }
        
        .config-panel { width: 210mm; margin: 20px auto; background: #fff; padding: 20px; border-radius: 8px; border-left: 5px solid #198754; }

        @@media print {
            body { background: white; margin: 0; }
            .no-print, .config-panel { display: none !important; }
            .page-sheet { margin: 0; padding: 10mm; box-shadow: none; width: 100%; }
            .page-sheet { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>

    <div class="no-print container">
        <div class="d-flex justify-content-between align-items-center mt-3 mb-2" style="width: 210mm; margin: 0 auto;">
            <a href="javascript:window.close()" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
            <button onclick="window.print()" class="btn btn-primary btn-lg fw-bold shadow"><i class="fa-solid fa-print"></i> IN PHIẾU NGAY</button>
        </div>

        <div class="config-panel no-print shadow-sm">
            <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-shield-halved me-2"></i>TÙY CHỌN BẢO MẬT & CHỐNG GIẢ</h6>
            <div class="row g-3">
                <div class="col-md-4 border-end">
                    <label class="small fw-bold text-muted">Tên Công Ty</label>
                    <input type="text" id="inpCompany" class="form-control form-control-sm mb-2" value="@defaultCompany" />
                    <label class="small fw-bold text-muted">Logo</label>
                    <input type="file" id="inpLogo" accept="image/*" class="form-control form-control-sm" />
                </div>
                <div class="col-md-4 border-end">
                    <label class="small fw-bold text-muted d-block mb-2">Hiệu ứng:</label>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="chkWatermark" checked>
                        <label class="form-check-label" for="chkWatermark">Hiện Watermark</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chkQRCode" checked>
                        <label class="form-check-label" for="chkQRCode">Mã QR Code</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Nội dung Watermark</label>
                    <input type="text" id="inpWatermarkText" class="form-control form-control-sm mb-2" value="ORIGINAL" />
                    <label class="btn btn-outline-secondary btn-sm w-100 mt-2" for="inpReceiverSign">
                        <i class="fa-solid fa-file-signature"></i> Tải chữ ký khách
                    </label>
                    <input type="file" id="inpReceiverSign" accept="image/*" class="d-none" />
                </div>
            </div>
        </div>
    </div>

    <div class="page-sheet" id="printSheet">
        
        <div id="outWatermark" class="watermark-text">ORIGINAL</div>

        <div class="content-layer">
            <div class="row mb-4">
                <div class="col-7">
                    <div class="d-flex align-items-center gap-3">
                        <div id="logoContainer" style="display: none;">
                            <img id="printLogo" src="" style="max-height: 70px;" />
                        </div>
                        <div>
                            <div id="outCompany" class="company-name">@defaultCompany</div>
                            <div class="company-info">@defaultAddress</div>
                            <div class="company-info">@defaultPhone</div>
                        </div>
                    </div>
                </div>

                <div class="col-5 text-end">
                    <div class="small">Số phiếu: <b>@Model.ShipmentCode</b></div>
                    <div class="small">Ngày: @Model.ShipmentDate.ToString("dd/MM/yyyy")</div>
                    
                    <div id="outQRCode" class="qr-box">
                        <div class="text-center">
                            <div id="qrPlaceHolder"></div>
                            <div class="small mt-1 text-muted" style="font-size: 8px;">Quét xác thực</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mb-4">
                <div class="header-title">PHIẾU XUẤT KHO</div>
                <div class="fst-italic text-muted small">--- (Kiêm phiếu giao hàng) ---</div>
            </div>

            <div class="mb-4">
                <p class="mb-1"><strong>Khách hàng:</strong> @Model.Customer?.CompanyName</p>
                <p class="mb-1"><strong>Địa chỉ:</strong> @Model.Customer?.Address</p>
                <div class="row">
                    <div class="col-6"><p class="mb-1"><strong>Liên hệ:</strong> @Model.Customer?.ContactPerson - @Model.Customer?.PhoneNumber</p></div>
                    <div class="col-6"><p class="mb-1"><strong>Số xe:</strong> @(Model.VehicleNumber ?? "Tại kho")</p></div>
                </div>
                <p class="mb-1"><strong>Ghi chú:</strong> @Model.Notes</p>
            </div>

            <table class="table-print">
                <thead>
                    <tr>
                        <th style="width: 5%;">STT</th>
                        <th style="width: 15%;">Mã Đơn</th>
                        <th style="width: 45%;">Tên hàng hóa / Quy cách</th>
                        <th style="width: 10%;">ĐVT</th>
                        <th style="width: 10%;">SL Xuất</th>
                        <th style="width: 15%;">Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model.ShipmentDetails)
                    {
                        string oCode = orderCodes != null && orderCodes.ContainsKey(item.OrderDetailId) ? orderCodes[item.OrderDetailId] : "-";
                        <tr>
                            <td class="text-center">@(i++)</td>
                            <td class="text-center small fw-bold text-muted">@oCode</td>
                            <td>
                                <div class="fw-bold">@item.OrderDetail?.ProductName</div>
                                <div class="small fst-italic">@item.OrderDetail?.Specifications</div>
                            </td>
                            <td class="text-center">Cái</td>
                            <td class="text-center fw-bold fs-6">@item.QuantityShipped</td>
                            <td></td>
                        </tr>
                    }
                    @if (Model.ShipmentDetails.Count < 5)
                    {
                        <tr><td colspan="6" style="height: 30px;"></td></tr>
                        <tr><td colspan="6" style="height: 30px;"></td></tr>
                    }
                    <tr>
                        <td colspan="4" class="text-end fw-bold text-uppercase pe-3">Tổng cộng</td>
                        <td class="text-center fw-bold fs-6">@Model.ShipmentDetails.Sum(x => x.QuantityShipped).ToString("N0")</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>

            <div class="signature-box">
                <div class="row text-center">
                    <div class="col-4">
                        <div class="signature-title">Người lập phiếu</div>
                        <div class="small fst-italic">(Ký, họ tên)</div>
                        <div class="signature-space"></div>
                    </div>
                    <div class="col-4">
                        <div class="signature-title">Thủ kho</div>
                        <div class="small fst-italic">(Ký, họ tên)</div>
                        <div class="signature-space"></div>
                    </div>
                    <div class="col-4">
                        <div class="signature-title">Người nhận hàng</div>
                        <div class="small fst-italic">(Ký, họ tên)</div>
                        <div class="signature-space d-flex justify-content-center align-items-center">
                            <div id="receiverSignPreview"></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mt-4 text-center small text-muted fst-italic">
                (Phiếu này có giá trị xác thực điện tử)
            </div>
        </div>
    </div>

    <script>
        // 1. TẠO QR CODE
        var qrUrl = '@currentUrl';
        new QRCode(document.getElementById("qrPlaceHolder"), {
            text: qrUrl,
            width: 70, // Giảm size chút cho gọn
            height: 70,
            colorDark : "#000000",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.M
        });

        // 2. CẬP NHẬT HIỂN THỊ
        function updateDisplay() {
            var showWM = document.getElementById('chkWatermark').checked;
            var showQR = document.getElementById('chkQRCode').checked;
            document.getElementById('outWatermark').style.display = showWM ? 'block' : 'none';
            document.getElementById('outQRCode').style.visibility = showQR ? 'visible' : 'hidden'; // Dùng visibility để giữ vị trí
        }

        document.getElementById('chkWatermark').addEventListener('change', updateDisplay);
        document.getElementById('chkQRCode').addEventListener('change', updateDisplay);

        // 3. LIVE BINDING
        function bindText(inId, outId) {
            var el = document.getElementById(inId);
            if(el) el.addEventListener('input', function() { 
                document.getElementById(outId).innerText = this.value; 
            });
        }
        bindText('inpCompany', 'outCompany');
        bindText('inpWatermarkText', 'outWatermark');

        // 4. XỬ LÝ ẢNH
        function handleImage(inId, outId, boxId) {
            document.getElementById(inId).addEventListener('change', function(e) {
                if(e.target.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function(evt) {
                        if(outId) document.getElementById(outId).src = evt.target.result;
                        if(boxId) {
                            var box = document.getElementById(boxId);
                            box.style.display = 'block';
                            if(boxId === 'receiverSignPreview') box.innerHTML = `<img src="${evt.target.result}" style="max-height:80px;"/>`;
                        }
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
        }
        handleImage('inpLogo', 'printLogo', 'logoContainer');
        handleImage('inpReceiverSign', null, 'receiverSignPreview');

        updateDisplay();
    </script>
</body>
</html>