@{
    ViewData["Title"] = "Chính sách & Điều khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h2 class="mb-0 text-primary"><i class="fa-solid fa-file-shield me-2"></i> @ViewData["Title"]</h2>
                </div>
                <div class="card-body p-4 text-justify">

                    <h4 class="fw-bold text-dark border-bottom pb-2 mb-3">A. Chính sách bảo mật</h4>

                    <p class="text-muted">
                        Chào mừng bạn đến với hệ thống <strong>Quản lý Sản xuất & Kho vận</strong>. Chúng tôi cam kết bảo mật thông tin và dữ liệu doanh nghiệp của bạn.
                    </p>

                    <h6 class="fw-bold text-dark mt-3">1. Thu thập và Sử dụng thông tin</h6>
                    <p class="small text-muted">
                        Hệ thống thu thập dữ liệu (Đơn hàng, Khách hàng, Kho, Tài chính) chỉ nhằm mục đích vận hành nội bộ, quản lý quy trình sản xuất và báo cáo thống kê. Chúng tôi cam kết <strong>không chia sẻ</strong> dữ liệu này cho bên thứ ba nếu không có sự đồng ý của ban quản trị.
                    </p>

                    <h6 class="fw-bold text-dark mt-3">2. Bảo mật dữ liệu</h6>
                    <p class="small text-muted">
                        Mọi mật khẩu người dùng đều được mã hóa. Chúng tôi khuyến cáo người dùng không chia sẻ tài khoản để đảm bảo an toàn dữ liệu.
                    </p>

                    <hr class="my-4" />

                    <h4 class="fw-bold text-danger border-bottom pb-2 mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> B. Miễn trừ trách nhiệm (Disclaimer)
                    </h4>

                    <div class="alert alert-warning border-0 shadow-sm" role="alert">
                        <p class="mb-2"><strong>Vui lòng đọc kỹ các điều khoản sau trước khi sử dụng hệ thống:</strong></p>

                        <ol class="mb-0 ps-3">
                            <li class="mb-2">
                                <strong>Phần mềm cung cấp "Nguyên trạng" (As-Is):</strong>
                                Ứng dụng này được phát triển như một dự án nội bộ/cá nhân nhằm hỗ trợ quản lý, không phải là một sản phẩm phần mềm thương mại được kiểm định bởi các cơ quan tài chính/kế toán chuyên nghiệp. Nhà phát triển không cam kết rằng ứng dụng sẽ hoạt động không có lỗi hoặc không bị gián đoạn.
                            </li>
                            <li class="mb-2">
                                <strong>Tính chính xác của số liệu tài chính:</strong>
                                Các tính năng liên quan đến <em>Sổ quỹ, Công nợ, Doanh thu</em> chỉ mang tính chất tham khảo và hỗ trợ ghi chép. Người sử dụng (Kế toán/Quản lý) có trách nhiệm <strong>kiểm tra, đối chiếu</strong> lại các con số này với thực tế và chứng từ gốc. Nhà phát triển không chịu trách nhiệm về bất kỳ thiệt hại tài chính nào phát sinh do lỗi tính toán của phần mềm.
                            </li>
                            <li class="mb-2">
                                <strong>An toàn dữ liệu:</strong>
                                Mặc dù hệ thống có tính năng Sao lưu (Backup), nhưng việc bảo vệ file sao lưu là trách nhiệm của người sử dụng. Nhà phát triển không chịu trách nhiệm trong trường hợp mất mát dữ liệu do hỏng phần cứng, virus, hoặc thao tác sai của người dùng (như quên sao lưu, xóa nhầm dữ liệu).
                            </li>
                            <li>
                                <strong>Quyền thay đổi:</strong>
                                Nhà phát triển có quyền cập nhật, chỉnh sửa hoặc ngừng cung cấp các tính năng của hệ thống mà không cần báo trước.
                            </li>
                        </ol>
                    </div>

                    <p class="fst-italic small text-muted mt-3">
                        * Việc bạn tiếp tục đăng nhập và sử dụng hệ thống đồng nghĩa với việc bạn đã hiểu và đồng ý với các điều khoản miễn trừ trách nhiệm nêu trên.
                    </p>

                    <hr class="my-4" />

                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="fa-solid fa-circle-info me-3 fa-2x"></i>
                        <div>
                            <strong>Author: Mr. Ái</strong><br />
