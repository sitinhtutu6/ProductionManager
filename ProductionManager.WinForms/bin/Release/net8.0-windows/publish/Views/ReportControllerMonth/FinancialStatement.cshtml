@model ProductionApp.Web.Models.ViewModels.MonthlyPnLViewModel
@using ProductionManager.Data
@{
    ViewData["Title"] = $"Báo Cáo Tài Chính Tháng {Model.Month}/{Model.Year}";
    var company = ViewBag.CompanyInfo as CompanyConfig ?? new CompanyConfig();
}

<style>
    .pnl-bg { background-color: #f8fafc; min-height: 100vh; padding-bottom: 4rem; }
    .pnl-card { background: white; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); overflow: hidden; border: 1px solid #e2e8f0; }
    
    .pnl-row { display: flex; justify-content: space-between; padding: 14px 24px; border-bottom: 1px solid #f1f5f9; align-items: center; transition: background-color 0.2s; position: relative; }
    .pnl-row:hover { background-color: #f8fafc; }
    
    .hover-chart-row { cursor: help; }
    .hover-chart-row:hover { background-color: #eff6ff !important; border-left: 4px solid #3b82f6; padding-left: 20px; }
    
    .pnl-row.header { background-color: #0f172a; color: white; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: none; }
    
    .pnl-item { font-weight: 600; color: #334155; display: flex; align-items: center; }
    .pnl-item.sub { padding-left: 20px; font-weight: 600; color: #475569; font-size: 0.95rem; pointer-events: none; }
    
    .pnl-amount { font-family: 'Consolas', 'Courier New', monospace; font-weight: 700; font-size: 1.15rem; letter-spacing: -0.5px; pointer-events: none; }
    .pnl-amount.total { font-size: 1.4rem; }

    /* CSS CHO POPUP BIỂU ĐỒ HOVER */
    #hoverChartPopup {
        position: fixed; background: white; border: 1px solid #e2e8f0; box-shadow: 0 15px 35px rgba(0,0,0,0.15); border-radius: 12px; padding: 15px; width: 300px; z-index: 9999; pointer-events: none; display: none; opacity: 0; transform: translateY(10px); transition: opacity 0.3s ease, transform 0.3s ease;
    }
    #hoverChartPopup.show { opacity: 1; transform: translateY(0); }
    .popup-title { font-size: 0.85rem; font-weight: bold; text-align: center; color: #334155; margin-bottom: 10px; border-bottom: 1px dashed #cbd5e1; padding-bottom: 5px; }

    @Html.Raw("@media print {")
        @Html.Raw("@page { margin: 10mm 15mm; }")
        header, footer, nav, .navbar, .sidebar, .main-header, .app-header { display: none !important; }
        body { background: white !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; margin: 0; padding: 0; }
        .container, .container-fluid, main, .pb-3 { padding: 0 !important; margin: 0 !important; max-width: 100% !important; }
        .pnl-bg { padding: 0 !important; background-color: white !important; }
        .pnl-card { box-shadow: none !important; border: 1px solid #000 !important; border-radius: 0 !important; margin-bottom: 0 !important; }
        .no-print, form, .btn, #hoverChartPopup { display: none !important; }
        .print-only-header { display: block !important; text-align: center; margin-bottom: 15px; }
        .print-only-footer { display: block !important; margin-top: 30px; page-break-inside: avoid; }
        .pnl-row { border-bottom: 1px solid #e2e8f0 !important; padding: 10px 15px !important; page-break-inside: avoid; border-left: none !important; }
        .pnl-row.header { background: #cbd5e1 !important; color: #000 !important; border-bottom: 2px solid #000 !important; }
        .pnl-row.header .pnl-amount { color: #000 !important; }
        .pnl-amount.total { color: #000 !important; font-size: 1.2rem; }
        .text-white { color: #000 !important; }
    @Html.Raw("}")
    .print-only-header, .print-only-footer { display: none; }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div id="hoverChartPopup">
    <div class="popup-title" id="hoverChartTitle">Chi tiết Tỷ trọng</div>
    <div style="height: 150px; display: flex; justify-content: center;">
        <canvas id="hoverPieChart"></canvas>
    </div>
</div>

<div class="pnl-bg pt-4">
    <div class="container-fluid">
        
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <div>
                <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>BÁO CÁO LỢI NHUẬN TỔNG HỢP (P&L)</h3>
                <span class="text-muted small">Báo cáo phân nhóm Doanh thu & Chi phí trong kỳ</span>
            </div>
            
            <div class="d-flex gap-3 align-items-center">
                <form method="get" class="d-flex gap-2 bg-white p-2 rounded-3 shadow-sm border m-0">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light fw-bold text-muted border-0"><i class="fa-solid fa-calendar-day me-1"></i> Kỳ</span>
                        <select name="month" class="form-select fw-bold border-0 bg-light text-primary" onchange="this.form.submit()">
                            @for(int i=1; i<=12; i++) { <option value="@i" selected="@(Model.Month == i)">Tháng @i</option> }
                        </select>
                        <select name="year" class="form-select fw-bold border-0 bg-light text-primary" onchange="this.form.submit()">
                            @for(int i=DateTime.Now.Year - 2; i<=DateTime.Now.Year; i++) { <option value="@i" selected="@(Model.Year == i)">Năm @i</option> }
                        </select>
                    </div>
                </form>

                <div class="vr mx-1"></div>

                <a href="@Url.Action("ExportExcel", new { month = Model.Month, year = Model.Year })" class="btn btn-success fw-bold shadow-sm d-flex align-items-center">
                    <i class="fa-solid fa-file-excel me-2"></i> Xuất Excel
                </a>
                <button onclick="window.print()" class="btn btn-danger fw-bold shadow-sm d-flex align-items-center">
                    <i class="fa-solid fa-print me-2"></i> In Báo Cáo
                </button>
            </div>
        </div>

        <div class="row justify-content-center m-0">
            <div class="col-xl-12 px-0">
                
                <div class="print-only-header">
                    <h2 class="fw-bold mb-1" style="font-size: 24px;">@company.CompanyName.ToUpper()</h2>
                    <p class="mb-0"><strong>Địa chỉ:</strong> @company.Address</p>
                    <p class="mb-3"><strong>MST:</strong> @company.TaxCode - <strong>Điện thoại:</strong> @company.Phone</p>
                    <div style="border-top: 2px solid #000; margin: 15px 0;"></div>
                    <h3 class="fw-bold mt-3 mb-1" style="font-size: 20px;">BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH (P&L)</h3>
                    <p class="fst-italic mb-4">Kỳ báo cáo: Tháng @Model.Month năm @Model.Year</p>
                </div>

                <div class="pnl-card">
                    <div class="pnl-row header" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);">
                        <span>I. TỔNG DOANH THU & THU NHẬP</span>
                        <span class="pnl-amount text-white">@((Model.NetRevenue + Model.OtherIncome).ToString("N0"))</span>
                    </div>

                    <div class="pnl-row hover-chart-row" data-hover-chart="true" data-type="revenue" data-value="@((long)Model.NetRevenue)" data-name="Doanh thu thuần">
                        <span class="pnl-item sub">
                            <i class="fa-solid fa-sack-dollar text-primary me-2 fa-lg no-print"></i>1. Doanh thu thuần (Đã bóc VAT)
                        </span>
                        <span class="pnl-amount text-dark fw-bold">@Model.NetRevenue.ToString("N0")</span>
                    </div>

                    <div class="pnl-row hover-chart-row" data-hover-chart="true" data-type="revenue" data-value="@((long)Model.OtherIncome)" data-name="Thu nhập khác">
                        <span class="pnl-item sub">
                            <i class="fa-solid fa-hand-holding-dollar text-success me-2 fa-lg no-print"></i>2. Thu nhập tài chính / Khác
                        </span>
                        <span class="pnl-amount text-success fw-bold">+@Model.OtherIncome.ToString("N0")</span>
                    </div>

                    <div class="pnl-row header bg-dark mt-2">
                        <span>II. GIÁ VỐN HÀNG BÁN (COGS)</span>
                        <span class="pnl-amount text-white">-@Model.TotalCOGS.ToString("N0")</span>
                    </div>
                    
                    <div class="pnl-row bg-light hover-chart-row" data-hover-chart="true" data-type="expense" data-value="@((long)Model.TotalCOGS)" data-name="Chi phí Vật tư">
                        <span class="pnl-item sub text-dark">
                            <i class="fa-solid fa-boxes-stacked text-secondary me-2 fa-lg no-print"></i>Chi phí vật tư tiêu hao (Hàng đã xuất SX/Bán)
                        </span>
                        <span class="pnl-amount text-dark fw-bold">@Model.TotalCOGS.ToString("N0")</span>
                    </div>

                    <div class="pnl-row border-bottom border-dark py-3" style="background-color: #fef9c3; border-bottom-width: 2px !important;">
                        <span class="fw-bold text-dark fs-5"><i class="fa-solid fa-chart-pie text-warning me-2 no-print"></i>LỢI NHUẬN GỘP (GROSS PROFIT)</span>
                        <span class="pnl-amount fs-5 fw-bold @(Model.GrossProfit >= 0 ? "text-success" : "text-danger")" style="color:#000!important">
                            @Model.GrossProfit.ToString("N0")
                        </span>
                    </div>

                    <div class="pnl-row header bg-dark mt-2">
                        <span>III. CHI PHÍ VẬN HÀNH (OPEX)</span>
                        <span class="pnl-amount text-white">-@Model.TotalOperatingExpense.ToString("N0")</span>
                    </div>

                    @if (Model.OpexGroups != null && Model.OpexGroups.Any())
                    {
                        int index = 1;
                        foreach (var group in Model.OpexGroups)
                        {
                            <div class="pnl-row hover-chart-row" data-hover-chart="true" data-type="expense" data-value="@((long)group.Value)" data-name="@group.Key">
                                <span class="pnl-item sub">
                                    <i class="fa-solid fa-tag text-primary me-2 fa-lg no-print"></i>@(index++). @group.Key
                                </span>
                                <span class="pnl-amount text-dark fw-bold">@group.Value.ToString("N0")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pnl-row">
                            <span class="pnl-item sub fst-italic text-muted">Chưa phát sinh chi phí vận hành trong kỳ này.</span>
                        </div>
                    }

                    <div class="pnl-row header mt-3 pb-3 pt-3" style="background: #334155; border-bottom: none !important;">
                        <span class="fs-5">IV. LỢI NHUẬN TRƯỚC THUẾ (EBT)</span>
                        <span class="pnl-amount total text-white">@Model.ProfitBeforeTax.ToString("N0")</span>
                    </div>

                    <div class="pnl-row bg-light text-danger border-bottom">
                        <span class="pnl-item sub"><i class="fa-solid fa-scale-balanced me-2 no-print"></i>Thuế TNDN ước tính (20% nếu có lãi)</span>
                        <span class="pnl-amount">-@Model.CorporateTax.ToString("N0")</span>
                    </div>

                    <div class="pnl-row header pb-4 pt-4" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-bottom: none !important;">
                        <span class="fs-4">V. LỢI NHUẬN RÒNG SAU THUẾ (NET INCOME)</span>
                        <span class="pnl-amount total text-white">
                            @(Model.NetProfit > 0 ? "+" : "")@Model.NetProfit.ToString("N0") VNĐ
                        </span>
                    </div>
                </div>
                
                <div class="print-only-footer">
                    <div class="row text-center mt-4 pt-4">
                        <div class="col-6"><p class="fw-bold mb-0">Người lập biểu</p><p class="fst-italic text-muted">(Ký, ghi rõ họ tên)</p></div>
                        <div class="col-6"><p class="fw-bold mb-0">Giám đốc</p><p class="fst-italic text-muted">(Ký, đóng dấu)</p></div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    // ==============================================
    // LOGIC BIỂU ĐỒ POPUP THEO DÒNG (HOVER > 2s)
    // ==============================================
    document.addEventListener("DOMContentLoaded", function () {
        const totalRevenue = @((long)(Model.NetRevenue + Model.OtherIncome));
        const totalExpense = @((long)(Model.TotalCOGS + Model.TotalOperatingExpense));

        let hoverTimer = null;
        let hoverChartInstance = null;
        let mouseX = 0, mouseY = 0;

        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        });

        const rows = document.querySelectorAll('[data-hover-chart="true"]');
        const popup = document.getElementById('hoverChartPopup');
        const titleEl = document.getElementById('hoverChartTitle');
        const ctx = document.getElementById('hoverPieChart').getContext('2d');

        rows.forEach(row => {
            row.addEventListener('mouseenter', () => {
                hoverTimer = setTimeout(() => {
                    let val = parseFloat(row.getAttribute('data-value')) || 0;
                    let type = row.getAttribute('data-type'); 
                    let name = row.getAttribute('data-name');
                    
                    showHoverChart(val, type, name);
                }, 2000);
            });

            row.addEventListener('mouseleave', () => {
                clearTimeout(hoverTimer);
                popup.classList.remove('show');
                setTimeout(() => { if(!popup.classList.contains('show')) popup.style.display = 'none'; }, 300);
            });
        });

        function showHoverChart(value, type, name) {
            let total = type === 'revenue' ? totalRevenue : totalExpense;
            
            if (total <= 0 || value <= 0) return;

            let remaining = total - value;
            let percentage = ((value / total) * 100).toFixed(1);
            let typeLabel = type === 'revenue' ? 'TỔNG DOANH THU' : 'TỔNG CHI PHÍ';
            
            titleEl.innerHTML = `<span class="text-primary">${name}</span><br/><small class="text-muted fw-normal">chiếm ${percentage}% ${typeLabel}</small>`;

            if (hoverChartInstance) hoverChartInstance.destroy();

            let mainColor = type === 'revenue' ? '#3b82f6' : '#ef4444';

            hoverChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [name, 'Các khoản khác'],
                    datasets: [{
                        data: [value, remaining],
                        backgroundColor: [mainColor, '#e2e8f0'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let valStr = context.raw.toLocaleString() + ' đ';
                                    let percent = ((context.raw / total) * 100).toFixed(1) + '%';
                                    return ` ${context.label}: ${valStr} (${percent})`;
                                }
                            }
                        }
                    }
                }
            });

            popup.style.display = 'block';
            
            let popupWidth = 300; 
            let popupHeight = 220;
            let leftPos = mouseX + 15;
            let topPos = mouseY + 15;

            if (leftPos + popupWidth > window.innerWidth) leftPos = mouseX - popupWidth - 15;
            if (topPos + popupHeight > window.innerHeight) topPos = mouseY - popupHeight - 15;

            popup.style.left = leftPos + 'px';
            popup.style.top = topPos + 'px';
            
            setTimeout(() => popup.classList.add('show'), 10);
        }
    });
</script>