@model IEnumerable<ProductionApp.Web.Models.ViewModels.PartnerGroupVM>
@using ProductionManager.Data

@{
    ViewData["Title"] = "Danh bạ & Công việc Đối tác";
    // Kiểm tra xem có đang áp dụng bộ lọc nào không để tự động mở khung tìm kiếm
    bool hasFilter = !string.IsNullOrEmpty(ViewBag.FilterDate) ||
                     !string.IsNullOrEmpty(ViewBag.Company) ||
                     !string.IsNullOrEmpty(ViewBag.Department) ||
                     !string.IsNullOrEmpty(ViewBag.ContactName) ||
                     !string.IsNullOrEmpty(ViewBag.JobDesc);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/airbnb.css">

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-primary mb-1"><i class="fa-solid fa-address-book me-2"></i>DANH BẠ ĐỐI TÁC</h4>
            <p class="text-muted mb-0">Quản lý người liên hệ, mảng phụ trách và bàn giao công việc</p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary fw-bold shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse">
                <i class="fa-solid fa-filter me-1"></i> Bộ lọc
            </button>

            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
                <i class="fa-solid fa-plus me-2"></i>Thêm Liên Hệ
            </a>
        </div>
    </div>

    <div class="collapse @(hasFilter ? "show" : "") mb-4" id="filterCollapse">
        <div class="card card-body bg-light border-0 shadow-sm">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Thời gian làm việc</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-regular fa-calendar"></i></span>
                        <input type="text" name="filterDate" class="form-control flatpickr-range" placeholder="Từ ngày - Đến ngày..." value="@ViewBag.FilterDate" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Công ty</label>
                    <input type="text" name="company" class="form-control" placeholder="Tên công ty..." value="@ViewBag.Company" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Bộ phận</label>
                    <input type="text" name="department" class="form-control" placeholder="Tên phòng ban..." value="@ViewBag.Department" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Người liên hệ</label>
                    <input type="text" name="contactName" class="form-control" placeholder="Tên đối tác..." value="@ViewBag.ContactName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Phụ trách / Công việc</label>
                    <div class="d-flex gap-2">
                        <input type="text" name="jobDesc" class="form-control" placeholder="Từ khóa công việc..." value="@ViewBag.JobDesc" />
                        <button type="submit" class="btn btn-primary px-3"><i class="fa-solid fa-magnifying-glass"></i></button>
                        <a asp-action="Index" class="btn btn-outline-danger" title="Xóa bộ lọc"><i class="fa-solid fa-xmark"></i></a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @foreach (var group in Model)
    {
        <div class="card shadow-sm border-0 mb-4 rounded-3 overflow-hidden">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-building me-2"></i>@group.CompanyName</h5>
                <span class="badge bg-primary rounded-pill px-3">@group.ActiveCount Đang hoạt động</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th width="15%">Bộ phận</th>
                            <th width="15%">Người liên hệ</th>
                            <th width="20%">Kênh liên lạc</th>
                            <th width="25%">Phụ trách / Công việc</th>
                            <th width="15%">Thời gian làm việc</th>
                            <th width="10%" class="text-center">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in group.Contacts)
                        {
                            // Người "Kết thúc" sẽ tự động bị mờ và màu xám
                            var rowClass = c.Status == PartnerStatus.Ended ? "bg-light text-muted" : "";
                            var opacity = c.Status == PartnerStatus.Ended ? "opacity: 0.6;" : "";

                            <tr class="@rowClass" style="@opacity">
                                <td class="fw-bold text-secondary">@c.Department</td>
                                <td>
                                    <div class="fw-bold text-dark">@c.ContactName</div>
                                    @if (!string.IsNullOrEmpty(c.Notes))
                                    {
                                        <small class="text-muted fst-italic" title="@c.Notes"><i class="fa-solid fa-circle-info me-1"></i>Có ghi chú</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.Phone))
                                    {
                                        <div><i class="fa-solid fa-phone text-success me-2" style="width: 15px"></i>@c.Phone</div>
                                    }
                                    @if (!string.IsNullOrEmpty(c.Email))
                                    {
                                        <div><i class="fa-solid fa-envelope text-danger me-2" style="width: 15px"></i>@c.Email</div>
                                    }
                                    @if (!string.IsNullOrEmpty(c.Zalo))
                                    {
                                        <div><span class="fw-bold text-primary me-2" style="width: 15px">Z</span>@c.Zalo</div>
                                    }
                                    @if (!string.IsNullOrEmpty(c.Telegram))
                                    {
                                        <div><i class="fa-brands fa-telegram text-info me-2" style="width: 15px"></i>@c.Telegram</div>
                                    }
                                </td>
                                <td>
                                    <div class="text-wrap" style="max-width: 300px;">@c.JobDescription</div>
                                </td>
                                <td>
                                    <div class="small"><i class="fa-regular fa-calendar-check text-success me-1"></i> BĐ: @c.StartDate.ToString("dd/MM/yyyy")</div>
                                    @if (c.EndDate.HasValue)
                                    {
                                        <div class="small text-danger"><i class="fa-regular fa-calendar-xmark me-1"></i> KT: @c.EndDate.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (c.Status == PartnerStatus.Active)
                                    {
                                        <span class="badge bg-success">Đang làm</span>
                                    }
                                    else if (c.Status == PartnerStatus.Paused)
                                    {
                                        <span class="badge bg-warning text-dark">Tạm dừng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Kết thúc</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h5 class="text-muted">Chưa có danh bạ đối tác nào.</h5>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            flatpickr(".flatpickr-range", {
                mode: "range",      
                dateFormat: "d/m/Y", 
                locale: "vn",        
                allowInput: true
            });
        });
    </script>
}
