@model IEnumerable<ProductionManager.Data.Shipment>
@using ProductionManager.Data
@{
    ViewData["Title"] = "Lịch sử Xuất kho";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<style>
    /* Background & Panel */
    .shipment-bg {
        background: #f0f2f5 url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=2070&auto=format&fit=crop');
        background-size: cover;
        background-attachment: fixed;
        min-height: 100vh;
        padding-bottom: 3rem;
    }

    .glass-panel {
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border-radius: 12px;
        backdrop-filter: blur(10px);
    }

    /* Table Styles */
    .table-custom thead th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e9ecef;
        padding: 12px 16px;
    }

    .table-custom tbody td {
        vertical-align: middle;
        padding: 12px 16px;
        border-bottom: 1px solid #f1f3f5;
        font-size: 0.9rem;
    }

    /* Master Row Interaction */
    .master-row {
        cursor: pointer;
        transition: all 0.2s;
        border-left: 4px solid transparent;
    }

        .master-row:hover {
            background-color: #f1f5f9;
            border-left: 4px solid #0d6efd;
        }

        .master-row[aria-expanded="true"] {
            background-color: #eef2ff;
            border-left: 4px solid #0d6efd;
            font-weight: 500;
        }

    /* Icon Rotate Animation */
    .rotate-icon {
        transition: transform 0.3s ease;
    }

    .collapsed .rotate-icon {
        transform: rotate(-90deg);
    }

    .btn-toggle[aria-expanded="true"] .rotate-icon {
        transform: rotate(0deg);
    }

    /* Custom Datepicker Input */
    .form-control-glass {
        border: 1px solid #dee2e6;
        background-color: #f8f9fa;
        font-weight: 600;
        color: #495057;
    }

        .form-control-glass:focus {
            background-color: #fff;
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    /* 🔥 CSS CHO RIGHT-CLICK CONTEXT MENU */
    .custom-context-menu {
        display: none;
        position: absolute;
        z-index: 1050;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        border: 1px solid #e2e8f0;
        min-width: 200px;
        padding: 8px 0;
    }

        .custom-context-menu .dropdown-item {
            padding: 10px 20px;
            font-size: 0.9rem;
            transition: background 0.2s;
            cursor: pointer;
        }

            .custom-context-menu .dropdown-item:hover {
                background-color: #f1f5f9;
            }

    .menu-title {
        padding: 5px 20px 10px;
        font-size: 0.75rem;
        font-weight: bold;
        color: #94a3b8;
        border-bottom: 1px dashed #e2e8f0;
        margin-bottom: 5px;
    }
</style>

<div class="shipment-bg">
    <div class="container-fluid pt-4">

        <div class="d-flex justify-content-between align-items-center mb-4 px-2">
            <div>
                <h3 class="fw-bold text-dark mb-1">
                    <i class="fa-solid fa-truck-ramp-box text-warning me-2"></i>QUẢN LÝ XUẤT KHO
                </h3>
                <span class="text-muted small">Nhấp chuột phải vào dòng để thao tác Sửa/Xóa</span>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold text-white">
                    <i class="fa-solid fa-plus me-1"></i> Tạo Phiếu Mới
                </a>
            </div>
        </div>

        <div class="glass-panel p-3 mb-4">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="small fw-bold text-muted mb-1">Từ ngày</label>
                    <input type="text" name="fromDate" class="form-control form-control-sm form-control-glass datepicker"
                           placeholder="dd/mm/yyyy" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold text-muted mb-1">Đến ngày</label>
                    <input type="text" name="toDate" class="form-control form-control-sm form-control-glass datepicker"
                           placeholder="dd/mm/yyyy" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark btn-sm w-100 fw-bold shadow-sm">
                        <i class="fa-solid fa-filter me-1"></i> Lọc dữ liệu
                    </button>
                </div>
                <div class="col-md-4 border-start ps-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted text-uppercase" style="font-size: 10px;">Số lượng phiếu</small>
                            <div class="fw-bold fs-5">@ViewBag.TotalShipments</div>
                        </div>
                        <div class="text-end">
                            <small class="text-success text-uppercase fw-bold" style="font-size: 10px;">Tổng giá trị</small>
                            <div class="fw-bold fs-5 text-success">@ViewBag.TotalValue?.ToString("N0") <small>₫</small></div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="glass-panel overflow-hidden">
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th width="50" class="text-center"></th>
                            <th>Mã Phiếu</th>
                            <th>Thời gian</th>
                            <th>Khách hàng / Đơn hàng</th>
                            <th>Vận chuyển</th>
                            <th class="text-end">Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có dữ liệu phiếu xuất.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var totalAmount = item.ShipmentDetails.Sum(x => x.QuantityShipped * (x.OrderDetail?.UnitPrice ?? 0));

                                <tr class="master-row btn-toggle collapsed"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#detail_@item.Id"
                                    aria-expanded="false"
                                    data-id="@item.Id"
                                    data-code="@item.ShipmentCode">
                                    <td class="text-center">
                                        <i class="fa-solid fa-chevron-down rotate-icon text-muted"></i>
                                    </td>
                                    <td class="fw-bold text-primary">@item.ShipmentCode</td>
                                    <td>
                                        <span class="d-block fw-bold text-dark">@item.ShipmentDate.ToString("dd/MM/yyyy")</span>
                                        <small class="text-muted">@item.ShipmentDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Customer?.CompanyName</div>
                                        @if (item.OrderId.HasValue)
                                        {
                                            <span class="badge bg-light text-secondary border rounded-pill fw-normal mt-1">Đơn: @item.Order?.OrderCode</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border rounded-pill fw-normal mt-1">Gộp nhiều đơn</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ExportShipment != null)
                                        {
                                            <span class="badge bg-info text-dark shadow-sm border border-info" title="Hàng đi theo chuyến xe">
                                                <i class="fa-solid fa-truck-fast me-1"></i>
                                                @(item.ExportShipment.TransportType == TransportType.Truck ? item.ExportShipment.LicensePlate : item.ExportShipment.ContainerNumber)
                                            </span>
                                            <br />

                                            <small class="text-muted" style="font-size:10px;">@item.ExportShipment.ShipmentCode</small>
                                        }
                                        else if (!string.IsNullOrEmpty(item.VehicleNumber))
                                        {
                                            <span class="badge bg-dark"><i class="fa-solid fa-truck-front me-1"></i> @item.VehicleNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Tại kho (Lẻ)</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-success">@totalAmount.ToString("N0")</td>
                                </tr>

                                <tr class="collapse bg-white" id="detail_@item.Id">
                                    <td colspan="6" class="p-0 border-0">
                                        <div class="p-3 bg-light shadow-inner">
                                            <div class="card border-0 shadow-sm">
                                                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                                    <div class="fw-bold text-primary small text-uppercase">
                                                        <i class="fa-solid fa-list-check me-2"></i>Chi tiết vật tư
                                                    </div>
                                                    <a asp-action="Details" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-4 fw-bold shadow-sm">
                                                        <i class="fa-solid fa-eye me-1"></i> Xem đầy đủ
                                                    </a>
                                                </div>

                                                <div class="table-responsive">
                                                    <table class="table table-sm table-bordered mb-0">
                                                        <thead class="bg-light text-muted">
                                                            <tr>
                                                                <th class="ps-3">Sản phẩm</th>
                                                                <th class="text-center" width="100">SL Xuất</th>
                                                                <th class="text-end" width="150">Đơn giá</th>
                                                                <th class="text-end" width="150">Thành tiền</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var d in item.ShipmentDetails)
                                                            {
                                                                var price = d.OrderDetail?.UnitPrice ?? 0;
                                                                <tr>
                                                                    <td class="ps-3 fw-bold text-dark">
                                                                        @d.OrderDetail?.ProductName
                                                                        <span class="fw-normal text-muted fst-italic ms-1">(@(d.OrderDetail?.Specifications ?? "-"))</span>
                                                                    </td>
                                                                    <td class="text-center fw-bold text-primary">@d.QuantityShipped</td>
                                                                    <td class="text-end text-muted">@price.ToString("N0")</td>
                                                                    <td class="text-end fw-bold">@((d.QuantityShipped * price).ToString("N0"))</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.Notes))
                                                {
                                                    <div class="card-footer bg-white text-muted small fst-italic">
                                                        <i class="fa-solid fa-note-sticky me-1"></i> Ghi chú: @item.Notes
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="contextMenu" class="custom-context-menu">
    <div class="menu-title" id="ctxMenuTitle">PHIẾU XUẤT KHO</div>

    <a href="#" id="ctxView" target="_blank" class="dropdown-item text-primary fw-bold">
        <i class="fa-solid fa-eye me-2" style="width: 16px;"></i> Xem chi tiết
    </a>

    <a href="#" id="ctxPrint" target="_blank" class="dropdown-item text-dark fw-bold">
        <i class="fa-solid fa-print me-2" style="width: 16px;"></i> In Phiếu
    </a>

    <a href="#" id="ctxEdit" class="dropdown-item text-warning fw-bold text-dark">
        <i class="fa-solid fa-pen-to-square me-2" style="width: 16px;"></i> Sửa thông tin xe/ghi chú
    </a>

    <div class="dropdown-divider my-1"></div>

    <a href="#" id="ctxDelete" class="dropdown-item text-danger fw-bold">
        <i class="fa-solid fa-trash-can me-2" style="width: 16px;"></i> Xóa phiếu này
    </a>
</div>

<form id="deleteForm" method="post" style="display:none;"></form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Khởi tạo Datepicker
            flatpickr(".datepicker", { altInput: true, altFormat: "d/m/Y", dateFormat: "Y-m-d", allowInput: true, locale: "vn" });

            // Biến lưu trữ ID và Code của phiếu đang thao tác
            let activeShipmentId = null;
            let activeShipmentCode = null;

            // 1. SỰ KIỆN CLICK CHUỘT PHẢI (RIGHT-CLICK)
            $('.master-row').on('contextmenu', function (e) {
                e.preventDefault(); // Chặn menu mặc định của trình duyệt

                // Lấy ID và Code từ data-attribute của dòng được click
                activeShipmentId = $(this).data('id');
                activeShipmentCode = $(this).data('code');

                // Cập nhật thông tin vào Menu
                $('#ctxMenuTitle').text('PHIẾU: ' + activeShipmentCode);
                $('#ctxView').attr('href', '/Shipment/Details/' + activeShipmentId);
                $('#ctxPrint').attr('href', '/Shipment/Print/' + activeShipmentId);
                $('#ctxEdit').attr('href', '/Shipment/Edit/' + activeShipmentId);

                // Tính toán vị trí hiển thị Menu không bị tràn viền màn hình
                var menu = $('#contextMenu');
                var mouseX = e.pageX;
                var mouseY = e.pageY;

                var menuWidth = menu.outerWidth();
                var menuHeight = menu.outerHeight();
                var windowWidth = $(window).width();
                var windowHeight = $(window).height();

                if ((mouseX + menuWidth) > windowWidth) mouseX = mouseX - menuWidth;
                if ((mouseY + menuHeight) > windowHeight) mouseY = mouseY - menuHeight;

                // Hiển thị Menu
                menu.css({ top: mouseY + 'px', left: mouseX + 'px' }).fadeIn(150);
            });

            // 2. ẨN MENU KHI CLICK RA CHỖ KHÁC
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.custom-context-menu').length) {
                    $('#contextMenu').fadeOut(100);
                }
            });

            // 3. XỬ LÝ SỰ KIỆN NÚT "XÓA PHIẾU"
            $('#ctxDelete').on('click', function (e) {
                e.preventDefault();
                $('#contextMenu').fadeOut(100);

                Swal.fire({
                    title: 'Xóa Phiếu ' + activeShipmentCode + '?',
                    html: "Sau khi xóa:<br/>- Tồn kho sẽ được cộng lại.<br/>- Đơn hàng sẽ bị lùi % tiến độ.<br/><b class='text-danger'>Thao tác này KHÔNG THỂ khôi phục!</b>",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa-solid fa-trash-can me-1"></i> Vâng, Xóa ngay!',
                    cancelButtonText: 'Hủy bỏ'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({ title: 'Đang xử lý...', didOpen: () => Swal.showLoading() });

                        // Đẩy Form Action tới hàm Delete và submit
                        let form = $('#deleteForm');
                        form.attr('action', '/Shipment/Delete/' + activeShipmentId);
                        form.submit();
                    }
                });
            });
        });
    </script>
}