@model ProductionApp.Web.Models.ManageUserRolesViewModel
@{ ViewData["Title"] = "Phân vai trò"; }

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fa-solid fa-user-shield me-2"></i> Phân quyền: @Model.FullName</h5>
            <small class="text-white-50">@Model.Email</small>
        </div>
        <div class="card-body">
            <form asp-action="ManageRoles" method="post">
                <input type="hidden" asp-for="UserId" />

                @if (TempData["Error"] != null) {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <div class="list-group mb-4">
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <label class="list-group-item d-flex gap-3 align-items-center cursor-pointer list-group-item-action">
                            <input type="hidden" asp-for="@Model.Roles[i].RoleName" />
                            <input class="form-check-input flex-shrink-0" type="checkbox" asp-for="@Model.Roles[i].IsSelected" style="width: 1.3em; height: 1.3em;">
                            <span class="pt-1">
                                <strong class="d-block text-primary">@Model.Roles[i].RoleName</strong>
                                <small class="text-muted">Cấp quyền truy cập nhóm @Model.Roles[i].RoleName</small>
                            </span>
                        </label>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>