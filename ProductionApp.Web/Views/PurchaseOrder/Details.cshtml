@model ProductionManager.Data.PurchaseOrder
@using ProductionManager.Data

@{
    ViewData["Title"] = "Chi tiết Đơn hàng " + Model.POCode;
    ViewData["Breadcrumbs"] = new List<(string Title, string Url)>
    {
        ("Đặt Hàng", Url.Action("Index", "PurchaseOrder")), 
        ("Chi Tiết", "") 
    };

    double totalOrdered = Model.Details.Sum(x => x.QuantityOrdered);
    double totalReceived = Model.Details.Sum(x => x.QuantityReceived);
    double percent = totalOrdered > 0 ? (totalReceived / totalOrdered) * 100 : 0;
}

<div class="container-fluid py-4" style="max-width: 1200px;">
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold text-primary mb-1"><i class="fa-solid fa-file-invoice me-2"></i> @Model.POCode</h4>
                <div class="text-muted small">
                    <i class="fa-regular fa-calendar me-1"></i> Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy") &nbsp;|&nbsp;
                    <i class="fa-solid fa-building me-1"></i> NCC: <span class="fw-bold text-dark">@Model.SupplierName</span>
                </div>
            </div>
            <div class="text-end">
                <div class="mb-2">
                    @if (Model.Status == POStatus.Completed) { <span class="badge bg-success px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-check-double me-1"></i> ĐÃ HOÀN THÀNH</span> }
                    else if (Model.Status == POStatus.Cancelled) { <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-ban me-1"></i> ĐÃ HỦY</span> }
                    else if (Model.Status == POStatus.Partial) { <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-truck-ramp-box me-1"></i> ĐANG GIAO HÀNG</span> }
                    else { <span class="badge bg-info text-dark px-3 py-2 fs-6 rounded-pill"><i class="fa-solid fa-hourglass-half me-1"></i> CHỜ GIAO HÀNG</span> }
                </div>
                <div class="progress rounded-pill shadow-sm" style="height: 10px; width: 250px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @percent%;"></div>
                </div>
                <small class="text-muted fw-bold mt-1 d-block">Tiến độ nhận hàng: @Math.Round(percent, 1)%</small>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-9">
            <div class="card bg-white border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-light border-bottom py-3">
                    <h6 class="fw-bold text-secondary mb-0 text-uppercase"><i class="fa-solid fa-money-check-dollar me-2"></i>TÓM TẮT TÀI CHÍNH</h6>
                </div>
                <div class="card-body p-0">
                    <div class="row text-center g-0">
                        <div class="col-md-3 border-end py-4">
                            <span class="small fw-bold text-muted text-uppercase">Tiền Hàng</span><br/>
                            <strong class="fs-4 text-dark">@Model.TotalAmount.ToString("N0")</strong>
                        </div>
                        <div class="col-md-3 border-end py-4 bg-light">
                            <span class="small fw-bold text-muted text-uppercase">Thuế VAT (@Model.VATPercent%)</span><br/>
                            <strong class="fs-4 text-secondary">@Model.VATAmount.ToString("N0")</strong>
                        </div>
                        <div class="col-md-3 border-end py-4">
                            <span class="small fw-bold text-muted text-uppercase">Đã Thanh Toán</span><br/>
                            <strong class="fs-4 text-danger">@Model.DepositAmount.ToString("N0")</strong>
                        </div>
                        <div class="col-md-3 py-4 bg-success bg-opacity-10">
                            <span class="small fw-bold text-success text-uppercase">Còn Lại (Phải Trả)</span><br/>
                            <strong class="fs-3 text-success" id="valRemaining">@Model.RemainingAmount.ToString("N0")</strong> <span class="fs-6 text-success">₫</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-light border-bottom py-3">
                    <h6 class="fw-bold text-secondary mb-0 text-uppercase"><i class="fa-solid fa-list-check me-2"></i>TIẾN ĐỘ NHẬP KHO CHI TIẾT</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-center small text-muted text-uppercase">
                            <tr>
                                <th class="text-start ps-4">Sản phẩm / Vật tư</th>
                                <th>ĐVT</th>
                                <th class="text-primary">SL Đặt</th>
                                <th class="text-success">Đã Nhận (OK)</th>
                                <th class="text-danger">Lỗi (NG)</th>
                                <th class="text-warning">Còn Thiếu</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Details)
                            {
                                double remaining = item.QuantityOrdered - item.QuantityReceived - item.QuantityBad;
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.WarehouseItem.Name</div>
                                        <small class="text-muted">@item.WarehouseItem.Code</small>
                                    </td>
                                    <td class="text-center"><span class="badge bg-secondary bg-opacity-10 text-dark">@item.WarehouseItem.Unit</span></td>
                                    <td class="text-center fw-bold text-primary bg-primary bg-opacity-10">@item.QuantityOrdered</td>
                                    <td class="text-center text-success fw-bold">@item.QuantityReceived</td>
                                    <td class="text-center text-danger fw-bold">@item.QuantityBad</td>
                                    <td class="text-center fw-bold @(remaining > 0 ? "text-warning" : "text-muted")">
                                        @(remaining > 0 ? remaining.ToString() : "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsFinished) { <i class="fa-solid fa-check-circle text-success fs-5" title="Đã xong"></i> }
                                        else { <i class="fa-solid fa-hourglass-half text-warning fs-5" title="Đang chờ"></i> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card border-0 bg-light rounded-4 shadow-sm sticky-summary">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-uppercase text-secondary mb-3"><i class="fa-solid fa-bolt me-2"></i>Thao tác nhanh</h6>
                    <hr class="text-muted opacity-25" />

                    @if (Model.RemainingAmount > 0)
                    {
                        <button onclick="openPaymentModal()" class="btn btn-warning w-100 mb-3 fw-bold shadow-sm rounded-pill py-2 text-dark">
                            <i class="fa-solid fa-money-bill-transfer me-2"></i> THANH TOÁN NỢ
                        </button>
                    }

                    @if (Model.Status != POStatus.Completed && Model.Status != POStatus.Cancelled)
                    {
                        <a href="/Warehouse/ImportExport?type=Import&poId=@Model.Id" class="btn btn-primary w-100 mb-3 fw-bold shadow-sm rounded-pill py-2">
                            <i class="fa-solid fa-truck-ramp-box me-2"></i> NHẬP KHO
                        </a>
                        
                        <button onclick="forceFinish(@Model.Id)" class="btn btn-outline-danger w-100 fw-bold rounded-pill py-2 mb-3">
                            <i class="fa-solid fa-lock me-2"></i> CHỐT ĐƠN HÀNG
                        </button>
                    }

                    <a asp-action="Index" class="btn btn-outline-secondary w-100 fw-bold rounded-pill py-2">Quay lại danh sách</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // XỬ LÝ THANH TOÁN (SỔ QUỸ)
    function openPaymentModal() {
        let maxAmount = @Model.RemainingAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        
        Swal.fire({
            title: 'Thanh toán công nợ',
            html: `
                <div class="text-start mt-3">
                    <label class="fw-bold mb-1">Số tiền thanh toán (Tối đa: ${parseFloat(maxAmount).toLocaleString('vi-VN')} đ):</label>
                    <input type="number" id="payAmount" class="form-control mb-3 fw-bold text-success fs-5" value="${maxAmount}" max="${maxAmount}" min="1">
                    
                    <label class="fw-bold mb-1">Phương thức thanh toán:</label>
                    <select id="payMethod" class="form-select mb-3">
                        <option value="1">Tiền mặt</option>
                        <option value="2" selected>Chuyển khoản</option>
                    </select>

                    <label class="fw-bold mb-1">Ghi chú (Lưu vào sổ quỹ):</label>
                    <textarea id="payNote" class="form-control" rows="2" placeholder="Nội dung thanh toán..."></textarea>
                </div>
            `,
            showCancelButton: true,
            confirmButtonText: '<i class="fa-solid fa-check"></i> Lưu phiếu chi',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#198754',
            preConfirm: () => {
                let amount = document.getElementById('payAmount').value;
                let method = document.getElementById('payMethod').value;
                let note = document.getElementById('payNote').value;
                if (!amount || amount <= 0 || amount > maxAmount) {
                    Swal.showValidationMessage('Số tiền không hợp lệ!');
                    return false;
                }
                return { amount: amount, method: method, note: note };
            }
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({ title: 'Đang xử lý...', didOpen: () => Swal.showLoading() });
                
                let formData = new FormData();
                formData.append('id', @Model.Id);
                formData.append('amount', result.value.amount);
                formData.append('method', result.value.method);
                formData.append('note', result.value.note);

                fetch('/PurchaseOrder/PayRemaining', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        Swal.fire("Thành công!", res.message, "success").then(() => location.reload());
                    } else {
                        Swal.fire("Lỗi", res.message, "error");
                    }
                });
            }
        });
    }

    // CHỐT ĐƠN
    function forceFinish(id) {
        Swal.fire({
            title: 'Chốt đơn hàng này?',
            text: "Phần hàng còn thiếu sẽ được xem là kết thúc. Không thể nhập thêm hàng cho đơn này nữa!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fa-solid fa-lock"></i> Đồng ý chốt',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/PurchaseOrder/ForceClose/${id}`, { method: 'POST' })
                    .then(res => res.json())
                    .then(res => {
                        if (res.success) { Swal.fire("Đã chốt!", res.message, "success").then(() => location.reload()); } 
                        else { Swal.fire("Lỗi", res.message, "error"); }
                    });
            }
        });
    }
</script>