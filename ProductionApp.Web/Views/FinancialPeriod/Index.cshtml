@model IEnumerable<ProductionManager.Data.FinancialPeriod>
@{
    ViewData["Title"] = "Khóa Sổ Kế Toán";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body {
        background-color: #f4f6f8;
        font-family: 'Inter', sans-serif;
    }

    .erp-panel {
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .erp-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .erp-table th {
            background: #f9fafb;
            font-size: 13px;
            font-weight: 600;
            color: #374151;
            padding: 12px 16px;
            border-bottom: 1px solid #d1d5db;
            white-space: nowrap;
            text-transform: uppercase;
        }

        .erp-table td {
            padding: 10px 16px;
            vertical-align: middle;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            color: #111827;
        }

        .erp-table tr:hover td {
            background-color: #f3f4f6;
        }
</style>

<div class="container-fluid py-3 px-2 px-lg-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h5 class="fw-bold mb-0 text-dark fs-5"><i class="fa-solid fa-lock text-danger me-2"></i> Quản lý Khóa Sổ Kế Toán</h5>
            <p class="text-muted small mb-0 mt-1">Đóng/Mở kỳ kế toán để chốt dữ liệu tài chính hàng tháng</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-4 border-success" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> <strong>@TempData["Success"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="erp-panel shadow-sm">
        <div class="table-responsive">
            <table class="erp-table">
                <thead>
                    <tr>
                        <th width="15%" class="text-center">Kỳ Kế Toán</th>
                        <th width="20%" class="text-center">Trạng Thái</th>
                        <th width="25%" class="text-center">Thời Gian Chốt</th>
                        <th width="20%">Người Thực Hiện</th>
                        <th width="20%" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary fs-6">Tháng @item.Month / @item.Year</td>
                                <td class="text-center">
                                    @if (item.IsClosed)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill"><i class="fa-solid fa-lock me-1"></i> Đã khóa sổ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill"><i class="fa-solid fa-lock-open me-1"></i> Đang mở</span>
                                    }
                                </td>
                                <td class="text-muted fw-500 text-center font-monospace">
                                    @(item.ClosedAt.HasValue ? item.ClosedAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "--")
                                </td>
                                <td class="fw-bold text-secondary">
                                    @(string.IsNullOrEmpty(item.ClosedBy) ? "--" : item.ClosedBy)
                                </td>
                                <td class="text-center">
                                    <form asp-action="ToggleLock" method="post" asp-route-id="@item.Id" class="m-0">
                                        @if (item.IsClosed)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning fw-bold rounded-2 px-3" onclick="return confirm('Mở khóa sẽ cho phép thay đổi dữ liệu của tháng này. Bạn chắc chắn?');">
                                                <i class="fa-solid fa-unlock me-1"></i> Mở Khóa
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-danger fw-bold rounded-2 px-3 shadow-sm" onclick="return confirm('Sau khi khóa sổ, mọi giao dịch trong tháng này sẽ KHÔNG THỂ chỉnh sửa. Tiến hành khóa?');">
                                                <i class="fa-solid fa-lock me-1"></i> Khóa Sổ
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>