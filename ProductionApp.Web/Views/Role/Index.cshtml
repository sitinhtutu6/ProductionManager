@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

@{
    ViewData["Title"] = "Quản lý Vai trò";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0 text-primary">
                <i class="fa-solid fa-shield-halved me-2"></i>Quản lý Nhóm Quyền
            </h4>
            <span class="text-muted small">Cấu hình vai trò người dùng trong hệ thống</span>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#createRoleModal">
            <i class="fa-solid fa-plus me-2"></i>Tạo Role Mới
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase small fw-bold">Tên Vai trò</th>
                        <th class="py-3 text-secondary text-uppercase small fw-bold">Loại</th>
                        <th class="text-end pe-4 py-3 text-secondary text-uppercase small fw-bold" width="300">Công cụ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        bool isAdmin = role.Name == "Admin";
                        <tr class="@(isAdmin ? "bg-light-warning" : "")">
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 @(isAdmin ? "bg-warning text-white" : "bg-light text-primary")"
                                         style="width: 40px; height: 40px;">
                                        <i class="fa-solid @(isAdmin ? "fa-crown" : "fa-user-group")"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@role.Name</div>
                                        <div class="small text-muted">ID: @role.Id.Substring(0, 8)...</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-warning text-dark border border-warning"><i class="fa-solid fa-star me-1"></i>Hệ thống</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border">Tùy chỉnh</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Permission" asp-route-roleId="@role.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-2 fw-bold">
                                    <i class="fa-solid fa-sliders me-1"></i> Phân quyền
                                </a>
                                @if (!isAdmin)
                                {
                                    <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-outline-danger btn-sm rounded-circle"
                                       onclick="return confirm('Bạn có chắc muốn xóa nhóm @role.Name? Hành động này không thể hoàn tác!')" title="Xóa role">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-layer-group me-2"></i>Thêm Nhóm Quyền</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4 bg-light">
                    <label class="form-label fw-bold text-dark">Tên nhóm quyền (Role Name)</label>
                    <input name="roleName" class="form-control form-control-lg border-0 shadow-sm" placeholder="VD: Kế toán, Thủ kho, Sale..." required autocomplete="off" />
                    <div class="form-text mt-2"><i class="fa-solid fa-circle-info me-1"></i>Tên nên viết liền không dấu hoặc tiếng Anh (VD: Accountant).</div>
                </div>
                <div class="modal-footer border-0 bg-white rounded-bottom-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Tạo ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>