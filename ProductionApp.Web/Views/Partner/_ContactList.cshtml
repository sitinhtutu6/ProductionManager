@model IEnumerable<ProductionApp.Web.Models.ViewModels.PartnerGroupVM>
@using ProductionManager.Data

@foreach (var group in Model)
{
    <div class="card shadow-sm border-0 mb-4 rounded-3 overflow-hidden">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-building me-2"></i>@group.CompanyName</h5>
            <span class="badge bg-primary rounded-pill px-3">@group.ActiveCount Đang hợp tác</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th width="15%">Bộ phận</th>
                        <th width="15%">Người liên hệ</th>
                        <th width="20%">Kênh liên lạc</th>
                        <th width="25%">Phụ trách / Công việc</th>
                        <th width="15%">Thời gian làm việc</th>
                        <th width="10%" class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in group.Contacts)
                    {
                        var rowClass = c.Status == PartnerStatus.Ended ? "bg-light text-muted" : "";
                        var opacity = c.Status == PartnerStatus.Ended ? "opacity: 0.6;" : "";

                        <tr class="@rowClass" style="@opacity">
                            <td class="fw-bold text-secondary">@c.Department</td>
                            <td>
                                <div class="fw-bold text-dark">@c.ContactName</div>
                                @if (!string.IsNullOrEmpty(c.Notes)) { <small class="text-muted fst-italic" title="@c.Notes"><i class="fa-solid fa-circle-info me-1"></i>Có ghi chú</small> }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.Phone)) { <div><i class="fa-solid fa-phone text-success me-2" style="width: 15px"></i>@c.Phone</div> }
                                @if (!string.IsNullOrEmpty(c.Email)) { <div><i class="fa-solid fa-envelope text-danger me-2" style="width: 15px"></i>@c.Email</div> }
                                @if (!string.IsNullOrEmpty(c.Zalo)) { <div><span class="fw-bold text-primary me-2" style="width: 15px">Z</span>@c.Zalo</div> }
                                @if (!string.IsNullOrEmpty(c.Telegram)) { <div><i class="fa-brands fa-telegram text-info me-2" style="width: 15px"></i>@c.Telegram</div> }
                            </td>
                            <td><div class="text-wrap" style="max-width: 300px;">@c.JobDescription</div></td>
                            <td>
                                <div class="small"><i class="fa-regular fa-calendar-check text-success me-1"></i> BĐ: @c.StartDate.ToString("dd/MM/yyyy")</div>
                                @if (c.EndDate.HasValue) { <div class="small text-danger"><i class="fa-regular fa-calendar-xmark me-1"></i> KT: @c.EndDate.Value.ToString("dd/MM/yyyy")</div> }
                            </td>
                            <td class="text-center">
                                @if (c.Status == PartnerStatus.Active) { <span class="badge bg-success">Đang làm</span> }
                                else if (c.Status == PartnerStatus.Paused) { <span class="badge bg-warning text-dark">Tạm dừng</span> }
                                else { <span class="badge bg-secondary">Kết thúc</span> }
                                
                                <div class="mt-2 d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary py-0 px-2"><i class="fa-solid fa-pen-to-square"></i></a>
                                    @if(c.Status != PartnerStatus.Ended)
                                    {
                                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Ngừng hợp tác?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"><i class="fa-solid fa-power-off"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <h5 class="text-muted">Không tìm thấy dữ liệu đối tác nào phù hợp.</h5>
    </div>
}