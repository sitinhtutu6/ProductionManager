@model IEnumerable<ProductionManager.Data.Order>
@{ Layout = null; }

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Báo cáo tổng hợp</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <style>
        body { font-family: 'Times New Roman', serif; font-size: 13px; }
        @@media print {
            .no-print { display: none; }
            table { width: 100%; border-collapse: collapse; }
            th, td { border: 1px solid #000; padding: 5px; }
        }
    </style>
</head>
<body class="p-4">
    
    <div class="no-print mb-3 text-end">
        <button onclick="window.print()" class="btn btn-primary fw-bold">🖨️ Lưu thành PDF / In</button>
    </div>

    <div class="text-center mb-4">
        <h3 class="fw-bold text-uppercase">Báo cáo tình hình đơn hàng</h3>
        <p>Ngày lập báo cáo: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <table class="table table-bordered border-dark">
        <thead class="table-light">
            <tr>
                <th>STT</th>
                <th>Mã Đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; decimal total = 0; }
            @foreach (var item in Model)
            {
                total += item.TotalAmount;
                <tr>
                    <td class="text-center">@i</td>
                    <td class="fw-bold">@item.OrderCode</td>
                    <td>@item.Customer?.CompanyName</td>
                    <td class="text-center">@item.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@item.TotalAmount.ToString("N0")</td>
                    <td class="text-center">@item.Status</td>
                </tr>
                i++;
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="4" class="text-end">TỔNG CỘNG:</td>
                <td class="text-end">@total.ToString("N0")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="row mt-5 text-center">
        <div class="col-6">
            <strong>Người lập biểu</strong><br/>(Ký tên)
        </div>
        <div class="col-6">
            <strong>Giám đốc</strong><br/>(Ký tên)
        </div>
    </div>
</body>
</html>