@model ProductionApp.Web.Models.ViewModels.BusinessDashboardVM
@{
    ViewData["Title"] = "Báo cáo Hiệu quả Kinh doanh";
    System.Globalization.CultureInfo viVN = new System.Globalization.CultureInfo("vi-VN");
}

<style>
    .report-bg { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); min-height: 100vh; padding-bottom: 50px; font-family: 'Segoe UI', sans-serif; }
    .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); height: 100%; }
    
    /* CSS THANH SWITCH 3 NÚT */
    .nav-pill-switch {
        background: #fff;
        border-radius: 50px;
        padding: 4px;
        display: inline-flex;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        border: 1px solid #e9ecef;
    }
    .nav-pill-switch .btn {
        border-radius: 50px;
        padding: 6px 20px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
        border: none;
        color: #6c757d;
        min-width: 160px;
    }
    .nav-pill-switch .btn:hover { background: #f8f9fa; color: #000; }
    
    /* Trạng thái Active cho nút Hiệu quả SXKD (Màu Xanh Dương) */
    .nav-pill-switch .btn.active {
        background-color: #0d6efd;
        color: white;
        box-shadow: 0 2px 4px rgba(13, 110, 253, 0.3);
    }
    
    /* Metric Box Styles */
    .metric-box { padding: 20px; border-radius: 12px; color: white; position: relative; overflow: hidden; height: 100%; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .metric-box h6 { font-weight: 600; opacity: 0.9; text-transform: uppercase; font-size: 0.85rem; margin-bottom: 5px; }
    .metric-box h3 { font-weight: 800; font-size: 1.8rem; margin: 0; }
    .metric-icon { position: absolute; right: 15px; bottom: 15px; font-size: 3rem; opacity: 0.2; }

    @@media print { .no-print { display: none !important; } .report-bg { background: white; } }

    /* --- CSS MỚI: FORMAT DATE INPUT (dd/MM/yyyy) --- */
    input[type="date"] {
        position: relative;
        color: transparent !important; /* Ẩn text mặc định yyyy-mm-dd */
    }

    input[type="date"]::before {
        position: absolute;
        top: 50%;
        left: 0.5rem; /* Căn lề trái */
        transform: translateY(-50%);
        content: attr(data-date); /* Hiển thị nội dung từ attribute data-date */
        color: #333; /* Màu chữ */
        pointer-events: none; /* Để click vào chữ vẫn mở lịch */
        display: inline-block;
        font-family: inherit;
        font-size: inherit;
    }

    /* Đảm bảo icon lịch vẫn hiện và click được */
    input[type="date"]::-webkit-calendar-picker-indicator {
        position: absolute;
        top: 50%;
        right: 0.5rem;
        transform: translateY(-50%);
        color: #333;
        opacity: 1;
        cursor: pointer;
        z-index: 10;
    }
    /* ------------------------------------------------ */
</style>

<div class="report-bg">
    <div class="container-fluid px-4 pt-4">
        
        <div class="d-flex justify-content-center mb-4 no-print">
            <div class="nav-pill-switch">
                <a href="javascript:void(0)" class="btn active">
                    <i class="fa-solid fa-chart-pie me-2"></i>Hiệu quả SXKD
                </a>
                <a href="@Url.Action("CashFlow", "Report")" class="btn">
                    <i class="fa-solid fa-money-bill-trend-up me-2"></i>Dòng tiền Thực tế
                </a>
                <a href="@Url.Action("AllocatedAnalysis", "Report")" class="btn">
                    <i class="fa-solid fa-scale-balanced me-2"></i>Phân bổ Lợi nhuận
                </a>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-0">BÁO CÁO HIỆU QUẢ KINH DOANH</h4>
                <small class="text-muted">Kỳ: @Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")</small>
            </div>
            
            <form asp-action="Index" method="get" class="d-flex gap-2 bg-white p-2 rounded shadow-sm no-print">
                <input type="date" name="fromDate" class="form-control form-control-sm fw-bold border-0" value="@Model.FromDate.ToString("yyyy-MM-dd")">
                <span class="align-self-center"><i class="fa-solid fa-arrow-right text-muted"></i></span>
                <input type="date" name="toDate" class="form-control form-control-sm fw-bold border-0" value="@Model.ToDate.ToString("yyyy-MM-dd")">
                <button type="submit" class="btn btn-primary btn-sm fw-bold px-3 rounded-pill">Xem</button>
            </form>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="metric-box" style="background: linear-gradient(45deg, #4e54c8, #8f94fb);">
                    <h6>Doanh Thu (Thực tế)</h6>
                    <h3>@Model.Production.Revenue.ToString("N0")</h3>
                    <div class="small mt-1 opacity-75">@Model.Production.TotalOrdersCompleted đơn hoàn thành</div>
                    <i class="fa-solid fa-sack-dollar metric-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-box" style="background: linear-gradient(45deg, #ff9966, #ff5e62);">
                    <h6>Giá Vốn Hàng Bán</h6>
                    <h3>@Model.Production.TotalMaterialCost.ToString("N0")</h3>
                    <div class="small mt-1 opacity-75">Chi phí vật tư xuất kho</div>
                    <i class="fa-solid fa-boxes-packing metric-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-box" style="background: linear-gradient(45deg, #11998e, #38ef7d);">
                    <h6>Lợi Nhuận Gộp</h6>
                    <h3>@Model.Production.GrossProfit.ToString("N0")</h3>
                    <div class="small mt-1 opacity-75">Biên LN: @Model.Production.ProfitMargin.ToString("0.0")%</div>
                    <i class="fa-solid fa-chart-line metric-icon"></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-box" style="background: linear-gradient(45deg, #00b4db, #0083b0);">
                    <h6>Dòng Tiền (Sổ Quỹ)</h6>
                    <h3>@Model.CashFlow.NetCashFlow.ToString("N0")</h3>
                    <div class="small mt-1 opacity-75">Thực thu - Thực chi (Theo ReportDate)</div>
                    <i class="fa-solid fa-wallet metric-icon"></i>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="glass-card p-4">
                    <h6 class="fw-bold mb-3 border-bottom pb-2">BIỂU ĐỒ HIỆU QUẢ</h6>
                    <div style="height: 250px;">
                        <canvas id="profitChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="glass-card p-4">
                    <h6 class="fw-bold mb-3 border-bottom pb-2">CHI TIẾT VẬT TƯ & GIÁ VỐN</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên vật tư</th>
                                    <th class="text-center">ĐVT</th>
                                    <th class="text-end">Đã dùng</th>
                                    <th class="text-end">Giá TB</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Production.MaterialStats.Any())
                                {
                                    foreach (var item in Model.Production.MaterialStats)
                                    {
                                        <tr>
                                            <td class="fw-bold text-secondary">@item.MaterialName</td>
                                            <td class="text-center small">@item.Unit</td>
                                            <td class="text-end">@item.ExportQty.ToString("N0")</td>
                                            <td class="text-end text-muted small">@item.AvgImportPrice.ToString("N0")</td>
                                            <td class="text-end fw-bold text-danger">@item.TotalCost.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">Không có xuất kho trong kỳ.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // --- JAVASCRIPT XỬ LÝ FORMAT DATE INPUT ---
    document.addEventListener("DOMContentLoaded", function () {
        // Hàm chuyển đổi và hiển thị
        function formatInputDate(input) {
            var val = input.value; // Giá trị gốc là yyyy-mm-dd
            if (val) {
                var formattedDate = val.split('-').reverse().join('/');
                input.setAttribute("data-date", formattedDate);
            } else {
                input.setAttribute("data-date", "dd/mm/yyyy"); // Placeholder
            }
        }

        // Áp dụng cho các ô input date
        var dateInputs = document.querySelectorAll("input[type='date']");
        dateInputs.forEach(function(input) {
            formatInputDate(input); // Chạy lần đầu khi load

            // Cập nhật khi người dùng thay đổi
            input.addEventListener("change", function() {
                formatInputDate(this);
            });
        });
    });

    // --- CHART JS ---
    const ctx = document.getElementById('profitChart');
    if (ctx) {
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Hiệu quả Kinh doanh'],
                datasets: [
                    { label: 'Doanh thu', data: @Html.Raw(Model.ChartRevenueData), backgroundColor: '#4e54c8' },
                    { label: 'Giá vốn', data: @Html.Raw(Model.ChartCostData), backgroundColor: '#ff5e62' },
                    { label: 'Lợi nhuận', data: @Html.Raw(Model.ChartProfitData), backgroundColor: '#11998e' }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
    }
</script>