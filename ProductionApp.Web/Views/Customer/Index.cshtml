@model IEnumerable<ProductionManager.Data.Customer>
@using ProductionManager.Data
@{
    ViewData["Title"] = "Quản lý Đối tác";
    PartnerType? currentType = ViewBag.CurrentType as PartnerType?;
    string keyword = ViewBag.Keyword;
}

<div class="card shadow border-0">
    <div class="card-header bg-white pt-3 pb-0 border-0">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold text-primary mb-0"><i class="fa-solid fa-users-rectangle"></i> DANH BẠ ĐỐI TÁC</h4>
            <a asp-action="Create" asp-route-type="@(currentType ?? PartnerType.Customer)" class="btn btn-primary fw-bold">
                <i class="fa-solid fa-plus"></i> Thêm mới
            </a>
        </div>

        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link fw-bold @(currentType == null ? "active text-primary" : "text-muted")"
                   href="/Customer/Index">
                    <i class="fa-solid fa-layer-group"></i> Tất cả
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold @(currentType == PartnerType.Customer ? "active text-success" : "text-muted")"
                   href="/Customer/Index?type=1">
                    <i class="fa-solid fa-user-tie"></i> Khách hàng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link fw-bold @(currentType == PartnerType.Supplier ? "active text-warning" : "text-muted")"
                   href="/Customer/Index?type=2">
                    <i class="fa-solid fa-truck-field"></i> Nhà cung cấp
                </a>
            </li>
        </ul>
    </div>

    <div class="card-body bg-light">
        <form method="get" class="row g-2 mb-3">
            <input type="hidden" name="type" value="@currentType" />
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="keyword" class="form-control" placeholder="Tìm tên, mã, sđt..." value="@keyword">
                    <button class="btn btn-secondary">Tìm</button>
                </div>
            </div>
        </form>

        <div class="table-responsive bg-white rounded border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th class="ps-3">Mã Đối tác</th>
                        <th>Loại</th>
                        <th>Tên Công Ty / Đơn vị</th>
                        <th>Liên hệ</th>
                        <th>Thông tin tài chính</th>
                        <th class="text-center" width="120">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có dữ liệu.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">@item.CustomerCode</td>
                                <td>
                                    @if (item.Type == PartnerType.Customer)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Khách hàng</span>
                                    }
                                    else if (item.Type == PartnerType.Supplier)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">Nhà cung cấp</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info">Đối tác 2 chiều</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.CompanyName</div>
                                    @if (!string.IsNullOrEmpty(item.Address))
                                    {
                                        <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i>@item.Address</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ContactPerson))
                                    {
                                        <div class="small"><i class="fa-solid fa-user me-1"></i> @item.ContactPerson</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                    {
                                        <div class="small fw-bold text-dark"><i class="fa-solid fa-phone me-1"></i> @item.PhoneNumber</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.TaxCode))
                                    {
                                        <div class="small text-muted" title="Mã số thuế">MST: @item.TaxCode</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.BankAccount))
                                    {
                                        <div class="small text-primary fw-bold" title="Ngân hàng">
                                            <i class="fa-solid fa-credit-card me-1"></i> @item.BankAccount
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary border-0" title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0"
                                       onclick="return confirm('Xóa đối tác [@item.CustomerCode]?');" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>