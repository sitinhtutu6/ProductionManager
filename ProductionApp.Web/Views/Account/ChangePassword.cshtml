@model ProductionApp.Web.Models.ViewModels.ChangePasswordVM
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-key me-2"></i> ĐỔI MẬT KHẨU</h5>
                </div>
                <div class="card-body p-4">
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <form asp-action="ChangePassword" method="post">
                        
                        <div class="mb-3">
                            <label class="small text-muted fw-bold">Mật khẩu hiện tại</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-lock text-muted"></i></span>
                                <input asp-for="CurrentPassword" class="form-control" placeholder="••••••" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="small text-muted fw-bold">Mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-key text-primary"></i></span>
                                <input asp-for="NewPassword" class="form-control" placeholder="••••••" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="small text-muted fw-bold">Xác nhận mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-check-double text-success"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning fw-bold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> CẬP NHẬT MẬT KHẨU
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light border fw-bold text-secondary">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>