@model List<ProductionManager.Data.Order>
@{ Layout = null; }

<!DOCTYPE html>
<html>
<head>
    <title>Kế Hoạch Sản Xuất</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @("@media print { .no-print { display: none; } }")
        body { font-family: 'Times New Roman', serif; padding: 20px; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid black; padding-bottom: 10px; }
        th { background-color: #f0f0f0 !important; text-align: center; }
    </style>
</head>
<body>
    <div class="no-print mb-3">
        <button onclick="window.print()" class="btn btn-primary">🖨️ IN NGAY</button>
    </div>

    <div class="header">
        <h2>KẾ HOẠCH SẢN XUẤT TUẦN</h2>
        <p>Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th style="width: 50px;">TT</th> <th>Mã Đơn</th>
                <th>Khách Hàng</th>
                <th>Sản Phẩm Chính</th>
                <th>Tổng SL</th>
                <th>Hạn Giao</th>
                <th>Ghi Chú</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center fw-bold">@i</td>
                    <td class="fw-bold">@item.OrderCode</td>
                    <td>@item.Customer?.CompanyName</td>
                    <td>
                        @if(item.OrderDetails != null)
                        {
                            foreach(var d in item.OrderDetails.Take(2))
                            {
                                <div>- @d.ProductName (@d.Quantity)</div>
                            }
                            if(item.OrderDetails.Count > 2) { <small class="text-muted">...và @(item.OrderDetails.Count - 2) loại khác</small> }
                        }
                    </td>
                    <td class="text-center fw-bold">@item.OrderDetails?.Sum(x=>x.Quantity).ToString("N0")</td>
                    <td class="text-center">@item.DeliveryDeadline?.ToString("dd/MM")</td>
                    <td></td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</body>
</html>